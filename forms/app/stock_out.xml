            <value>-</value>
          </text>
          <text id="/data/inputs/contact/name:label">
            <value>-</value>
          </text>
          <text id="/data/inputs/contact/parent:label">
            <value>-</value>
          </text>
          <text id="/data/inputs/contact/parent/_id:label">
            <value>-</value>
          </text>
          <text id="/data/summary:label">
            <value>-</value>
          </text>
          <text id="/data/out:label">
            <value>-</value>
          </text>
        </translation>
      </itext>
      <instance>
        <data id="stock_out" version="now()" prefix="J1!stock_out!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <test_drug_required/>
            <test_drug_at_hand/>
            <second_test_drug_required/>
            <second_test_drug_at_hand/>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
            </user>
            <contact>
              <_id/>
              <name/>
              <parent>
                <_id/>
              </parent>
            </contact>
          </inputs>
          <place_id/>
          <contact_name/>
          <summary>
            <s_submit/>
            <r_summary/>
            <Medicine/>
            <test_drug_name/>
            <test_drug_note_at_hand/>
            <test_drug_note_required/>
            <second_test_drug_name/>
            <second_test_drug_note_at_hand/>
            <second_test_drug_note_required/>
            <second_test_drug_at_hand___set/>
            <second_test_drug_at_hand___unit/>
            <second_test_drug_required___set/>
            <second_test_drug_required___unit/>
          </summary>
          <out>
            <end_group_note/>
          </out>
          <needs_signoff/>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/test_drug_required" type="string"/>
      <bind nodeset="/data/inputs/test_drug_at_hand" type="string"/>
      <bind nodeset="/data/inputs/second_test_drug_required" type="string"/>
      <bind nodeset="/data/inputs/second_test_drug_at_hand" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/parent/_id"/>
      <bind nodeset="/data/contact_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine" readonly="true()" type="string" relevant=" /data/inputs/test_drug_at_hand  &lt; /data/inputs/test_drug_required  or  /data/inputs/second_test_drug_at_hand  &lt; /data/inputs/second_test_drug_required "/>
      <bind nodeset="/data/summary/test_drug_name" readonly="true()" type="string" relevant=" /data/inputs/test_drug_at_hand  &lt;= /data/inputs/test_drug_required "/>
      <bind nodeset="/data/summary/test_drug_note_at_hand" readonly="true()" type="string" relevant=" /data/inputs/test_drug_at_hand  &lt;= /data/inputs/test_drug_required "/>
      <bind nodeset="/data/summary/test_drug_note_required" readonly="true()" type="string" relevant=" /data/inputs/test_drug_at_hand  &lt;= /data/inputs/test_drug_required "/>
      <bind nodeset="/data/summary/second_test_drug_name" readonly="true()" type="string" relevant=" /data/inputs/second_test_drug_at_hand  &lt;= /data/inputs/second_test_drug_required "/>
      <bind nodeset="/data/summary/second_test_drug_note_at_hand" readonly="true()" type="string" relevant=" /data/inputs/second_test_drug_at_hand  &lt;= /data/inputs/second_test_drug_required "/>
      <bind nodeset="/data/summary/second_test_drug_note_required" readonly="true()" type="string" relevant=" /data/inputs/second_test_drug_at_hand  &lt;= /data/inputs/second_test_drug_required "/>
      <bind nodeset="/data/summary/second_test_drug_at_hand___set" type="string" calculate="int( /data/inputs/second_test_drug_at_hand  div 12)"/>
      <bind nodeset="/data/summary/second_test_drug_at_hand___unit" type="string" calculate=" /data/inputs/second_test_drug_at_hand  mod 12"/>
      <bind nodeset="/data/summary/second_test_drug_required___set" type="string" calculate="int( /data/inputs/second_test_drug_required  div 12)"/>
      <bind nodeset="/data/summary/second_test_drug_required___unit" type="string" calculate=" /data/inputs/second_test_drug_required  mod 12"/>
      <bind nodeset="/data/out/end_group_note" readonly="true()" type="string"/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
        <group appearance="hidden" ref="/data/inputs/contact/parent">
          <input ref="/data/inputs/contact/parent/_id"/>
        </group>
      </group>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/Medicine" appearance="h1 green">
        <label ref="jr:itext('/data/summary/Medicine:label')"/>
      </input>
      <input ref="/data/summary/test_drug_name" appearance="h2 lime">
        <label ref="jr:itext('/data/summary/test_drug_name:label')"/>
      </input>
      <input ref="/data/summary/test_drug_note_at_hand" appearance="li">
        <label ref="jr:itext('/data/summary/test_drug_note_at_hand:label')"/>
      </input>
      <input ref="/data/summary/test_drug_note_required" appearance="li">
        <label ref="jr:itext('/data/summary/test_drug_note_required:label')"/>
      </input>
      <input ref="/data/summary/second_test_drug_name" appearance="h2 lime">
        <label ref="jr:itext('/data/summary/second_test_drug_name:label')"/>
      </input>
      <input ref="/data/summary/second_test_drug_note_at_hand" appearance="li">
        <label ref="jr:itext('/data/summary/second_test_drug_note_at_hand:label')"/>
      </input>
      <input ref="/data/summary/second_test_drug_note_required" appearance="li">
        <label ref="jr:itext('/data/summary/second_test_drug_note_required:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out">
      <input ref="/data/out/end_group_note">
        <label>&lt;NOTE&gt;</label>
      </input>
    </group>
  </h:body>
</h:html>