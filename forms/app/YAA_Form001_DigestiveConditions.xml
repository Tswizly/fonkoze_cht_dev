            <itextId>skin_pinch-2</itextId>
            <name>regular</name>
          </item>
        </root>
      </instance>
      <instance id="followed_up_conditions">
        <root>
          <item>
            <itextId>followed_up_conditions-0</itextId>
            <name>gastritis</name>
          </item>
          <item>
            <itextId>followed_up_conditions-1</itextId>
            <name>dehydration</name>
          </item>
          <item>
            <itextId>followed_up_conditions-2</itextId>
            <name>dysentery</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/digestive_assessment_group/diarrhea" type="string" required="true()"/>
      <bind nodeset="/data/digestive_assessment_group/diarrhea_duration" type="int" relevant=" /data/digestive_assessment_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_assessment_group/diarrhea_frequency" type="int" relevant=" /data/digestive_assessment_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_assessment_group/diarrhea_color" type="string" relevant=" /data/digestive_assessment_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_assessment_group/diarrhea_blood" type="string" relevant=" /data/digestive_assessment_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_assessment_group/vomiting_repeatedly" type="string" required="true()"/>
      <bind nodeset="/data/digestive_assessment_group/physical_demeanor" type="string"/>
      <bind nodeset="/data/digestive_assessment_group/skin_pinch" type="string" required="true()"/>
      <bind nodeset="/data/digestive_assessment_group/sunken_eyes" type="string" required="true()"/>
      <bind nodeset="/data/calc_gastritis" type="string" calculate="if( /data/digestive_assessment_group/vomiting_repeatedly  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_dehydration" type="string" calculate="if( /data/digestive_assessment_group/diarrhea  = 'yes' and  /data/digestive_assessment_group/diarrhea_blood  = 'no' and (selected( /data/digestive_assessment_group/physical_demeanor , 'lethargic_or_unconscious') or selected( /data/digestive_assessment_group/physical_demeanor , 'restless_or_irritable') or selected( /data/digestive_assessment_group/physical_demeanor , 'drinking_difficulty') or selected( /data/digestive_assessment_group/physical_demeanor , 'drinking_eagerly') or  /data/digestive_assessment_group/sunken_eyes  = 'yes' or  /data/digestive_assessment_group/skin_pinch  = 'very_slowly' or  /data/digestive_assessment_group/skin_pinch  = 'slowly'), 'true', 'false')"/>
      <bind nodeset="/data/calc_dysentery" type="string" calculate="if( /data/digestive_assessment_group/diarrhea  = 'yes' and  /data/digestive_assessment_group/diarrhea_blood  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_gastritis  = 'true' or  /data/calc_dehydration  = 'true' or  /data/calc_dysentery  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis" readonly="true()" type="string" relevant=" /data/calc_gastritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis_action" readonly="true()" type="string" relevant=" /data/calc_gastritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_dehydration" readonly="true()" type="string" relevant=" /data/calc_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_dehydration_action" readonly="true()" type="string" relevant=" /data/calc_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_dysentery" readonly="true()" type="string" relevant=" /data/calc_dysentery  = 'true'"/>
      <bind nodeset="/data/results_group/res_dysentery_action" readonly="true()" type="string" relevant=" /data/calc_dysentery  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_gastritis  = 'false' and  /data/calc_dehydration  = 'false' and  /data/calc_dysentery  = 'false'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_diarrhea" type="string" calculate="if( /data/digestive_assessment_group/diarrhea  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_diarrhea_duration" type="string" calculate="if( /data/digestive_assessment_group/diarrhea_duration  != '',  /data/digestive_assessment_group/diarrhea_duration , -1)"/>
      <bind nodeset="/data/data/_diarrhea_frequency" type="string" calculate="if( /data/digestive_assessment_group/diarrhea_frequency  != '',  /data/digestive_assessment_group/diarrhea_frequency , -1)"/>
      <bind nodeset="/data/data/_diarrhea_color" type="string" calculate="if( /data/digestive_assessment_group/diarrhea_color  != '',  /data/digestive_assessment_group/diarrhea_color , 'false')"/>
      <bind nodeset="/data/data/_diarrhea_blood" type="string" calculate="if( /data/digestive_assessment_group/diarrhea_blood  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_vomiting_repeatedly" type="string" calculate="if( /data/digestive_assessment_group/vomiting_repeatedly  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_physical_demeanor" type="string" calculate="if( /data/digestive_assessment_group/physical_demeanor  != '',  /data/digestive_assessment_group/physical_demeanor , 'false')"/>
      <bind nodeset="/data/data/_skin_pinch" type="string" calculate="if( /data/digestive_assessment_group/skin_pinch  != '',  /data/digestive_assessment_group/skin_pinch , 'false')"/>
      <bind nodeset="/data/data/_sunken_eyes" type="string" calculate="if( /data/digestive_assessment_group/sunken_eyes  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_gastritis" type="string" calculate="if( /data/calc_gastritis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_dehydration" type="string" calculate="if( /data/calc_dehydration ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_dysentery" type="string" calculate="if( /data/calc_dysentery ='true', 'true', 'false')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/digestive_assessment_group">
      <label ref="jr:itext('/data/digestive_assessment_group:label')"/>
      <select1 ref="/data/digestive_assessment_group/diarrhea">
        <label ref="jr:itext('/data/digestive_assessment_group/diarrhea:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/digestive_assessment_group/diarrhea_duration">
        <label ref="jr:itext('/data/digestive_assessment_group/diarrhea_duration:label')"/>
      </input>
      <input ref="/data/digestive_assessment_group/diarrhea_frequency">
        <label ref="jr:itext('/data/digestive_assessment_group/diarrhea_frequency:label')"/>
      </input>
      <select1 ref="/data/digestive_assessment_group/diarrhea_color">
        <label ref="jr:itext('/data/digestive_assessment_group/diarrhea_color:label')"/>
        <itemset nodeset="instance('stool_color')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_assessment_group/diarrhea_blood">
        <label ref="jr:itext('/data/digestive_assessment_group/diarrhea_blood:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_assessment_group/vomiting_repeatedly">
        <label ref="jr:itext('/data/digestive_assessment_group/vomiting_repeatedly:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/digestive_assessment_group/physical_demeanor">
        <label ref="jr:itext('/data/digestive_assessment_group/physical_demeanor:label')"/>
        <itemset nodeset="instance('physical_demeanor')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/digestive_assessment_group/skin_pinch">
        <label ref="jr:itext('/data/digestive_assessment_group/skin_pinch:label')"/>
        <itemset nodeset="instance('skin_pinch')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_assessment_group/sunken_eyes">
        <label ref="jr:itext('/data/digestive_assessment_group/sunken_eyes:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_gastritis" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_gastritis:label')"/>
      </input>
      <input ref="/data/results_group/res_gastritis_action">
        <label ref="jr:itext('/data/results_group/res_gastritis_action:label')"/>
      </input>
      <input ref="/data/results_group/res_dehydration" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_dehydration:label')"/>
      </input>
      <input ref="/data/results_group/res_dehydration_action">
        <label ref="jr:itext('/data/results_group/res_dehydration_action:label')"/>
      </input>
      <input ref="/data/results_group/res_dysentery" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_dysentery:label')"/>
      </input>
      <input ref="/data/results_group/res_dysentery_action">
        <label ref="jr:itext('/data/results_group/res_dysentery_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
  </h:body>
</h:html>