            <itextId>urine_strip_yes_no-0</itextId>
            <name>yes</name>
          </item>
          <item>
            <itextId>urine_strip_yes_no-1</itextId>
            <name>no</name>
          </item>
          <item>
            <itextId>urine_strip_yes_no-2</itextId>
            <name>did_not_run</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/perform_followup_group/uti_std_symptoms" type="string" required="true()"/>
      <bind nodeset="/data/perform_followup_group/temperature" type="decimal" required="true()" relevant="selected( /data/perform_followup_group/uti_std_symptoms , 'fever_above_38')"/>
      <bind nodeset="/data/perform_followup_group/urinary_strip_feasibility" type="string" required="true()"/>
      <bind nodeset="/data/perform_followup_group/urinary_strip_result" type="string" required="true()" relevant=" /data/perform_followup_group/urinary_strip_feasibility  = 'yes'"/>
      <bind nodeset="/data/calc_uti" type="string" calculate="if((selected( /data/perform_followup_group/uti_std_symptoms , 'fever_above_38') or selected( /data/perform_followup_group/uti_std_symptoms , 'nausea') or selected( /data/perform_followup_group/uti_std_symptoms , 'diarrhea') or selected( /data/perform_followup_group/uti_std_symptoms , 'abdominal_pain') or selected( /data/perform_followup_group/uti_std_symptoms , 'yellow_urine') or  /data/perform_followup_group/urinary_strip_result  = 'yes') and not(selected( /data/perform_followup_group/uti_std_symptoms , 'vaginal_or_urethral_discharge')) and not(selected( /data/perform_followup_group/uti_std_symptoms , 'ulcer_of_genital_parts')) and not(selected( /data/perform_followup_group/uti_std_symptoms , 'oedema')) and not(selected( /data/perform_followup_group/uti_std_symptoms , 'brown_urine')) and not(selected( /data/perform_followup_group/uti_std_symptoms , 'high_blood_pressure')), 'true', 'false')"/>
      <bind nodeset="/data/calc_glomerulonephritis" type="string" calculate="if(selected( /data/perform_followup_group/uti_std_symptoms , 'oedema') or selected( /data/perform_followup_group/uti_std_symptoms , 'brown_urine') or selected( /data/perform_followup_group/uti_std_symptoms , 'high_blood_pressure'), 'true', 'false')"/>
      <bind nodeset="/data/calc_syphilis" type="string" calculate="if(selected( /data/perform_followup_group/uti_std_symptoms , 'ulcer_of_genital_parts'), 'true', 'false')"/>
      <bind nodeset="/data/calc_other_std" type="string" calculate="if(selected( /data/perform_followup_group/uti_std_symptoms , 'vaginal_or_urethral_discharge'), 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_uti  = 'true' or  /data/calc_glomerulonephritis  = 'true' or  /data/calc_syphilis  = 'true' or  /data/calc_other_std  = 'true'"/>
      <bind nodeset="/data/results_group/res_uti" readonly="true()" type="string" relevant=" /data/calc_uti  = 'true'"/>
      <bind nodeset="/data/results_group/res_uti_action" readonly="true()" type="string" relevant=" /data/calc_uti  = 'true'"/>
      <bind nodeset="/data/results_group/res_glomerulonephritis" readonly="true()" type="string" relevant=" /data/calc_glomerulonephritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_glomerulonephritis_action" readonly="true()" type="string" relevant=" /data/calc_glomerulonephritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_syphilis" readonly="true()" type="string" relevant=" /data/calc_syphilis  = 'true'"/>
      <bind nodeset="/data/results_group/res_syphilis_action" readonly="true()" type="string" relevant=" /data/calc_syphilis  = 'true'"/>
      <bind nodeset="/data/results_group/res_other_std" readonly="true()" type="string" relevant=" /data/calc_other_std  = 'true'"/>
      <bind nodeset="/data/results_group/res_other_std_action" readonly="true()" type="string" relevant=" /data/calc_other_std  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_uti  != 'true' and  /data/calc_glomerulonephritis  != 'true' and  /data/calc_syphilis  != 'true' and  /data/calc_other_std  != 'true'"/>
      <bind nodeset="/data/null_results_group/null_res_note" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_uti_std_symptoms" type="string" calculate="if( /data/perform_followup_group/uti_std_symptoms  != '',  /data/perform_followup_group/uti_std_symptoms , 'false')"/>
      <bind nodeset="/data/data/_temperature" type="string" calculate="if( /data/perform_followup_group/temperature  != '',  /data/perform_followup_group/temperature , -1)"/>
      <bind nodeset="/data/data/_urinary_strip_feasibility" type="string" calculate="if( /data/perform_followup_group/urinary_strip_feasibility  != '',  /data/perform_followup_group/urinary_strip_feasibility , 'false')"/>
      <bind nodeset="/data/data/_urinary_strip_result" type="string" calculate="if( /data/perform_followup_group/urinary_strip_result  != '',  /data/perform_followup_group/urinary_strip_result , 'false')"/>
      <bind nodeset="/data/data/_result_uti" type="string" calculate="if( /data/calc_uti ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_glomerulonephritis" type="string" calculate="if( /data/calc_glomerulonephritis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_syphilis" type="string" calculate="if( /data/calc_syphilis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_other_std" type="string" calculate="if( /data/calc_other_std ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_urine_strip_used" type="string" calculate="if( /data/perform_followup_group/urinary_strip_result  = 'yes' or  /data/perform_followup_group/urinary_strip_result  = 'no', 'true', 'false')"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;YAA_Form004_UTIandSTD&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/urine_strips_used_in_YAA_Form004_UTIandSTD" type="string" calculate="if( /data/data/_urine_strip_used  = 'true', 1, 0)"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/perform_followup_group">
      <label ref="jr:itext('/data/perform_followup_group:label')"/>
      <select ref="/data/perform_followup_group/uti_std_symptoms">
        <label ref="jr:itext('/data/perform_followup_group/uti_std_symptoms:label')"/>
        <itemset nodeset="instance('uti_std_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/perform_followup_group/temperature">
        <label ref="jr:itext('/data/perform_followup_group/temperature:label')"/>
      </input>
      <select1 ref="/data/perform_followup_group/urinary_strip_feasibility">
        <label ref="jr:itext('/data/perform_followup_group/urinary_strip_feasibility:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/perform_followup_group/urinary_strip_result">
        <label ref="jr:itext('/data/perform_followup_group/urinary_strip_result:label')"/>
        <itemset nodeset="instance('urine_strip_yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_uti" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_uti:label')"/>
      </input>
      <input ref="/data/results_group/res_uti_action">
        <label ref="jr:itext('/data/results_group/res_uti_action:label')"/>
      </input>
      <input ref="/data/results_group/res_glomerulonephritis" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_glomerulonephritis:label')"/>
      </input>
      <input ref="/data/results_group/res_glomerulonephritis_action">
        <label ref="jr:itext('/data/results_group/res_glomerulonephritis_action:label')"/>
      </input>
      <input ref="/data/results_group/res_syphilis" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_syphilis:label')"/>
      </input>
      <input ref="/data/results_group/res_syphilis_action">
        <label ref="jr:itext('/data/results_group/res_syphilis_action:label')"/>
      </input>
      <input ref="/data/results_group/res_other_std" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_other_std:label')"/>
      </input>
      <input ref="/data/results_group/res_other_std_action">
        <label ref="jr:itext('/data/results_group/res_other_std_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_res_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_res_note:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>