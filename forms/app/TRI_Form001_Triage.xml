<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Triage</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="TRI_Form001_Triage" version="20260902220444" prefix="J1!TRI_Form001_Triage!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <emergency_triage_group>
            <has_emergency_symptoms/>
            <emergency_symptoms/>
          </emergency_triage_group>
          <emergency_triage_summary>
            <emergency_action/>
          </emergency_triage_summary>
          <vitals_general_group>
            <bp_systolic/>
            <bp_diastolic/>
            <temperature/>
            <pulse_ox/>
            <respiratory_rate/>
            <heart_rate/>
            <pregnancy_status/>
            <general_symptoms_elderly/>
            <general_symptoms_adults/>
            <general_symptoms_youths/>
            <general_symptoms_children/>
          </vitals_general_group>
          <child_assessment>
            <vaccination_card/>
            <vaccinated_expected/>
            <refer_vaccination/>
            <received_albendazole/>
            <received_vitamin_a/>
          </child_assessment>
          <route_digestive/>
          <route_fever/>
          <route_hypertension/>
          <route_pregnancy/>
          <route_respiratory/>
          <route_skin/>
          <route_stroke/>
          <route_uti_std/>
          <route_wound/>
          <route_vision/>
          <route_diabetes/>
          <chd_vac/>
          <next_steps_group>
            <note_diabetes/>
            <note_digestive/>
            <note_fever/>
            <note_hypertension/>
            <note_pregnancy/>
            <note_respiratory/>
            <note_skin/>
            <note_stroke/>
            <note_uti_std/>
            <note_wound/>
            <note_vision/>
            <note_vac/>
            <note_tasks_will_appear/>
            <note_no_forms/>
          </next_steps_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="emergency_symptoms">
        <root>
          <item>
            <name>altered_consciousness</name>
            <label>Altered consciousness, seizures, inability to drink, respiratory distress</label>
          </item>
          <item>
            <name>shock</name>
            <label>Shock, hypotension, significant bleeding, severe dehydration</label>
          </item>
          <item>
            <name>chest_pain</name>
            <label>Severe chest pain, acute neurological deficit, suspected surgical abdomen</label>
          </item>
          <item>
            <name>pregnancy_complications</name>
            <label>Pregnant woman with bleeding, seizures, severe hypertension, severe pain, or complicated labor</label>
          </item>
          <item>
            <name>severe_ill_child</name>
            <label>Severely ill infant/child, complicated acute malnutrition</label>
          </item>
        </root>
      </instance>
      <instance id="general_symptoms_adult">
        <root>
          <item>
            <name>adt_diabetes</name>
            <label>Excessive thirst, frequent urination, unexplained weight loss</label>
          </item>
          <item>
            <name>adt_digestive</name>
            <label>Diarrhea, vomiting, nausea, or abdominal pain</label>
          </item>
          <item>
            <name>adt_fever</name>
            <label>Fever or recent history of fever</label>
          </item>
          <item>
            <name>adt_hypertension</name>
            <label>Headache, neck pain or stiffness, vertigo, nausea, blurry vision</label>
          </item>
          <item>
            <name>adt_pregnancy</name>
            <label>Bleeding, pain, contractions, severe headache, blurred vision, edema</label>
          </item>
          <item>
            <name>adt_respiratory</name>
            <label>Cough, wheezing, or difficulty breathing</label>
          </item>
          <item>
            <name>adt_skin</name>
            <label>Skin rash, bumps, itching, sores, or discoloration</label>
          </item>
          <item>
            <name>adt_stroke</name>
            <label>Sudden loss of motricity, facial paralysis, or altered speech</label>
          </item>
          <item>
            <name>adt_vision</name>
            <label>Blurry vision, loss of sight, or eye pain</label>
          </item>
          <item>
            <name>adt_uti</name>
            <label>Painful urination, unusual discharge, or genital ulcers</label>
          </item>
          <item>
            <name>adt_wound</name>
            <label>Cuts, scrapes, burns, or unhealed injuries</label>
          </item>
        </root>
      </instance>
      <instance id="general_symptoms_child">
        <root>
          <item>
            <name>chd_digestive</name>
            <label>Diarrhea, vomiting, nausea, or abdominal pain</label>
          </item>
          <item>
            <name>chd_respiratory</name>
            <label>Cough, wheezing, or difficulty breathing</label>
          </item>
          <item>
            <name>chd_skin</name>
            <label>Skin rash, bumps, itching, sores, or discoloration</label>
          </item>
          <item>
            <name>chd_wound</name>
            <label>Cuts, scrapes, burns, or unhealed injuries</label>
          </item>
          <item>
            <name>chd_vision</name>
            <label>Blurry vision, loss of sight, or eye pain</label>
          </item>
        </root>
      </instance>
      <instance id="general_symptoms_youth">
        <root>
          <item>
            <name>yaa_digestive</name>
            <label>Diarrhea, vomiting, nausea, or abdominal pain</label>
          </item>
          <item>
            <name>yaa_respiratory</name>
            <label>Cough, wheezing, or difficulty breathing</label>
          </item>
          <item>
            <name>yaa_skin</name>
            <label>Skin rash, bumps, itching, sores, or discoloration</label>
          </item>
          <item>
            <name>yaa_vision</name>
            <label>Blurry vision, loss of sight, or eye pain</label>
          </item>
          <item>
            <name>yaa_uti</name>
            <label>Painful urination, unusual discharge, or genital ulcers</label>
          </item>
          <item>
            <name>yaa_wound</name>
            <label>Cuts, scrapes, burns, or unhealed injuries</label>
          </item>
        </root>
      </instance>
      <instance id="general_symptoms_elderly">
        <root>
          <item>
            <name>eld_chronic_pain</name>
            <label>Joint pain, swollen joints, morning stiffness</label>
          </item>
          <item>
            <name>eld_diabetes</name>
            <label>Excessive thirst, frequent urination, unexplained weight loss</label>
          </item>
          <item>
            <name>eld_digestive</name>
            <label>Diarrhea, vomiting, nausea, or abdominal pain</label>
          </item>
          <item>
            <name>eld_fever</name>
            <label>Fever or recent history of fever</label>
          </item>
          <item>
            <name>eld_hypertension</name>
            <label>Headache, neck pain or stiffness, vertigo, nausea, blurry vision</label>
          </item>
          <item>
            <name>eld_respiratory</name>
            <label>Cough, wheezing, shortness of breath, jugular venous distention</label>
          </item>
          <item>
            <name>eld_skin</name>
            <label>Skin rash, bumps, itching, sores, or discoloration</label>
          </item>
          <item>
            <name>eld_stroke</name>
            <label>Sudden loss of motricity, facial paralysis, or altered speech</label>
          </item>
          <item>
            <name>eld_vision</name>
            <label>Blurry vision, loss of sight, or eye pain</label>
          </item>
          <item>
            <name>eld_uti</name>
            <label>Painful urination, unusual discharge, genital ulcers, or urinary retention</label>
          </item>
          <item>
            <name>eld_wound</name>
            <label>Cuts, scrapes, burns, or unhealed injuries</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/emergency_triage_group/has_emergency_symptoms" type="string" required="true()"/>
      <bind nodeset="/data/emergency_triage_group/emergency_symptoms" type="string" required="true()" relevant=" /data/emergency_triage_group/has_emergency_symptoms  = 'yes'"/>
      <bind nodeset="/data/emergency_triage_summary/emergency_action" readonly="true()" type="string" relevant=" /data/emergency_triage_group/has_emergency_symptoms  = 'yes'"/>
      <bind nodeset="/data/vitals_general_group" relevant=" /data/emergency_triage_group/has_emergency_symptoms  = 'no'"/>
      <bind nodeset="/data/vitals_general_group/bp_systolic" type="int" required="true()"/>
      <bind nodeset="/data/vitals_general_group/bp_diastolic" type="int" required="true()"/>
      <bind nodeset="/data/vitals_general_group/temperature" type="decimal" required="true()"/>
      <bind nodeset="/data/vitals_general_group/pulse_ox" type="int" required="true()"/>
      <bind nodeset="/data/vitals_general_group/respiratory_rate" type="int" required="true()"/>
      <bind nodeset="/data/vitals_general_group/heart_rate" type="int" required="true()"/>
      <bind nodeset="/data/vitals_general_group/pregnancy_status" type="string" required="true()" relevant=" /data/patient_age_in_years  &gt; 10 and  /data/patient_sex  = 'female'"/>
      <bind nodeset="/data/vitals_general_group/general_symptoms_elderly" type="string" relevant=" /data/patient_age_in_years  &gt; 64"/>
      <bind nodeset="/data/vitals_general_group/general_symptoms_adults" type="string" relevant=" /data/patient_age_in_years  &gt; 17 and  /data/patient_age_in_years  &lt; 65"/>
      <bind nodeset="/data/vitals_general_group/general_symptoms_youths" type="string" relevant=" /data/patient_age_in_years  &gt; 5 and  /data/patient_age_in_years  &lt; 18"/>
      <bind nodeset="/data/vitals_general_group/general_symptoms_children" type="string" relevant=" /data/patient_age_in_years  &lt; 6"/>
      <bind nodeset="/data/child_assessment" relevant=" /data/emergency_triage_group/has_emergency_symptoms  = 'no' and  /data/patient_age_in_years  &lt; 5"/>
      <bind nodeset="/data/child_assessment/vaccination_card" type="string" required="true()"/>
      <bind nodeset="/data/child_assessment/vaccinated_expected" type="string" required="true()"/>
      <bind nodeset="/data/child_assessment/refer_vaccination" readonly="true()" type="string" relevant=" /data/child_assessment/vaccinated_expected  = 'no'"/>
      <bind nodeset="/data/child_assessment/received_albendazole" type="string" required="true()"/>
      <bind nodeset="/data/child_assessment/received_vitamin_a" type="string" required="true()"/>
      <bind nodeset="/data/route_digestive" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_digestive') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_digestive') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_digestive') or selected( /data/vitals_general_group/general_symptoms_children , 'chd_digestive'), 'true', 'false')"/>
      <bind nodeset="/data/route_fever" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_fever') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_fever') or  /data/vitals_general_group/temperature  &gt; 38, 'true', 'false')"/>
      <bind nodeset="/data/route_hypertension" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_hypertension') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_hypertension') or  /data/vitals_general_group/bp_systolic  &gt;= 140 or  /data/vitals_general_group/bp_diastolic  &gt;= 90, 'true', 'false')"/>
      <bind nodeset="/data/route_pregnancy" type="string" calculate="if( /data/vitals_general_group/pregnancy_status  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/route_respiratory" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_respiratory') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_respiratory') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_respiratory') or selected( /data/vitals_general_group/general_symptoms_children , 'chd_respiratory') or  /data/vitals_general_group/respiratory_rate  &gt; 20 or  /data/vitals_general_group/pulse_ox  &lt; 95, 'true', 'false')"/>
      <bind nodeset="/data/route_skin" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_skin') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_skin') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_skin') or selected( /data/vitals_general_group/general_symptoms_children , 'chd_skin'), 'true', 'false')"/>
      <bind nodeset="/data/route_stroke" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_stroke') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_stroke'), 'true', 'false')"/>
      <bind nodeset="/data/route_uti_std" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_uti') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_uti') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_uti'), 'true', 'false')"/>
      <bind nodeset="/data/route_wound" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_wound') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_wound') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_wound') or selected( /data/vitals_general_group/general_symptoms_children , 'chd_wound'), 'true', 'false')"/>
      <bind nodeset="/data/route_vision" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_vision') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_vision') or selected( /data/vitals_general_group/general_symptoms_youths , 'yaa_vision') or selected( /data/vitals_general_group/general_symptoms_children , 'chd_vision'), 'true', 'false')"/>
      <bind nodeset="/data/route_diabetes" type="string" calculate="if(selected( /data/vitals_general_group/general_symptoms_elderly , 'eld_diabetes') or selected( /data/vitals_general_group/general_symptoms_adults , 'adt_diabetes'), 'true', 'false')"/>
      <bind nodeset="/data/chd_vac" type="string" calculate="if( /data/child_assessment/vaccinated_expected  = 'no' or  /data/child_assessment/received_albendazole  = 'no' or  /data/child_assessment/received_vitamin_a  = 'no', 'true', 'false')"/>
      <bind nodeset="/data/next_steps_group" relevant=" /data/emergency_triage_group/has_emergency_symptoms  = 'no'"/>
      <bind nodeset="/data/next_steps_group/note_diabetes" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_digestive" readonly="true()" type="string" relevant=" /data/route_digestive  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_fever" readonly="true()" type="string" relevant=" /data/route_fever  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_hypertension" readonly="true()" type="string" relevant=" /data/route_hypertension  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_pregnancy" readonly="true()" type="string" relevant=" /data/route_pregnancy  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_respiratory" readonly="true()" type="string" relevant=" /data/route_respiratory  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_skin" readonly="true()" type="string" relevant=" /data/route_skin  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_stroke" readonly="true()" type="string" relevant=" /data/route_stroke  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_uti_std" readonly="true()" type="string" relevant=" /data/route_uti_std  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_wound" readonly="true()" type="string" relevant=" /data/route_wound  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_vision" readonly="true()" type="string" relevant=" /data/route_vision  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_vac" readonly="true()" type="string" relevant=" /data/chd_vac  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_tasks_will_appear" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'true' or  /data/route_digestive  = 'true' or  /data/route_fever  = 'true' or  /data/route_hypertension  = 'true' or  /data/route_pregnancy  = 'true' or  /data/route_respiratory  = 'true' or  /data/route_skin  = 'true' or  /data/route_stroke  = 'true' or  /data/route_uti_std  = 'true' or  /data/route_wound  = 'true' or  /data/route_vision  = 'true' or  /data/chd_vac  = 'true'"/>
      <bind nodeset="/data/next_steps_group/note_no_forms" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'false' and  /data/route_digestive  = 'false' and  /data/route_fever  = 'false' and  /data/route_hypertension  = 'false' and  /data/route_pregnancy  = 'false' and  /data/route_respiratory  = 'false' and  /data/route_skin  = 'false' and  /data/route_stroke  = 'false' and  /data/route_uti_std  = 'false' and  /data/route_wound  = 'false' and  /data/route_vision  = 'false' and  /data/chd_vac  = 'false'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/emergency_triage_group">
      <label>Emergency Triage</label>
      <select1 ref="/data/emergency_triage_group/has_emergency_symptoms">
        <label>Are any emergency symptoms present?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/emergency_triage_group/emergency_symptoms">
        <label>Which emergency symptoms are present?</label>
        <itemset nodeset="instance('emergency_symptoms')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/emergency_triage_summary">
      <label>Emergency Triage Summary</label>
      <input ref="/data/emergency_triage_summary/emergency_action">
        <label>Emergency! Refer patient immediately. Position patient, establish IV line if needed. Alert referral hospital. Inform patient about specific measures to take during referral. Make sure to note triage time and vital signs in application for referral.</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/vitals_general_group">
      <label>Vitals and General Assessment</label>
      <input ref="/data/vitals_general_group/bp_systolic">
        <label>Systolic blood pressure</label>
      </input>
      <input ref="/data/vitals_general_group/bp_diastolic">
        <label>Diastolic blood pressure</label>
      </input>
      <input ref="/data/vitals_general_group/temperature">
        <label>Temperature</label>
      </input>
      <input ref="/data/vitals_general_group/pulse_ox">
        <label>Oxygen saturation (SpO2)</label>
      </input>
      <input ref="/data/vitals_general_group/respiratory_rate">
        <label>Respiratory rate</label>
