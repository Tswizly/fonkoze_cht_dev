      <instance>
        <data id="stock_order_supply" version="now()" prefix="J1!stock_order_supply!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <test_drug_ordered/>
            <second_test_drug_ordered/>
            <order_id/>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
            </user>
            <contact>
              <_id/>
              <name/>
              <parent>
                <_id/>
              </parent>
            </contact>
          </inputs>
          <place_id/>
          <supply_place_id/>
          <user_contact_id/>
          <Medicine>
            <___test_drug>
              <supply_test_drug_note/>
              <supply_test_drug/>
            </___test_drug>
            <___second_test_drug>
              <supply_second_test_drug_note/>
              <second_test_drug_ordered___set/>
              <second_test_drug_ordered___unit/>
              <second_test_drug___set/>
              <second_test_drug___unit/>
              <supply_second_test_drug>0/0</supply_second_test_drug>
            </___second_test_drug>
          </Medicine>
          <summary>
            <s_submit/>
            <r_summary/>
            <Medicine_summary/>
            <test_drug_summary/>
            <second_test_drug_summary/>
          </summary>
          <out>
            <test_drug_supply/>
            <second_test_drug_supply/>
          </out>
          <needs_signoff/>
          <stock_supply_doc db-doc="true">
            <form/>
            <type/>
            <created_from db-doc-ref="/data"/>
            <content_type/>
            <contact>
              <_id/>
            </contact>
            <fields>
              <place_id/>
              <s_order_id/>
              <supplier_id/>
              <need_confirmation/>
              <test_drug_in/>
              <second_test_drug_in/>
            </fields>
          </stock_supply_doc>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/test_drug_ordered" type="string"/>
      <bind nodeset="/data/inputs/second_test_drug_ordered" type="string"/>
      <bind nodeset="/data/inputs/order_id" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/parent/_id"/>
      <bind nodeset="/data/supply_place_id" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/user_contact_id" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/Medicine" relevant=" /data/inputs/test_drug_ordered  &gt; 0 or  /data/inputs/second_test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/Medicine/___test_drug" relevant=" /data/inputs/test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/Medicine/___test_drug/supply_test_drug_note" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___test_drug/supply_test_drug" type="int" required="true()"/>
      <bind nodeset="/data/Medicine/___second_test_drug" relevant=" /data/inputs/second_test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/Medicine/___second_test_drug/supply_second_test_drug_note" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug_ordered___set" type="string" calculate="int( /data/inputs/second_test_drug_ordered  div 12)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug_ordered___unit" type="string" calculate=" /data/inputs/second_test_drug_ordered  mod 12"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug___set" type="string" calculate="if(count-selected( /data/Medicine/___second_test_drug/supply_second_test_drug ) &gt; 0 and count-selected(substring-before( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug___unit" type="string" calculate="if(count-selected( /data/Medicine/___second_test_drug/supply_second_test_drug ) &gt; 0 and count-selected(substring-after( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___second_test_drug/supply_second_test_drug , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/supply_second_test_drug" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine_summary" readonly="true()" type="string" relevant=" /data/inputs/test_drug_ordered  &gt; 0 or  /data/inputs/second_test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/summary/test_drug_summary" readonly="true()" type="string" relevant=" /data/inputs/test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/summary/second_test_drug_summary" readonly="true()" type="string" relevant=" /data/inputs/second_test_drug_ordered  &gt; 0"/>
      <bind nodeset="/data/out/test_drug_supply" type="string" calculate=" /data/Medicine/___test_drug/supply_test_drug "/>
      <bind nodeset="/data/out/second_test_drug_supply" type="string" calculate=" /data/Medicine/___second_test_drug/second_test_drug___set  * 12 +  /data/Medicine/___second_test_drug/second_test_drug___unit "/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/stock_supply_doc/form" type="string" calculate="&quot;stock_supply_doc&quot;"/>
      <bind nodeset="/data/stock_supply_doc/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/stock_supply_doc/created_from" type="string" calculate="."/>
      <bind nodeset="/data/stock_supply_doc/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/stock_supply_doc/contact/_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/place_id" type="string" calculate=" /data/supply_place_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/s_order_id" type="string" calculate=" /data/inputs/order_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/supplier_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/need_confirmation" type="string" calculate="&quot;yes&quot;"/>
      <bind nodeset="/data/stock_supply_doc/fields/test_drug_in" type="string" calculate=" /data/out/test_drug_supply "/>
      <bind nodeset="/data/stock_supply_doc/fields/second_test_drug_in" type="string" calculate=" /data/out/second_test_drug_supply "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
        <group appearance="hidden" ref="/data/inputs/contact/parent">
          <input ref="/data/inputs/contact/parent/_id"/>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <group ref="/data/Medicine/___test_drug">
        <label ref="jr:itext('/data/Medicine/___test_drug:label')"/>
        <input ref="/data/Medicine/___test_drug/supply_test_drug_note">
          <label ref="jr:itext('/data/Medicine/___test_drug/supply_test_drug_note:label')"/>
        </input>
        <input ref="/data/Medicine/___test_drug/supply_test_drug">
          <label ref="jr:itext('/data/Medicine/___test_drug/supply_test_drug:label')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___second_test_drug">
        <label ref="jr:itext('/data/Medicine/___second_test_drug:label')"/>
        <input ref="/data/Medicine/___second_test_drug/supply_second_test_drug_note">
          <label ref="jr:itext('/data/Medicine/___second_test_drug/supply_second_test_drug_note:label')"/>
        </input>
        <input ref="/data/Medicine/___second_test_drug/supply_second_test_drug">
          <label ref="jr:itext('/data/Medicine/___second_test_drug/supply_second_test_drug:label')"/>
          <hint ref="jr:itext('/data/Medicine/___second_test_drug/supply_second_test_drug:hint')"/>
        </input>
      </group>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/Medicine_summary" appearance="h1 blue">
        <label ref="jr:itext('/data/summary/Medicine_summary:label')"/>
      </input>
      <input ref="/data/summary/test_drug_summary" appearance="li">
        <label ref="jr:itext('/data/summary/test_drug_summary:label')"/>
      </input>
      <input ref="/data/summary/second_test_drug_summary" appearance="li">
        <label ref="jr:itext('/data/summary/second_test_drug_summary:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out"/>
    <group appearance="field-list" ref="/data/stock_supply_doc">
      <group ref="/data/stock_supply_doc/contact"/>
      <group ref="/data/stock_supply_doc/fields"/>
    </group>
  </h:body>
</h:html>