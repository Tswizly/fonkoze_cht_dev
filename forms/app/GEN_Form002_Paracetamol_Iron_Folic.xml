      <bind nodeset="/data/prescription_summary/fields/paracetamol_500mg_used_in_GEN_Form002_Paracetamol_Iron_Folic" type="string" calculate=" /data/prescription_summary/fields/paracetamol_500mg___set  * 8 +  /data/prescription_summary/fields/paracetamol_500mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in" type="string" calculate=" /data/data/_iron_and_folic_acid_distributed "/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in_GEN_Form002_Paracetamol_Iron_Folic" type="string" calculate=" /data/prescription_summary/fields/iron_and_folic_acid_tablets___set  * 8 +  /data/prescription_summary/fields/iron_and_folic_acid_tablets___unit "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/medicine_select">
      <label ref="jr:itext('/data/medicine_select:label')"/>
      <select ref="/data/medicine_select/distribution_check">
        <label ref="jr:itext('/data/medicine_select/distribution_check:label')"/>
        <itemset nodeset="instance('prev_drugs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/medicine_select/which_to_distribute">
        <label ref="jr:itext('/data/medicine_select/which_to_distribute:label')"/>
        <itemset nodeset="instance('drugs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/null_distribution">
      <label ref="jr:itext('/data/null_distribution:label')"/>
      <input ref="/data/null_distribution/null_header_note" appearance="h1 yellow">
        <label ref="jr:itext('/data/null_distribution/null_header_note:label')"/>
      </input>
      <input ref="/data/null_distribution/null_header_explaination">
        <label ref="jr:itext('/data/null_distribution/null_header_explaination:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/distribution_group">
      <label ref="jr:itext('/data/distribution_group:label')"/>
      <input ref="/data/distribution_group/distribution_summary" appearance="h1 green">
        <label ref="jr:itext('/data/distribution_group/distribution_summary:label')"/>
      </input>
      <input ref="/data/distribution_group/distribution_instruction_paracetamol">
        <label ref="jr:itext('/data/distribution_group/distribution_instruction_paracetamol:label')"/>
        <hint>NOTE: Amount can be changed once packet size is known.</hint>
      </input>
      <input ref="/data/distribution_group/distribution_instruction_iron_folic_acid">
        <label ref="jr:itext('/data/distribution_group/distribution_instruction_iron_folic_acid:label')"/>
        <hint>NOTE: Amount can be changed once packet size is known.</hint>
      </input>
      <select ref="/data/distribution_group/distribution_confirmation">
        <label ref="jr:itext('/data/distribution_group/distribution_confirmation:label')"/>
        <itemset nodeset="instance('confirmation')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden">
          <label ref="jr:itext('/data/prescription_summary/fields/Medicine_out:label')"/>
        </input>
      </group>
    </group>
  </h:body>
</h:html>