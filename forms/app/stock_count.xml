<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Stock Count</h:title>
    <model odk:xforms-version="1.0.0">
      <itext>
        <translation lang="en">
          <text id="/data/inputs:label">
            <value>Patient</value>
          </text>
          <text id="/data/inputs/source:label">
            <value>Source</value>
          </text>
          <text id="/data/inputs/source_id:label">
            <value>Source ID</value>
          </text>
          <text id="/data/Medicine:label">
            <value>Medicine - Distributable drugs</value>
          </text>
          <text id="/data/Medicine/test_drug:label">
            <value>Test Drug</value>
          </text>
          <text id="/data/Medicine/test_drug:hint">
            <value> Add the quantity: <output value=" /data/Medicine/test_drug "/> tablet</value>
          </text>
          <text id="/data/Medicine/second_test_drug:label">
            <value>Second Test Drug</value>
          </text>
          <text id="/data/Medicine/second_test_drug:hint">
            <value><output value=" /data/Medicine/second_test_drug___set "/> box of 12 <output value=" /data/Medicine/second_test_drug___unit "/> pill</value>
          </text>
          <text id="/data/summary:label">
            <value>Results/Summary page</value>
          </text>
          <text id="/data/summary/s_submit:label">
            <value>&lt;h4 style="text-align:center;"&gt;Be sure you Submit to complete this action.&lt;/h4&gt;</value>
          </text>
          <text id="/data/summary/r_summary:label">
            <value>Stock items you currently have.&lt;i class="fa fa-list-ul"&gt;&lt;/i&gt;</value>
          </text>
          <text id="/data/summary/s_test_drug:label">
            <value> Test Drug: **<output value=" /data/Medicine/test_drug___count "/> tablet**</value>
          </text>
          <text id="/data/summary/s_second_test_drug:label">
            <value> Second Test Drug: **<output value=" /data/Medicine/second_test_drug___set "/> box of 12 <output value=" /data/Medicine/second_test_drug___unit "/> pill**</value>
          </text>
        </translation>
