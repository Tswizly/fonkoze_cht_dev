      <instance>
        <data id="stock_returned" version="now()" prefix="J1!stock_returned!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <test_drug_return/>
            <second_test_drug_return/>
            <level_1_place_id/>
            <stock_return_id/>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
            </user>
            <contact>
              <_id/>
              <name/>
              <parent>
                <_id/>
              </parent>
            </contact>
          </inputs>
          <place_id/>
          <user_contact_id/>
          <Medicine>
            <___test_drug>
              <test_drug_received/>
              <test_drug_received_qty/>
              <test_drug___count/>
            </___test_drug>
            <___second_test_drug>
              <second_test_drug__return___set/>
              <second_test_drug__return___unit/>
              <second_test_drug_received/>
              <second_test_drug___set/>
              <second_test_drug___unit/>
              <second_test_drug_received_qty>0/0</second_test_drug_received_qty>
              <second_test_drug___count/>
            </___second_test_drug>
          </Medicine>
          <summary>
            <s_submit/>
            <r_summary/>
            <Medicine_summary/>
            <test_drug_summary_no/>
            <test_drug_summary_yes/>
            <second_test_drug_summary_no/>
            <second_test_drug_summary_yes/>
          </summary>
          <out>
            <test_drug_in/>
            <second_test_drug_in/>
          </out>
          <needs_signoff/>
          <sm---stock_returned db-doc="true">
            <form/>
            <place_id/>
            <type/>
            <created_from db-doc-ref="/data"/>
            <content_type/>
            <contact>
              <_id/>
            </contact>
            <fields>
              <test_drug_return_difference/>
              <second_test_drug_return_difference/>
              <return_id/>
            </fields>
          </sm---stock_returned>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <itextId>yes_no-0</itextId>
            <name>yes</name>
          </item>
          <item>
            <itextId>yes_no-1</itextId>
            <name>no</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/test_drug_return" type="string"/>
      <bind nodeset="/data/inputs/second_test_drug_return" type="string"/>
      <bind nodeset="/data/inputs/level_1_place_id" type="string"/>
      <bind nodeset="/data/inputs/stock_return_id" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/parent/_id"/>
      <bind nodeset="/data/user_contact_id" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/Medicine" relevant=" /data/inputs/test_drug_return  &gt; 0 or  /data/inputs/second_test_drug_return  &gt; 0"/>
      <bind nodeset="/data/Medicine/___test_drug" relevant=" /data/inputs/test_drug_return  &gt; 0"/>
      <bind nodeset="/data/Medicine/___test_drug/test_drug_received" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___test_drug/test_drug_received_qty" type="decimal" required="true()" relevant=" /data/Medicine/___test_drug/test_drug_received  = 'no'" constraint=". &gt; 0"/>
      <bind nodeset="/data/Medicine/___test_drug/test_drug___count" type="string" calculate=" /data/Medicine/___test_drug/test_drug_received_qty "/>
      <bind nodeset="/data/Medicine/___second_test_drug" relevant=" /data/inputs/second_test_drug_return  &gt; 0"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug__return___set" type="string" calculate="int( /data/inputs/second_test_drug_return  div 12)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug__return___unit" type="string" calculate=" /data/inputs/second_test_drug_return  mod 12"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug_received" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug___set" type="string" calculate="if(count-selected( /data/Medicine/___second_test_drug/second_test_drug_received_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug___unit" type="string" calculate="if(count-selected( /data/Medicine/___second_test_drug/second_test_drug_received_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___second_test_drug/second_test_drug_received_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug_received_qty" type="string" required="true()" relevant=" /data/Medicine/___second_test_drug/second_test_drug_received  = 'no'" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/Medicine/___second_test_drug/second_test_drug___count" type="string" calculate=" /data/Medicine/___second_test_drug/second_test_drug___set  * 12 +  /data/Medicine/___second_test_drug/second_test_drug___unit "/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine_summary" readonly="true()" type="string" relevant=" /data/inputs/test_drug_return  &gt; 0 or  /data/inputs/second_test_drug_return  &gt; 0"/>
      <bind nodeset="/data/summary/test_drug_summary_no" readonly="true()" type="string" relevant=" /data/Medicine/___test_drug/test_drug_received  = 'no'"/>
      <bind nodeset="/data/summary/test_drug_summary_yes" readonly="true()" type="string" relevant=" /data/Medicine/___test_drug/test_drug_received  = 'yes'"/>
      <bind nodeset="/data/summary/second_test_drug_summary_no" readonly="true()" type="string" relevant=" /data/Medicine/___second_test_drug/second_test_drug_received  = 'no'"/>
      <bind nodeset="/data/summary/second_test_drug_summary_yes" readonly="true()" type="string" relevant=" /data/Medicine/___second_test_drug/second_test_drug_received  = 'yes'"/>
      <bind nodeset="/data/out/test_drug_in" type="string" calculate="if( /data/Medicine/___test_drug/test_drug_received  = 'no', /data/Medicine/___test_drug/test_drug___count , /data/inputs/test_drug_return )"/>
      <bind nodeset="/data/out/second_test_drug_in" type="string" calculate="if( /data/Medicine/___second_test_drug/second_test_drug_received  = 'no', /data/Medicine/___second_test_drug/second_test_drug___count , /data/inputs/second_test_drug_return )"/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/sm---stock_returned/form" type="string" calculate="&quot;sm---stock_returned&quot;"/>
      <bind nodeset="/data/sm---stock_returned/place_id" type="string" calculate=" /data/inputs/level_1_place_id "/>
      <bind nodeset="/data/sm---stock_returned/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/sm---stock_returned/created_from" type="string" calculate="."/>
      <bind nodeset="/data/sm---stock_returned/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/sm---stock_returned/contact/_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/sm---stock_returned/fields/test_drug_return_difference" type="string" calculate="if( /data/Medicine/___test_drug/test_drug_received  = 'no', /data/inputs/test_drug_return - /data/Medicine/___test_drug/test_drug___count ,0)"/>
      <bind nodeset="/data/sm---stock_returned/fields/second_test_drug_return_difference" type="string" calculate="if( /data/Medicine/___second_test_drug/second_test_drug_received  = 'no', /data/inputs/second_test_drug_return - /data/Medicine/___second_test_drug/second_test_drug___count ,0)"/>
      <bind nodeset="/data/sm---stock_returned/fields/return_id" type="string" calculate=" /data/inputs/stock_return_id "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
        <group appearance="hidden" ref="/data/inputs/contact/parent">
          <input ref="/data/inputs/contact/parent/_id"/>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <group ref="/data/Medicine/___test_drug">
        <label ref="jr:itext('/data/Medicine/___test_drug:label')"/>
        <select1 ref="/data/Medicine/___test_drug/test_drug_received">
          <label ref="jr:itext('/data/Medicine/___test_drug/test_drug_received:label')"/>
          <itemset nodeset="instance('yes_no')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select1>
        <input ref="/data/Medicine/___test_drug/test_drug_received_qty">
          <label ref="jr:itext('/data/Medicine/___test_drug/test_drug_received_qty:label')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___second_test_drug">
        <label ref="jr:itext('/data/Medicine/___second_test_drug:label')"/>
        <select1 ref="/data/Medicine/___second_test_drug/second_test_drug_received">
          <label ref="jr:itext('/data/Medicine/___second_test_drug/second_test_drug_received:label')"/>
          <itemset nodeset="instance('yes_no')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
