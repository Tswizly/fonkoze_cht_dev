      <instance>
        <data id="stock_count" version="now()" prefix="J1!stock_count!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <date_id/>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
            </user>
            <contact>
              <_id/>
              <name/>
            </contact>
          </inputs>
          <Medicine>
            <metformin_500mg___set>0/0</metformin_500mg___set>
            <metformin_500mg___unit>0/0</metformin_500mg___unit>
            <metformin_500mg>0/0</metformin_500mg>
            <metformin_500mg___count/>
            <notinset>0</notinset>
            <notinset___count/>
            <InSet___set>0/0</InSet___set>
            <InSet___unit>0/0</InSet___unit>
            <InSet>0/0</InSet>
            <InSet___count/>
          </Medicine>
          <place_id/>
          <summary>
            <s_submit/>
            <r_summary/>
            <s_metformin_500mg/>
            <s_notinset/>
            <s_InSet/>
          </summary>
          <out>
            <metformin_500mg_availables/>
            <notinset_availables/>
            <InSet_availables/>
          </out>
          <needs_signoff/>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/date_id" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/Medicine/metformin_500mg___set" type="string" calculate="if(count-selected( /data/Medicine/metformin_500mg ) &gt; 0 and count-selected(substring-before( /data/Medicine/metformin_500mg , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/metformin_500mg , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/metformin_500mg , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/metformin_500mg___unit" type="string" calculate="if(count-selected( /data/Medicine/metformin_500mg ) &gt; 0 and count-selected(substring-after( /data/Medicine/metformin_500mg , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/metformin_500mg , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/metformin_500mg , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/metformin_500mg" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x boîte de 100 and y comprimé"/>
      <bind nodeset="/data/Medicine/metformin_500mg___count" type="string" calculate=" /data/Medicine/metformin_500mg___set  * 100 +  /data/Medicine/metformin_500mg___unit "/>
      <bind nodeset="/data/Medicine/notinset" type="int" required="true()"/>
      <bind nodeset="/data/Medicine/notinset___count" type="string" calculate=" /data/Medicine/notinset "/>
      <bind nodeset="/data/Medicine/InSet___set" type="string" calculate="if(count-selected( /data/Medicine/InSet ) &gt; 0 and count-selected(substring-before( /data/Medicine/InSet , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/InSet , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/InSet , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/InSet___unit" type="string" calculate="if(count-selected( /data/Medicine/InSet ) &gt; 0 and count-selected(substring-after( /data/Medicine/InSet , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/InSet , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/InSet , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/InSet" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x box of and y tablet"/>
      <bind nodeset="/data/Medicine/InSet___count" type="string" calculate=" /data/Medicine/InSet___set  * 10 +  /data/Medicine/InSet___unit "/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/s_metformin_500mg" readonly="true()" type="string" relevant=" /data/Medicine/metformin_500mg___count  &gt; 0"/>
      <bind nodeset="/data/summary/s_notinset" readonly="true()" type="string" relevant=" /data/Medicine/notinset___count  &gt; 0"/>
      <bind nodeset="/data/summary/s_InSet" readonly="true()" type="string" relevant=" /data/Medicine/InSet___count  &gt; 0"/>
      <bind nodeset="/data/out/metformin_500mg_availables" type="string" calculate=" /data/Medicine/metformin_500mg___count "/>
      <bind nodeset="/data/out/notinset_availables" type="string" calculate=" /data/Medicine/notinset___count "/>
      <bind nodeset="/data/out/InSet_availables" type="string" calculate=" /data/Medicine/InSet___count "/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
      </group>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <input ref="/data/Medicine/metformin_500mg">
        <label ref="jr:itext('/data/Medicine/metformin_500mg:label')"/>
        <hint ref="jr:itext('/data/Medicine/metformin_500mg:hint')"/>
      </input>
      <input ref="/data/Medicine/notinset">
        <label ref="jr:itext('/data/Medicine/notinset:label')"/>
        <hint ref="jr:itext('/data/Medicine/notinset:hint')"/>
      </input>
      <input ref="/data/Medicine/InSet">
        <label ref="jr:itext('/data/Medicine/InSet:label')"/>
        <hint ref="jr:itext('/data/Medicine/InSet:hint')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/s_metformin_500mg" appearance="li">
        <label ref="jr:itext('/data/summary/s_metformin_500mg:label')"/>
      </input>
      <input ref="/data/summary/s_notinset" appearance="li">
        <label ref="jr:itext('/data/summary/s_notinset:label')"/>
      </input>
      <input ref="/data/summary/s_InSet" appearance="li">
        <label ref="jr:itext('/data/summary/s_InSet:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out"/>
  </h:body>
</h:html>