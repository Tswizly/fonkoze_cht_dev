      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate=" /data/supply_place_id "/>
      <bind nodeset="/data/user_contact_id" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/supply_place_id" type="string" calculate="../inputs/contact/parent/_id"/>
      <bind nodeset="/data/Medicine" relevant=" /data/inputs/metformin_500mg_received  != /data/inputs/metformin_500mg_confirmed  or  /data/inputs/notinset_received  != /data/inputs/notinset_confirmed  or  /data/inputs/InSet_received  != /data/inputs/InSet_confirmed "/>
      <bind nodeset="/data/Medicine/___metformin_500mg" relevant=" /data/inputs/metformin_500mg_received  != /data/inputs/metformin_500mg_confirmed "/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__issued___set" type="string" calculate="int( /data/inputs/metformin_500mg_received  div 100)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__issued___unit" type="string" calculate=" /data/inputs/metformin_500mg_received  mod 100"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_note_issued" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__confirmed___set" type="string" calculate="int( /data/inputs/metformin_500mg_confirmed  div 100)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__confirmed___unit" type="string" calculate=" /data/inputs/metformin_500mg_confirmed  mod 100"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_note_confirmed" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___set" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___unit" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_qty" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___count" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___set  * 100 +  /data/Medicine/___metformin_500mg/metformin_500mg___unit "/>
      <bind nodeset="/data/Medicine/___notinset" relevant=" /data/inputs/notinset_received  != /data/inputs/notinset_confirmed "/>
      <bind nodeset="/data/Medicine/___notinset/notinset_note_issued" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_note_confirmed" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_qty" type="decimal" required="true()" constraint=". &gt; 0"/>
      <bind nodeset="/data/Medicine/___notinset/notinset___count" type="string" calculate=" /data/Medicine/___notinset/notinset_qty "/>
      <bind nodeset="/data/Medicine/___InSet" relevant=" /data/inputs/InSet_received  != /data/inputs/InSet_confirmed "/>
      <bind nodeset="/data/Medicine/___InSet/InSet__issued___set" type="string" calculate="int( /data/inputs/InSet_received  div 10)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet__issued___unit" type="string" calculate=" /data/inputs/InSet_received  mod 10"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_note_issued" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___InSet/InSet__confirmed___set" type="string" calculate="int( /data/inputs/InSet_confirmed  div 10)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet__confirmed___unit" type="string" calculate=" /data/inputs/InSet_confirmed  mod 10"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_note_confirmed" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___set" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___unit" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___InSet/InSet_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_qty" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___count" type="string" calculate=" /data/Medicine/___InSet/InSet___set  * 10 +  /data/Medicine/___InSet/InSet___unit "/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine_summary" readonly="true()" type="string" relevant=" /data/Medicine/___metformin_500mg/metformin_500mg_qty  &gt; 0 or  /data/Medicine/___notinset/notinset_qty  &gt; 0 or  /data/Medicine/___InSet/InSet_qty  &gt; 0"/>
      <bind nodeset="/data/summary/metformin_500mg_summary" readonly="true()" type="string" relevant=" /data/Medicine/___metformin_500mg/metformin_500mg___count  &gt; 0"/>
      <bind nodeset="/data/summary/notinset_summary" readonly="true()" type="string" relevant=" /data/Medicine/___notinset/notinset___count  &gt; 0"/>
      <bind nodeset="/data/summary/InSet_summary" readonly="true()" type="string" relevant=" /data/Medicine/___InSet/InSet___count  &gt; 0"/>
      <bind nodeset="/data/out/metformin_500mg_in" type="string" calculate="if( /data/Medicine/___metformin_500mg/metformin_500mg_qty  != '' and  /data/Medicine/___metformin_500mg/metformin_500mg___count  &gt; 0, /data/inputs/metformin_500mg_received - /data/Medicine/___metformin_500mg/metformin_500mg___count ,0)"/>
      <bind nodeset="/data/out/notinset_in" type="string" calculate="if( /data/Medicine/___notinset/notinset_qty  != '' and  /data/Medicine/___notinset/notinset___count  &gt; 0, /data/inputs/notinset_received - /data/Medicine/___notinset/notinset___count ,0)"/>
      <bind nodeset="/data/out/InSet_in" type="string" calculate="if( /data/Medicine/___InSet/InSet_qty  != '' and  /data/Medicine/___InSet/InSet___count  &gt; 0, /data/inputs/InSet_received - /data/Medicine/___InSet/InSet___count ,0)"/>
      <bind nodeset="/data/descrepancy_doc/form" type="string" calculate="&quot;descrepancy_doc&quot;"/>
      <bind nodeset="/data/descrepancy_doc/place_id" type="string" calculate=" /data/inputs/level_1_place_id "/>
      <bind nodeset="/data/descrepancy_doc/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/descrepancy_doc/created_from" type="string" calculate="."/>
      <bind nodeset="/data/descrepancy_doc/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/descrepancy_doc/contact/_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/descrepancy_doc/fields/metformin_500mg_out" type="string" calculate="if( /data/Medicine/___metformin_500mg/metformin_500mg_qty  != '' and  /data/Medicine/___metformin_500mg/metformin_500mg___count  &gt; 0, /data/Medicine/___metformin_500mg/metformin_500mg___count - /data/inputs/metformin_500mg_confirmed ,0)"/>
      <bind nodeset="/data/descrepancy_doc/fields/notinset_out" type="string" calculate="if( /data/Medicine/___notinset/notinset_qty  != '' and  /data/Medicine/___notinset/notinset___count  &gt; 0, /data/Medicine/___notinset/notinset___count - /data/inputs/notinset_confirmed ,0)"/>
      <bind nodeset="/data/descrepancy_doc/fields/InSet_out" type="string" calculate="if( /data/Medicine/___InSet/InSet_qty  != '' and  /data/Medicine/___InSet/InSet___count  &gt; 0, /data/Medicine/___InSet/InSet___count - /data/inputs/InSet_confirmed ,0)"/>
      <bind nodeset="/data/descrepancy_doc/fields/confirmation_id" type="string" calculate=" /data/inputs/supply_confirm_id "/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
        <group appearance="hidden" ref="/data/inputs/contact/parent">
          <input ref="/data/inputs/contact/parent/_id"/>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <group ref="/data/Medicine/___metformin_500mg">
        <label ref="jr:itext('/data/Medicine/___metformin_500mg:label')"/>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_note_issued">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_note_issued:label')"/>
        </input>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_note_confirmed">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_note_confirmed:label')"/>
        </input>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_qty">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_qty:hint')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___notinset">
        <label ref="jr:itext('/data/Medicine/___notinset:label')"/>
        <input ref="/data/Medicine/___notinset/notinset_note_issued">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_note_issued:label')"/>
        </input>
        <input ref="/data/Medicine/___notinset/notinset_note_confirmed">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_note_confirmed:label')"/>
        </input>
        <input ref="/data/Medicine/___notinset/notinset_qty">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_qty:label')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___InSet">
        <label ref="jr:itext('/data/Medicine/___InSet:label')"/>
        <input ref="/data/Medicine/___InSet/InSet_note_issued">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_note_issued:label')"/>
        </input>
        <input ref="/data/Medicine/___InSet/InSet_note_confirmed">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_note_confirmed:label')"/>
        </input>
        <input ref="/data/Medicine/___InSet/InSet_qty">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___InSet/InSet_qty:hint')"/>
        </input>
      </group>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/Medicine_summary" appearance="h1 blue">
        <label ref="jr:itext('/data/summary/Medicine_summary:label')"/>
      </input>
      <input ref="/data/summary/metformin_500mg_summary" appearance="li">
        <label ref="jr:itext('/data/summary/metformin_500mg_summary:label')"/>
      </input>
      <input ref="/data/summary/notinset_summary" appearance="li">
        <label ref="jr:itext('/data/summary/notinset_summary:label')"/>
      </input>
      <input ref="/data/summary/InSet_summary" appearance="li">
        <label ref="jr:itext('/data/summary/InSet_summary:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out"/>
    <group appearance="field-list" ref="/data/descrepancy_doc">
      <group ref="/data/descrepancy_doc/contact"/>
      <group ref="/data/descrepancy_doc/fields"/>
    </group>
  </h:body>
</h:html>