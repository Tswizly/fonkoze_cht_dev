      <bind nodeset="/data/inputs/InSet_received" type="string"/>
      <bind nodeset="/data/inputs/supplier_id" type="string"/>
      <bind nodeset="/data/inputs/supply_doc_id" type="string"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/Medicine" relevant=" /data/inputs/metformin_500mg_received  &gt; 0 or  /data/inputs/notinset_received  &gt; 0 or  /data/inputs/InSet_received  &gt; 0"/>
      <bind nodeset="/data/Medicine/___metformin_500mg" relevant=" /data/inputs/metformin_500mg_received  &gt; 0"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__received___set" type="string" calculate="int( /data/inputs/metformin_500mg_received  div 100)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg__received___unit" type="string" calculate=" /data/inputs/metformin_500mg_received  mod 100"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___set" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___unit" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_real_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_real_qty" type="string" required="true()" relevant=" /data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty  = 'no'" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x boîte de 100 and y comprimé"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___count" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___set  * 100 +  /data/Medicine/___metformin_500mg/metformin_500mg___unit "/>
      <bind nodeset="/data/Medicine/___notinset" relevant=" /data/inputs/notinset_received  &gt; 0"/>
      <bind nodeset="/data/Medicine/___notinset/have_receive_notinset_qty" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_real_qty" type="int" required="true()" relevant=" /data/Medicine/___notinset/have_receive_notinset_qty  = 'no'" constraint=". !=  /data/inputs/notinset_received "/>
      <bind nodeset="/data/Medicine/___notinset/notinset___count" type="string" calculate=" /data/Medicine/___notinset/notinset_real_qty "/>
      <bind nodeset="/data/Medicine/___InSet" relevant=" /data/inputs/InSet_received  &gt; 0"/>
      <bind nodeset="/data/Medicine/___InSet/InSet__received___set" type="string" calculate="int( /data/inputs/InSet_received  div 10)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet__received___unit" type="string" calculate=" /data/inputs/InSet_received  mod 10"/>
      <bind nodeset="/data/Medicine/___InSet/have_receive_InSet_qty" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___set" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_real_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___unit" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_real_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___InSet/InSet_real_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_real_qty" type="string" required="true()" relevant=" /data/Medicine/___InSet/have_receive_InSet_qty  = 'no'" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x box of and y tablet"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___count" type="string" calculate=" /data/Medicine/___InSet/InSet___set  * 10 +  /data/Medicine/___InSet/InSet___unit "/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine_summary" readonly="true()" type="string" relevant="number( /data/inputs/metformin_500mg_received ) &gt; 0 or number( /data/inputs/notinset_received ) &gt; 0 or number( /data/inputs/InSet_received ) &gt; 0"/>
      <bind nodeset="/data/summary/metformin_500mg_summary_yes" readonly="true()" type="string" relevant="number( /data/inputs/metformin_500mg_received ) &gt; 0 and  /data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty  = 'yes'"/>
      <bind nodeset="/data/summary/notinset_summary_yes" readonly="true()" type="string" relevant="number( /data/inputs/notinset_received ) &gt; 0 and  /data/Medicine/___notinset/have_receive_notinset_qty  = 'yes'"/>
      <bind nodeset="/data/summary/InSet_summary_yes" readonly="true()" type="string" relevant="number( /data/inputs/InSet_received ) &gt; 0 and  /data/Medicine/___InSet/have_receive_InSet_qty  = 'yes'"/>
      <bind nodeset="/data/summary/metformin_500mg_summary_no" readonly="true()" type="string" relevant="number( /data/inputs/metformin_500mg_received ) &gt; 0 and  /data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty  = 'no'"/>
      <bind nodeset="/data/summary/notinset_summary_no" readonly="true()" type="string" relevant="number( /data/inputs/notinset_received ) &gt; 0 and  /data/Medicine/___notinset/have_receive_notinset_qty  = 'no'"/>
      <bind nodeset="/data/summary/InSet_summary_no" readonly="true()" type="string" relevant="number( /data/inputs/InSet_received ) &gt; 0 and  /data/Medicine/___InSet/have_receive_InSet_qty  = 'no'"/>
      <bind nodeset="/data/out/metformin_500mg_confirmed" type="string" calculate="if( /data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty  = 'yes', /data/inputs/metformin_500mg_received , /data/Medicine/___metformin_500mg/metformin_500mg___count )"/>
      <bind nodeset="/data/out/notinset_confirmed" type="string" calculate="if( /data/Medicine/___notinset/have_receive_notinset_qty  = 'yes', /data/inputs/notinset_received , /data/Medicine/___notinset/notinset___count )"/>
      <bind nodeset="/data/out/InSet_confirmed" type="string" calculate="if( /data/Medicine/___InSet/have_receive_InSet_qty  = 'yes', /data/inputs/InSet_received , /data/Medicine/___InSet/InSet___count )"/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
      </group>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <group ref="/data/Medicine/___metformin_500mg">
        <label ref="jr:itext('/data/Medicine/___metformin_500mg:label')"/>
        <select1 ref="/data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/have_receive_metformin_500mg_qty:label')"/>
          <itemset nodeset="instance('yes_no')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select1>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_real_qty">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_real_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_real_qty:hint')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___notinset">
        <label ref="jr:itext('/data/Medicine/___notinset:label')"/>
        <select1 ref="/data/Medicine/___notinset/have_receive_notinset_qty">
          <label ref="jr:itext('/data/Medicine/___notinset/have_receive_notinset_qty:label')"/>
          <itemset nodeset="instance('yes_no')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select1>
        <input ref="/data/Medicine/___notinset/notinset_real_qty">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_real_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___notinset/notinset_real_qty:hint')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___InSet">
        <label ref="jr:itext('/data/Medicine/___InSet:label')"/>
        <select1 ref="/data/Medicine/___InSet/have_receive_InSet_qty">
          <label ref="jr:itext('/data/Medicine/___InSet/have_receive_InSet_qty:label')"/>
          <itemset nodeset="instance('yes_no')/root/item">
            <value ref="name"/>
            <label ref="jr:itext(itextId)"/>
          </itemset>
        </select1>
        <input ref="/data/Medicine/___InSet/InSet_real_qty">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_real_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___InSet/InSet_real_qty:hint')"/>
        </input>
      </group>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/Medicine_summary" appearance="h1 blue">
        <label ref="jr:itext('/data/summary/Medicine_summary:label')"/>
      </input>
      <input ref="/data/summary/metformin_500mg_summary_yes" appearance="li">
        <label ref="jr:itext('/data/summary/metformin_500mg_summary_yes:label')"/>
      </input>
      <input ref="/data/summary/notinset_summary_yes" appearance="li">
        <label ref="jr:itext('/data/summary/notinset_summary_yes:label')"/>
      </input>
      <input ref="/data/summary/InSet_summary_yes" appearance="li">
        <label ref="jr:itext('/data/summary/InSet_summary_yes:label')"/>
      </input>
      <input ref="/data/summary/metformin_500mg_summary_no" appearance="li">
        <label ref="jr:itext('/data/summary/metformin_500mg_summary_no:label')"/>
      </input>
      <input ref="/data/summary/notinset_summary_no" appearance="li">
        <label ref="jr:itext('/data/summary/notinset_summary_no:label')"/>
      </input>
      <input ref="/data/summary/InSet_summary_no" appearance="li">
        <label ref="jr:itext('/data/summary/InSet_summary_no:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out"/>
  </h:body>
</h:html>