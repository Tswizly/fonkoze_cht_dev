      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/contact_type" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/metformin_500mg_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_metformin_500mg_qty"/>
      <bind nodeset="/data/notinset_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_notinset_qty"/>
      <bind nodeset="/data/InSet_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_InSet_qty"/>
      <bind nodeset="/data/select_categories/categories" type="string" required="true()"/>
      <bind nodeset="/data/Medicine" relevant="selected( /data/select_categories/categories , 'Medicine')"/>
      <bind nodeset="/data/Medicine/Medicine_items_selected" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___metformin_500mg" relevant="selected( /data/Medicine/Medicine_items_selected , 'metformin_500mg')"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_before" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___current___set" type="string" calculate="int( /data/metformin_500mg_current  div 100)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___current___unit" type="string" calculate=" /data/metformin_500mg_current  mod 100"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___set" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___unit" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_order_qty" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___after___set" type="string" calculate="int( /data/Medicine/___metformin_500mg/metformin_500mg_after  div 100)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___after___unit" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg_after  mod 100"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_after_note" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___count" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___set  * 100 +  /data/Medicine/___metformin_500mg/metformin_500mg___unit "/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg_after" type="string" calculate=" /data/metformin_500mg_current  + if( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty  != '', /data/Medicine/___metformin_500mg/metformin_500mg___count ,0)"/>
      <bind nodeset="/data/Medicine/___notinset" relevant="selected( /data/Medicine/Medicine_items_selected , 'notinset')"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_before" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_order_qty" type="int" required="true()" constraint=". &gt; 0"/>
      <bind nodeset="/data/Medicine/___notinset/notinset_after_note" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___notinset/notinset___count" type="string" calculate=" /data/Medicine/___notinset/notinset_order_qty "/>
      <bind nodeset="/data/Medicine/___notinset/notinset_after" type="string" calculate=" /data/notinset_current  + if( /data/Medicine/___notinset/notinset_order_qty  != '', /data/Medicine/___notinset/notinset___count ,0)"/>
      <bind nodeset="/data/Medicine/___InSet" relevant="selected( /data/Medicine/Medicine_items_selected , 'InSet')"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_before" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___current___set" type="string" calculate="int( /data/InSet_current  div 10)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___current___unit" type="string" calculate=" /data/InSet_current  mod 10"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___set" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_order_qty ) &gt; 0 and count-selected(substring-before( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___unit" type="string" calculate="if(count-selected( /data/Medicine/___InSet/InSet_order_qty ) &gt; 0 and count-selected(substring-after( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___InSet/InSet_order_qty , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_order_qty" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___after___set" type="string" calculate="int( /data/Medicine/___InSet/InSet_after  div 10)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___after___unit" type="string" calculate=" /data/Medicine/___InSet/InSet_after  mod 10"/>
      <bind nodeset="/data/Medicine/___InSet/InSet_after_note" readonly="true()" type="string"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___count" type="string" calculate=" /data/Medicine/___InSet/InSet___set  * 10 +  /data/Medicine/___InSet/InSet___unit "/>
      <bind nodeset="/data/Medicine/___InSet/InSet_after" type="string" calculate=" /data/InSet_current  + if( /data/Medicine/___InSet/InSet_order_qty  != '', /data/Medicine/___InSet/InSet___count ,0)"/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/Medicine_summary" readonly="true()" type="string" relevant="selected( /data/select_categories/categories , 'Medicine')"/>
      <bind nodeset="/data/summary/metformin_500mg_summary" readonly="true()" type="string" relevant="selected( /data/Medicine/Medicine_items_selected , 'metformin_500mg')"/>
      <bind nodeset="/data/summary/notinset_summary" readonly="true()" type="string" relevant="selected( /data/Medicine/Medicine_items_selected , 'notinset')"/>
      <bind nodeset="/data/summary/InSet_summary" readonly="true()" type="string" relevant="selected( /data/Medicine/Medicine_items_selected , 'InSet')"/>
      <bind nodeset="/data/out/metformin_500mg_ordered" type="string" calculate="if( /data/Medicine/___metformin_500mg/metformin_500mg_order_qty  != '', /data/Medicine/___metformin_500mg/metformin_500mg___count ,0)"/>
      <bind nodeset="/data/out/notinset_ordered" type="string" calculate="if( /data/Medicine/___notinset/notinset_order_qty  != '', /data/Medicine/___notinset/notinset___count ,0)"/>
      <bind nodeset="/data/out/InSet_ordered" type="string" calculate="if( /data/Medicine/___InSet/InSet_order_qty  != '', /data/Medicine/___InSet/InSet___count ,0)"/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
      </group>
    </group>
    <group appearance="field-list" ref="/data/select_categories">
      <label ref="jr:itext('/data/select_categories:label')"/>
      <select ref="/data/select_categories/categories">
        <label ref="jr:itext('/data/select_categories/categories:label')"/>
        <itemset nodeset="instance('categories')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <select ref="/data/Medicine/Medicine_items_selected">
        <label ref="jr:itext('/data/Medicine/Medicine_items_selected:label')"/>
        <itemset nodeset="instance('items')/root/item[category_filter = 'Medicine']">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <group ref="/data/Medicine/___metformin_500mg">
        <label ref="jr:itext('/data/Medicine/___metformin_500mg:label')"/>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_before">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_before:label')"/>
        </input>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_order_qty">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_order_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_order_qty:hint')"/>
        </input>
        <input ref="/data/Medicine/___metformin_500mg/metformin_500mg_after_note">
          <label ref="jr:itext('/data/Medicine/___metformin_500mg/metformin_500mg_after_note:label')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___notinset">
        <label ref="jr:itext('/data/Medicine/___notinset:label')"/>
        <input ref="/data/Medicine/___notinset/notinset_before">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_before:label')"/>
        </input>
        <input ref="/data/Medicine/___notinset/notinset_order_qty">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_order_qty:label')"/>
        </input>
        <input ref="/data/Medicine/___notinset/notinset_after_note">
          <label ref="jr:itext('/data/Medicine/___notinset/notinset_after_note:label')"/>
        </input>
      </group>
      <group ref="/data/Medicine/___InSet">
        <label ref="jr:itext('/data/Medicine/___InSet:label')"/>
        <input ref="/data/Medicine/___InSet/InSet_before">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_before:label')"/>
        </input>
        <input ref="/data/Medicine/___InSet/InSet_order_qty">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_order_qty:label')"/>
          <hint ref="jr:itext('/data/Medicine/___InSet/InSet_order_qty:hint')"/>
        </input>
        <input ref="/data/Medicine/___InSet/InSet_after_note">
          <label ref="jr:itext('/data/Medicine/___InSet/InSet_after_note:label')"/>
        </input>
      </group>
    </group>
    <group appearance="field-list summary" ref="/data/summary">
      <label ref="jr:itext('/data/summary:label')"/>
      <input ref="/data/summary/s_submit">
        <label ref="jr:itext('/data/summary/s_submit:label')"/>
      </input>
      <input ref="/data/summary/r_summary" appearance="h1 yellow">
        <label ref="jr:itext('/data/summary/r_summary:label')"/>
      </input>
      <input ref="/data/summary/Medicine_summary" appearance="h1 blue">
        <label ref="jr:itext('/data/summary/Medicine_summary:label')"/>
      </input>
      <input ref="/data/summary/metformin_500mg_summary" appearance="li">
        <label ref="jr:itext('/data/summary/metformin_500mg_summary:label')"/>
      </input>
      <input ref="/data/summary/notinset_summary" appearance="li">
        <label ref="jr:itext('/data/summary/notinset_summary:label')"/>
      </input>
      <input ref="/data/summary/InSet_summary" appearance="li">
        <label ref="jr:itext('/data/summary/InSet_summary:label')"/>
      </input>
    </group>
    <group appearance="hidden" ref="/data/out"/>
  </h:body>
</h:html>