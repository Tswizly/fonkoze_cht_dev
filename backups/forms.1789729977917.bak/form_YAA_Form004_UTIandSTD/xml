      <bind nodeset="/data/prescription_summary/fields/trimetoprim_sulfate_400_80mg_used_in_YAA_Form004_UTIandSTD" type="string" calculate=" /data/prescription_summary/fields/trimetoprim_sulfate_400_80mg___set  * X +  /data/prescription_summary/fields/trimetoprim_sulfate_400_80mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/furosemide_iv_20mg_used_in_YAA_Form004_UTIandSTD" type="string" calculate=" /data/actions_confirmation/furosemide_iv_20mg "/>
      <bind nodeset="/data/prescription_summary/fields/benzatine_penicillin_2_4_mio_units_used_in_YAA_Form004_UTIandSTD" type="string" calculate=" /data/actions_confirmation/benzatine_penicillin_2_4_mio_units "/>
      <bind nodeset="/data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in" type="string" calculate=" /data/actions_confirmation/ciprofloxacine_500mg_tablets "/>
      <bind nodeset="/data/prescription_summary/fields/ciprofloxacine_500mg_tablets___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/ciprofloxacine_500mg_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/ciprofloxacine_500mg_tablets_used_in_YAA_Form004_UTIandSTD" type="string" calculate=" /data/prescription_summary/fields/ciprofloxacine_500mg_tablets___set  * X +  /data/prescription_summary/fields/ciprofloxacine_500mg_tablets___unit "/>
      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets_used_in" type="string" calculate=" /data/actions_confirmation/doxycicline_100mg_tablets "/>
      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets_used_in_YAA_Form004_UTIandSTD" type="string" calculate=" /data/prescription_summary/fields/doxycicline_100mg_tablets___set  * X +  /data/prescription_summary/fields/doxycicline_100mg_tablets___unit "/>
