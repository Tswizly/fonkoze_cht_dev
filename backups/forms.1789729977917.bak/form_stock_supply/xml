      <instance>
        <data id="stock_supply" version="now()" prefix="J1!stock_supply!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
            </user>
            <contact>
              <_id/>
              <name/>
              <parent>
                <_id/>
              </parent>
            </contact>
          </inputs>
          <place_id/>
          <metformin_500mg_current/>
          <notinset_current/>
          <InSet_current/>
          <supply_place_id/>
          <user_contact_id/>
          <select_items>
            <categories/>
          </select_items>
          <Medicine>
            <Medicine_items_selected/>
            <___metformin_500mg>
              <metformin_500mg___set>0/0</metformin_500mg___set>
              <metformin_500mg___unit>0/0</metformin_500mg___unit>
              <supply_metformin_500mg>0/0</supply_metformin_500mg>
              <metformin_500mg___count/>
            </___metformin_500mg>
            <___notinset>
              <supply_notinset>0</supply_notinset>
              <notinset___count/>
            </___notinset>
            <___InSet>
              <InSet___set>0/0</InSet___set>
              <InSet___unit>0/0</InSet___unit>
              <supply_InSet>0/0</supply_InSet>
              <InSet___count/>
            </___InSet>
          </Medicine>
          <summary>
            <s_submit/>
            <r_summary/>
            <s_metformin_500mg/>
            <s_notinset/>
            <s_InSet/>
          </summary>
          <out>
            <metformin_500mg_supply/>
            <notinset_supply/>
            <InSet_supply/>
          </out>
          <needs_signoff/>
          <stock_supply_doc db-doc="true">
            <form/>
            <type/>
            <created_from db-doc-ref="/data"/>
            <content_type/>
            <contact>
              <_id/>
            </contact>
            <fields>
              <supplier_id/>
              <place_id/>
              <need_confirmation/>
              <metformin_500mg_in/>
              <notinset_in/>
              <InSet_in/>
            </fields>
          </stock_supply_doc>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="categories">
        <root>
          <item>
            <itextId>categories-0</itextId>
            <name>Medicine</name>
          </item>
        </root>
      </instance>
      <instance id="items">
        <root>
          <item>
            <itextId>items-0</itextId>
            <name>metformin_500mg</name>
            <category_filter>Medicine</category_filter>
          </item>
          <item>
            <itextId>items-1</itextId>
            <name>notinset</name>
            <category_filter>Medicine</category_filter>
          </item>
          <item>
            <itextId>items-2</itextId>
            <name>InSet</name>
            <category_filter>Medicine</category_filter>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source='user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person" required="true()"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/place_id" type="string" calculate="../inputs/contact/parent/_id"/>
      <bind nodeset="/data/metformin_500mg_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_metformin_500mg_qty"/>
      <bind nodeset="/data/notinset_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_notinset_qty"/>
      <bind nodeset="/data/InSet_current" type="string" calculate="instance('contact-summary')/context/stock_monitoring_InSet_qty"/>
      <bind nodeset="/data/supply_place_id" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/user_contact_id" type="string" calculate="../inputs/user/contact_id"/>
      <bind nodeset="/data/select_items/categories" type="string"/>
      <bind nodeset="/data/Medicine" relevant="selected( /data/select_items/categories , 'Medicine')"/>
      <bind nodeset="/data/Medicine/Medicine_items_selected" type="string" required="true()"/>
      <bind nodeset="/data/Medicine/___metformin_500mg" relevant="selected( /data/Medicine/Medicine_items_selected , 'metformin_500mg')"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___set" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/supply_metformin_500mg ) &gt; 0 and count-selected(substring-before( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___unit" type="string" calculate="if(count-selected( /data/Medicine/___metformin_500mg/supply_metformin_500mg ) &gt; 0 and count-selected(substring-after( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___metformin_500mg/supply_metformin_500mg , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/supply_metformin_500mg" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x boîte de 100 and y comprimé"/>
      <bind nodeset="/data/Medicine/___metformin_500mg/metformin_500mg___count" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___set  * 100 +  /data/Medicine/___metformin_500mg/metformin_500mg___unit "/>
      <bind nodeset="/data/Medicine/___notinset" relevant="selected( /data/Medicine/Medicine_items_selected , 'notinset')"/>
      <bind nodeset="/data/Medicine/___notinset/supply_notinset" type="int" required="true()"/>
      <bind nodeset="/data/Medicine/___notinset/notinset___count" type="string" calculate=" /data/Medicine/___notinset/supply_notinset "/>
      <bind nodeset="/data/Medicine/___InSet" relevant="selected( /data/Medicine/Medicine_items_selected , 'InSet')"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___set" type="string" calculate="if(count-selected( /data/Medicine/___InSet/supply_InSet ) &gt; 0 and count-selected(substring-before( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___unit" type="string" calculate="if(count-selected( /data/Medicine/___InSet/supply_InSet ) &gt; 0 and count-selected(substring-after( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/Medicine/___InSet/supply_InSet , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/Medicine/___InSet/supply_InSet" type="string" required="true()" constraint="regex(., '^\d+\/\d+$')" jr:constraintMsg="Should be in the form x/y for x box of and y tablet"/>
      <bind nodeset="/data/Medicine/___InSet/InSet___count" type="string" calculate=" /data/Medicine/___InSet/InSet___set  * 10 +  /data/Medicine/___InSet/InSet___unit "/>
      <bind nodeset="/data/summary/s_submit" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/r_summary" readonly="true()" type="string"/>
      <bind nodeset="/data/summary/s_metformin_500mg" readonly="true()" type="string" relevant=" /data/Medicine/___metformin_500mg/metformin_500mg___count  &gt; 0"/>
      <bind nodeset="/data/summary/s_notinset" readonly="true()" type="string" relevant=" /data/Medicine/___notinset/notinset___count  &gt; 0"/>
      <bind nodeset="/data/summary/s_InSet" readonly="true()" type="string" relevant=" /data/Medicine/___InSet/InSet___count  &gt; 0"/>
      <bind nodeset="/data/out/metformin_500mg_supply" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___count "/>
      <bind nodeset="/data/out/notinset_supply" type="string" calculate=" /data/Medicine/___notinset/notinset___count "/>
      <bind nodeset="/data/out/InSet_supply" type="string" calculate=" /data/Medicine/___InSet/InSet___count "/>
      <bind nodeset="/data/needs_signoff" type="string" calculate="true()"/>
      <bind nodeset="/data/stock_supply_doc/form" type="string" calculate="&quot;stock_supply_doc&quot;"/>
      <bind nodeset="/data/stock_supply_doc/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/stock_supply_doc/created_from" type="string" calculate="."/>
      <bind nodeset="/data/stock_supply_doc/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/stock_supply_doc/contact/_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/supplier_id" type="string" calculate=" /data/user_contact_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/place_id" type="string" calculate=" /data/supply_place_id "/>
      <bind nodeset="/data/stock_supply_doc/fields/need_confirmation" type="string" calculate="&quot;yes&quot;"/>
      <bind nodeset="/data/stock_supply_doc/fields/metformin_500mg_in" type="string" calculate=" /data/Medicine/___metformin_500mg/metformin_500mg___count "/>
      <bind nodeset="/data/stock_supply_doc/fields/notinset_in" type="string" calculate=" /data/Medicine/___notinset/notinset___count "/>
      <bind nodeset="/data/stock_supply_doc/fields/InSet_in" type="string" calculate=" /data/Medicine/___InSet/InSet___count "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label ref="jr:itext('/data/inputs:label')"/>
      <input ref="/data/inputs/source" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source:label')"/>
      </input>
      <input ref="/data/inputs/source_id" appearance="hidden">
        <label ref="jr:itext('/data/inputs/source_id:label')"/>
      </input>
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id" appearance="db-object"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object"/>
        <input ref="/data/inputs/contact/name" appearance="hidden"/>
        <group appearance="hidden" ref="/data/inputs/contact/parent">
          <input ref="/data/inputs/contact/parent/_id"/>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/select_items">
      <label ref="jr:itext('/data/select_items:label')"/>
      <select ref="/data/select_items/categories">
        <label ref="jr:itext('/data/select_items/categories:label')"/>
        <itemset nodeset="instance('categories')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/Medicine">
      <label ref="jr:itext('/data/Medicine:label')"/>
      <select ref="/data/Medicine/Medicine_items_selected">
        <label ref="jr:itext('/data/Medicine/Medicine_items_selected:label')"/>
        <itemset nodeset="instance('items')/root/item[category_filter = 'Medicine']">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <group ref="/data/Medicine/___metformin_500mg">
