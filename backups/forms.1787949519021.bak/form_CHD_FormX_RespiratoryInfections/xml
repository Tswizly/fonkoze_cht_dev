<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Child Respiratory Infections</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="CHD_FormX_RespiratoryInfections" version="20260827123728" prefix="J1!CHD_FormX_RespiratoryInfections!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <client_uuid/>
          <client_id/>
          <client_name/>
          <client_short_name/>
          <client_sex/>
          <client_date_of_birth/>
          <client_age_in_years/>
          <client_age_in_months/>
          <client_age_in_days/>
          <client_age_in_weeks/>
          <respiratory_checkup_group>
            <respiratory_danger_signs/>
            <fever_presence/>
            <child_temperature/>
            <fever_duration/>
            <extended_fever_duration/>
            <child_coughing/>
            <cough_duration/>
            <breathing_rate/>
            <oxygen_saturation/>
            <cough_danger_signs/>
            <after_nebulising_breathing/>
            <after_nebulising_chest_indrawing/>
            <runny_nose/>
            <poor_appetite/>
            <sore_throat/>
            <throat_appearance/>
          </respiratory_checkup_group>
          <results_group>
            <calc_severe_pneumonia/>
            <calc_pneumonia/>
            <calc_tonsillitis/>
            <calc_cough_or_cold/>
            <res_severe_pneumonia/>
            <res_severe_pneumonia_action/>
            <res_pneumonia/>
            <res_pneumonia_action/>
            <res_cough_or_cold/>
            <res_cough_or_cold_action/>
            <res_tonsillitis/>
            <res_tonsillitis_action/>
          </results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="respiratory_danger_signs">
        <root>
          <item>
            <name>feeding_difficulty</name>
            <label>The child is unable to drink or breastfeed</label>
          </item>
          <item>
            <name>vomiting</name>
            <label>The child vomits everything</label>
          </item>
          <item>
            <name>convulsions</name>
            <label>The child has had convulsions or is actively convulsing now</label>
          </item>
          <item>
            <name>lethargy_unconscious</name>
            <label>The child is lethargic or unconscious</label>
          </item>
        </root>
      </instance>
      <instance id="cough_danger_signs">
        <root>
          <item>
            <name>chest_indrawing</name>
            <label>Chest indrawing</label>
          </item>
          <item>
            <name>stridor</name>
            <label>Stridor</label>
          </item>
          <item>
            <name>wheezing</name>
            <label>Wheezing</label>
          </item>
          <item>
            <name>nasal_flaring</name>
            <label>Nasal flaring</label>
          </item>
          <item>
            <name>fast_breathing</name>
            <label>Fast breathing</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/client_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/client_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/client_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/client_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/client_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/client_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/client_age_in_years" type="string" calculate="floor( difference-in-months(  /data/client_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/client_age_in_months" type="string" calculate="difference-in-months(  /data/client_date_of_birth , today() )"/>
      <bind nodeset="/data/client_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/client_date_of_birth ) )"/>
      <bind nodeset="/data/client_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/client_date_of_birth )) div 7)"/>
      <bind nodeset="/data/respiratory_checkup_group/respiratory_danger_signs" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/fever_presence" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/child_temperature" type="decimal" relevant=" /data/respiratory_checkup_group/fever_presence  = 'yes'" constraint=". &gt;= 90 and . &lt;= 110" jr:constraintMsg="Cannot be below 90, cannot exceed 110"/>
      <bind nodeset="/data/respiratory_checkup_group/fever_duration" type="int" relevant=" /data/respiratory_checkup_group/fever_presence  = 'yes'" constraint=". &lt;= 99" jr:constraintMsg="Cannot exceed 99 days"/>
      <bind nodeset="/data/respiratory_checkup_group/extended_fever_duration" type="string" relevant=" /data/respiratory_checkup_group/fever_presence  = 'yes' and  /data/respiratory_checkup_group/fever_duration  &gt;= 7"/>
      <bind nodeset="/data/respiratory_checkup_group/child_coughing" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/cough_duration" type="int" relevant=" /data/respiratory_checkup_group/child_coughing  = 'yes'" constraint=". &lt;= 99" jr:constraintMsg="Cannot exceed 99 days"/>
      <bind nodeset="/data/respiratory_checkup_group/breathing_rate" type="int" relevant=" /data/respiratory_checkup_group/child_coughing  = 'yes'" constraint=". &lt;= 999" jr:constraintMsg="Cannot exceed 999"/>
      <bind nodeset="/data/respiratory_checkup_group/oxygen_saturation" type="decimal" relevant=" /data/respiratory_checkup_group/child_coughing  = 'yes'" constraint=". &lt;= 100" jr:constraintMsg="Cannot exceed 100"/>
      <bind nodeset="/data/respiratory_checkup_group/cough_danger_signs" type="string" relevant=" /data/respiratory_checkup_group/child_coughing  = 'yes'"/>
      <bind nodeset="/data/respiratory_checkup_group/after_nebulising_breathing" type="string" relevant="selected( /data/respiratory_checkup_group/cough_danger_signs , 'wheezing')"/>
      <bind nodeset="/data/respiratory_checkup_group/after_nebulising_chest_indrawing" type="string" relevant="selected( /data/respiratory_checkup_group/cough_danger_signs , 'wheezing')"/>
      <bind nodeset="/data/respiratory_checkup_group/runny_nose" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/poor_appetite" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/sore_throat" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_checkup_group/throat_appearance" type="string" required="true()"/>
      <bind nodeset="/data/results_group/calc_severe_pneumonia" type="string" calculate="if(count-selected( /data/respiratory_checkup_group/respiratory_danger_signs ) &gt; 0 or selected( /data/respiratory_checkup_group/cough_danger_signs , 'stridor') or  /data/respiratory_checkup_group/oxygen_saturation  &lt; 90, 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_pneumonia" type="string" calculate="if( /data/results_group/calc_severe_pneumonia  != 'true' and (selected( /data/respiratory_checkup_group/cough_danger_signs , 'chest_indrawing') or selected( /data/respiratory_checkup_group/cough_danger_signs , 'fast_breathing') or selected( /data/respiratory_checkup_group/cough_danger_signs , 'nasal_flaring')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_tonsillitis" type="string" calculate="if( /data/results_group/calc_severe_pneumonia  != 'true' and  /data/results_group/calc_pneumonia  != 'true' and  /data/respiratory_checkup_group/fever_presence  = 'yes' and  /data/respiratory_checkup_group/sore_throat  = 'yes' and  /data/respiratory_checkup_group/poor_appetite  = 'yes' and  /data/respiratory_checkup_group/throat_appearance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_cough_or_cold" type="string" calculate="if( /data/results_group/calc_severe_pneumonia  != 'true' and  /data/results_group/calc_pneumonia  != 'true' and  /data/results_group/calc_tonsillitis  != 'true' and ( /data/respiratory_checkup_group/child_coughing  = 'yes' or  /data/respiratory_checkup_group/runny_nose  = 'yes' or  /data/respiratory_checkup_group/sore_throat  = 'yes'), 'true', 'false')"/>
      <bind nodeset="/data/results_group/res_severe_pneumonia" readonly="true()" type="string" relevant=" /data/results_group/calc_severe_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_pneumonia_action" readonly="true()" type="string" relevant=" /data/results_group/calc_severe_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_action" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_cough_or_cold" readonly="true()" type="string" relevant=" /data/results_group/calc_cough_or_cold  = 'true'"/>
      <bind nodeset="/data/results_group/res_cough_or_cold_action" readonly="true()" type="string" relevant=" /data/results_group/calc_cough_or_cold  = 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis" readonly="true()" type="string" relevant=" /data/results_group/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis_action" readonly="true()" type="string" relevant=" /data/results_group/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_checkup_group">
      <label>Respiratory Checkup</label>
      <select ref="/data/respiratory_checkup_group/respiratory_danger_signs">
        <label>Does the child exhibit any of the following danger signs?</label>
        <itemset nodeset="instance('respiratory_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/respiratory_checkup_group/fever_presence">
        <label>Does the child have a fever?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_checkup_group/child_temperature">
        <label>The temperature of the child.</label>
      </input>
      <input ref="/data/respiratory_checkup_group/fever_duration">
        <label>How long has the child had a fever?</label>
      </input>
      <select1 ref="/data/respiratory_checkup_group/extended_fever_duration">
        <label>If the child has had a fever longer than 7 days, has the fever been present every day?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/child_coughing">
        <label>Is the child coughing or having difficulty breathing?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_checkup_group/cough_duration">
        <label>How long as the child been coughing, in days?</label>
      </input>
      <input ref="/data/respiratory_checkup_group/breathing_rate">
        <label>Count the number of breaths for one minute. Pulse oximeter may be used.</label>
        <hint>Child must be calm.</hint>
      </input>
      <input ref="/data/respiratory_checkup_group/oxygen_saturation">
        <label>Using the pulse oximeter, determin the child's oxygen saturation.</label>
      </input>
      <select ref="/data/respiratory_checkup_group/cough_danger_signs">
        <label>Which of the following coughing danger signs does the child exhibit, if any?</label>
        <hint>Look, listen and feel for chest indrawing, stridor, wheezing, and nasal flaring. Child must be calm.</hint>
        <itemset nodeset="instance('cough_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/respiratory_checkup_group/after_nebulising_breathing">
        <label>After nebulising, does the child still exhibit fast breathing?</label>
        <hint>If child is wheezing with fast breathing or chest indrawing, nurse will nebulizer then reperform breath count and look for chest indrawing, then classify.</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/after_nebulising_chest_indrawing">
        <label>After nebulising, does the child still exhibit chest indrawing?</label>
        <hint>If child is wheezing with fast breathing or chest indrawing, nurse will nebulizer then reperform breath count and look for chest indrawing, then classify.</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/runny_nose">
        <label>Does the child have a runny nose?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/poor_appetite">
        <label>Does the child have a poor appetite?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/sore_throat">
        <label>Does the child have a sore throat?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_checkup_group/throat_appearance">
        <label>Does the throat appear red, swollen, or covered in pus upon inspection?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_severe_pneumonia" appearance="h1 red">
        <label>SEVERE PNEUMONIA or VERY SEVERE DISEASE</label>
      </input>
      <input ref="/data/results_group/res_severe_pneumonia_action">
        <label>Give first dose of an appropriate antibiotic. Acetaminophen. Refer URGENTLY to the hospital. Strict referral: warn parent that if they don't go they'll lose the child</label>
      </input>
      <input ref="/data/results_group/res_pneumonia" appearance="h1 yellow">
        <label>PNEUMONIA</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_action">
        <label>Give oral Amoxicillin oral suspension for 5 days. If wheezing: Nebulization. Advise mother to go to hospital if fever doesn't go down.</label>
      </input>
      <input ref="/data/results_group/res_cough_or_cold" appearance="h1 green">
        <label>COUGH OR COLD</label>
      </input>
      <input ref="/data/results_group/res_cough_or_cold_action">
        <label>If wheezing: nebulizer. Prescribe a syringe and saline solution to clear out nose.</label>
      </input>
      <input ref="/data/results_group/res_tonsillitis" appearance="h1 yellow">
        <label>TONSILLITIS</label>
      </input>
      <input ref="/data/results_group/res_tonsillitis_action">
        <label>Acetaminophen sirup. Give oral Amoxicillin oral suspension for 5 days. Nurse will call in 7 days to find out how child is doing.</label>
      </input>
    </group>
  </h:body>
</h:html>