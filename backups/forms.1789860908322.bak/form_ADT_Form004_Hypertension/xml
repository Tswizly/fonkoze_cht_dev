      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;ADT_Form004_Hypertension&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_10mg_used_in" type="string" calculate=" /data/actions_confirmation/nifedipine_10mg "/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_10mg___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/nifedipine_10mg_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_10mg___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/nifedipine_10mg_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/nifedipine_10mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_10mg_used_in_ADT_Form004_Hypertension" type="string" calculate=" /data/prescription_summary/fields/nifedipine_10mg___set  * X +  /data/prescription_summary/fields/nifedipine_10mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in" type="string" calculate=" /data/actions_confirmation/hydrochlorotiazide_25mg "/>
      <bind nodeset="/data/prescription_summary/fields/hydrochlorotiazide_25mg___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/hydrochlorotiazide_25mg___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/hydrochlorotiazide_25mg_used_in_ADT_Form004_Hypertension" type="string" calculate=" /data/prescription_summary/fields/hydrochlorotiazide_25mg___set  * X +  /data/prescription_summary/fields/hydrochlorotiazide_25mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/enalapril_10mg_used_in" type="string" calculate=" /data/actions_confirmation/enalapril_10mg "/>
      <bind nodeset="/data/prescription_summary/fields/enalapril_10mg___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/enalapril_10mg_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/enalapril_10mg___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/enalapril_10mg_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/enalapril_10mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/enalapril_10mg_used_in_ADT_Form004_Hypertension" type="string" calculate=" /data/prescription_summary/fields/enalapril_10mg___set  * X +  /data/prescription_summary/fields/enalapril_10mg___unit "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/form_purpose_group">
      <label ref="jr:itext('/data/form_purpose_group:label')"/>
      <input ref="/data/form_purpose_group/optional_note">
        <label ref="jr:itext('/data/form_purpose_group/optional_note:label')"/>
      </input>
      <select1 ref="/data/form_purpose_group/form_purpose">
        <label ref="jr:itext('/data/form_purpose_group/form_purpose:label')"/>
        <itemset nodeset="instance('Form_purpose')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/hypertension_assessment_group">
      <label ref="jr:itext('/data/hypertension_assessment_group:label')"/>
      <select ref="/data/hypertension_assessment_group/danger_signs">
        <label ref="jr:itext('/data/hypertension_assessment_group/danger_signs:label')"/>
        <itemset nodeset="instance('danger_signs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/hypertension_assessment_group/bp_systolic">
        <label ref="jr:itext('/data/hypertension_assessment_group/bp_systolic:label')"/>
      </input>
      <input ref="/data/hypertension_assessment_group/bp_diastolic">
        <label ref="jr:itext('/data/hypertension_assessment_group/bp_diastolic:label')"/>
      </input>
      <input ref="/data/hypertension_assessment_group/bp_systolic_remeasure">
        <label ref="jr:itext('/data/hypertension_assessment_group/bp_systolic_remeasure:label')"/>
      </input>
      <input ref="/data/hypertension_assessment_group/bp_diastolic_remeasure">
        <label ref="jr:itext('/data/hypertension_assessment_group/bp_diastolic_remeasure:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_hypertensive_urgency" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_hypertensive_urgency:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertensive_urgency_action">
        <label ref="jr:itext('/data/results_group/res_hypertensive_urgency_action:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_1" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_1:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_1_action">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_1_action:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_2" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_2:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_2_action">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_2_action:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_3" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_3:label')"/>
      </input>
      <input ref="/data/results_group/res_hypertension_grade_3_action">
        <label ref="jr:itext('/data/results_group/res_hypertension_grade_3_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select ref="/data/actions_confirmation/followed_up_conditions">
        <label ref="jr:itext('/data/actions_confirmation/followed_up_conditions:label')"/>
        <itemset nodeset="instance('followed_up_conditions')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/actions_confirmation/referal">
        <label ref="jr:itext('/data/actions_confirmation/referal:label')"/>
        <itemset nodeset="instance('referal_locations')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/nifedipine_10mg">
        <label ref="jr:itext('/data/actions_confirmation/nifedipine_10mg:label')"/>
      </input>
      <input ref="/data/actions_confirmation/hydrochlorotiazide_25mg">
        <label ref="jr:itext('/data/actions_confirmation/hydrochlorotiazide_25mg:label')"/>
      </input>
      <input ref="/data/actions_confirmation/enalapril_10mg">
        <label ref="jr:itext('/data/actions_confirmation/enalapril_10mg:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>