            <itextId>yes_no-1</itextId>
            <name>no</name>
          </item>
        </root>
      </instance>
      <instance id="stroke_danger_signs">
        <root>
          <item>
            <itextId>stroke_danger_signs-0</itextId>
            <name>loss_of_motricity</name>
          </item>
          <item>
            <itextId>stroke_danger_signs-1</itextId>
            <name>facial_paralysis</name>
          </item>
          <item>
            <itextId>stroke_danger_signs-2</itextId>
            <name>altered_consciousness</name>
          </item>
          <item>
            <itextId>stroke_danger_signs-3</itextId>
            <name>vertigo</name>
          </item>
          <item>
            <itextId>stroke_danger_signs-4</itextId>
            <name>altered_speech</name>
          </item>
        </root>
      </instance>
      <instance id="followed_up_conditions">
        <root>
          <item>
            <itextId>followed_up_conditions-0</itextId>
            <name>transient_ischemic_attack</name>
          </item>
          <item>
            <itextId>followed_up_conditions-1</itextId>
            <name>stroke</name>
          </item>
          <item>
            <itextId>followed_up_conditions-2</itextId>
            <name>old_stroke</name>
          </item>
        </root>
      </instance>
      <instance id="referal_locations">
        <root>
          <item>
            <itextId>referal_locations-0</itextId>
            <name>zl</name>
          </item>
          <item>
            <itextId>referal_locations-1</itextId>
            <name>hst</name>
          </item>
          <item>
            <itextId>referal_locations-2</itextId>
            <name>ham</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/stroke_assessment_group/stroke_danger_signs" type="string"/>
      <bind nodeset="/data/stroke_assessment_group/symptom_duration" type="int" required="true()" relevant="count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/hypertensive" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/hypertension_treatment" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/seen_clinician_previously" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/bp_systolic_first" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_diastolic_first" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_remeasure" type="string"/>
      <bind nodeset="/data/stroke_assessment_group/bp_systolic_remeasure" type="int" relevant=" /data/stroke_assessment_group/bp_remeasure  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_diastolic_remeasure" type="int" relevant=" /data/stroke_assessment_group/bp_remeasure  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/calc_transient_ischemic_attack" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &lt;= 1 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/calc_stroke" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &gt; 1 and  /data/stroke_assessment_group/symptom_duration  &lt;= 7 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/calc_old_stroke" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &gt; 7 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_transient_ischemic_attack  = 'true' or  /data/calc_stroke  = 'true' or  /data/calc_old_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_transient_ischemic_attack" readonly="true()" type="string" relevant=" /data/calc_transient_ischemic_attack  = 'true'"/>
      <bind nodeset="/data/results_group/res_transient_ischemic_attack_action" readonly="true()" type="string" relevant=" /data/calc_transient_ischemic_attack  = 'true'"/>
      <bind nodeset="/data/results_group/res_stroke" readonly="true()" type="string" relevant=" /data/calc_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_stroke_action" readonly="true()" type="string" relevant=" /data/calc_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_old_stroke" readonly="true()" type="string" relevant=" /data/calc_old_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_old_stroke_action" readonly="true()" type="string" relevant=" /data/calc_old_stroke  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_transient_ischemic_attack  = 'false' and  /data/calc_stroke  = 'false' and  /data/calc_old_stroke  = 'false'"/>
      <bind nodeset="/data/null_results_group/res_null" readonly="true()" type="string"/>
      <bind nodeset="/data/actions_confirmation/followed_up_conditions" type="string" required="true()"/>
      <bind nodeset="/data/actions_confirmation/referal" type="string" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'transient_ischemic_attack') or selected( /data/actions_confirmation/followed_up_conditions , 'stroke')"/>
      <bind nodeset="/data/actions_confirmation/counseling_provided" type="string" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'old_stroke')"/>
      <bind nodeset="/data/data/_stroke_danger_signs" type="string" calculate="if( /data/stroke_assessment_group/stroke_danger_signs  != '',  /data/stroke_assessment_group/stroke_danger_signs , 'false')"/>
      <bind nodeset="/data/data/_symptom_duration" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  != '',  /data/stroke_assessment_group/symptom_duration , -1)"/>
      <bind nodeset="/data/data/_hypertensive" type="string" calculate="if( /data/stroke_assessment_group/hypertensive  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_hypertension_treatment" type="string" calculate="if( /data/stroke_assessment_group/hypertension_treatment  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_seen_clinician_previously" type="string" calculate="if( /data/stroke_assessment_group/seen_clinician_previously  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_bp_systolic_first" type="string" calculate="if( /data/stroke_assessment_group/bp_systolic_first  != '',  /data/stroke_assessment_group/bp_systolic_first , -1)"/>
      <bind nodeset="/data/data/_bp_diastolic_first" type="string" calculate="if( /data/stroke_assessment_group/bp_diastolic_first  != '',  /data/stroke_assessment_group/bp_diastolic_first , -1)"/>
      <bind nodeset="/data/data/_bp_remeasure" type="string" calculate="if( /data/stroke_assessment_group/bp_remeasure  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_bp_systolic_remeasure" type="string" calculate="if( /data/stroke_assessment_group/bp_systolic_remeasure  != '',  /data/stroke_assessment_group/bp_systolic_remeasure , -1)"/>
      <bind nodeset="/data/data/_bp_diastolic_remeasure" type="string" calculate="if( /data/stroke_assessment_group/bp_diastolic_remeasure  != '',  /data/stroke_assessment_group/bp_diastolic_remeasure , -1)"/>
      <bind nodeset="/data/data/_result_transient_ischemic_attack" type="string" calculate="if( /data/calc_transient_ischemic_attack ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_stroke" type="string" calculate="if( /data/calc_stroke ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_old_stroke" type="string" calculate="if( /data/calc_old_stroke ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_followed_up_conditions" type="string" calculate="if( /data/actions_confirmation/followed_up_conditions  != '',  /data/actions_confirmation/followed_up_conditions , 'false')"/>
      <bind nodeset="/data/data/_referal" type="string" calculate="if( /data/actions_confirmation/referal  != '',  /data/actions_confirmation/referal , 'false')"/>
      <bind nodeset="/data/data/_counseling_provided" type="string" calculate="if( /data/actions_confirmation/counseling_provided  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;ADT_Form008_Stroke&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/stroke_assessment_group">
      <label ref="jr:itext('/data/stroke_assessment_group:label')"/>
      <select ref="/data/stroke_assessment_group/stroke_danger_signs">
        <label ref="jr:itext('/data/stroke_assessment_group/stroke_danger_signs:label')"/>
        <itemset nodeset="instance('stroke_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/stroke_assessment_group/symptom_duration">
        <label ref="jr:itext('/data/stroke_assessment_group/symptom_duration:label')"/>
      </input>
      <select1 ref="/data/stroke_assessment_group/hypertensive">
        <label ref="jr:itext('/data/stroke_assessment_group/hypertensive:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/stroke_assessment_group/hypertension_treatment">
        <label ref="jr:itext('/data/stroke_assessment_group/hypertension_treatment:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/stroke_assessment_group/seen_clinician_previously">
        <label ref="jr:itext('/data/stroke_assessment_group/seen_clinician_previously:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/stroke_assessment_group/bp_systolic_first">
        <label ref="jr:itext('/data/stroke_assessment_group/bp_systolic_first:label')"/>
      </input>
      <input ref="/data/stroke_assessment_group/bp_diastolic_first">
        <label ref="jr:itext('/data/stroke_assessment_group/bp_diastolic_first:label')"/>
      </input>
      <select1 ref="/data/stroke_assessment_group/bp_remeasure">
        <label ref="jr:itext('/data/stroke_assessment_group/bp_remeasure:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/stroke_assessment_group/bp_systolic_remeasure">
        <label ref="jr:itext('/data/stroke_assessment_group/bp_systolic_remeasure:label')"/>
      </input>
      <input ref="/data/stroke_assessment_group/bp_diastolic_remeasure">
        <label ref="jr:itext('/data/stroke_assessment_group/bp_diastolic_remeasure:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_transient_ischemic_attack" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_transient_ischemic_attack:label')"/>
      </input>
      <input ref="/data/results_group/res_transient_ischemic_attack_action">
        <label ref="jr:itext('/data/results_group/res_transient_ischemic_attack_action:label')"/>
      </input>
      <input ref="/data/results_group/res_stroke" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_stroke:label')"/>
      </input>
      <input ref="/data/results_group/res_stroke_action">
        <label ref="jr:itext('/data/results_group/res_stroke_action:label')"/>
      </input>
      <input ref="/data/results_group/res_old_stroke" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_old_stroke:label')"/>
      </input>
      <input ref="/data/results_group/res_old_stroke_action">
        <label ref="jr:itext('/data/results_group/res_old_stroke_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/res_null" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/res_null:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select ref="/data/actions_confirmation/followed_up_conditions">
        <label ref="jr:itext('/data/actions_confirmation/followed_up_conditions:label')"/>
        <itemset nodeset="instance('followed_up_conditions')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/actions_confirmation/referal">
        <label ref="jr:itext('/data/actions_confirmation/referal:label')"/>
        <itemset nodeset="instance('referal_locations')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/actions_confirmation/counseling_provided">
        <label ref="jr:itext('/data/actions_confirmation/counseling_provided:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>