      <bind nodeset="/data/data/_pregnancy_test_result" type="string" calculate="if( /data/register_pregnancy_group/pregnancy_test_result  != '',  /data/register_pregnancy_group/pregnancy_test_result , 'false')"/>
      <bind nodeset="/data/data/_confirm_pregnancy_duration_menstruation" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_menstruation  != '',  /data/perform_followup_group/confirm_pregnancy_duration_menstruation , 'false')"/>
      <bind nodeset="/data/data/_confirm_pregnancy_duration_approximation" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  != '',  /data/perform_followup_group/confirm_pregnancy_duration_approximation , -1)"/>
      <bind nodeset="/data/data/_bp_systolic" type="string" calculate="if( /data/health_and_symptoms/bp_systolic  != '',  /data/health_and_symptoms/bp_systolic , -1)"/>
      <bind nodeset="/data/data/_bp_diastolic" type="string" calculate="if( /data/health_and_symptoms/bp_diastolic  != '',  /data/health_and_symptoms/bp_diastolic , -1)"/>
      <bind nodeset="/data/data/_concerning_pregnancy_symptoms" type="string" calculate="if( /data/health_and_symptoms/concerning_pregnancy_symptoms  != '',  /data/health_and_symptoms/concerning_pregnancy_symptoms , 'false')"/>
      <bind nodeset="/data/data/_fever" type="string" calculate=" /data/fever "/>
      <bind nodeset="/data/data/_result_gestational_hypertension_no_serious" type="string" calculate="if( /data/calc_gestational_hypertension_no_serious ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_gestational_hypertension_serious" type="string" calculate="if( /data/calc_gestational_hypertension_serious ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_pre_eclampsia" type="string" calculate="if( /data/calc_pre_eclampsia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_genitourinary_infections" type="string" calculate="if( /data/calc_genitourinary_infections ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_threatened_miscarriage_less20" type="string" calculate="if( /data/calc_threatened_miscarriage_less20 ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_threatened_miscarriage_greater20" type="string" calculate="if( /data/calc_threatened_miscarriage_greater20 ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_pregnancy_tests_used" type="string" calculate="if( /data/actions_confirmation/pregnancy_test  = 'yes',1,0)"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;ADT_Form005_Pregnancy&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/pregnancy_test_used_in_ADT_Form005_Pregnancy" type="string" calculate=" /data/data/_pregnancy_tests_used "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/form_purpose_group">
      <label ref="jr:itext('/data/form_purpose_group:label')"/>
      <select1 ref="/data/form_purpose_group/form_purpose">
        <label ref="jr:itext('/data/form_purpose_group/form_purpose:label')"/>
        <itemset nodeset="instance('Form_purpose')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/register_pregnancy_group">
      <label ref="jr:itext('/data/register_pregnancy_group:label')"/>
      <input ref="/data/register_pregnancy_group/register_last_menstruation">
        <label ref="jr:itext('/data/register_pregnancy_group/register_last_menstruation:label')"/>
      </input>
      <select1 ref="/data/register_pregnancy_group/pregnancy_test_result">
        <label ref="jr:itext('/data/register_pregnancy_group/pregnancy_test_result:label')"/>
        <itemset nodeset="instance('pregnancy_test_result')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/register_pregnancy_group/reg_followup_prenatal_clinic">
        <label ref="jr:itext('/data/register_pregnancy_group/reg_followup_prenatal_clinic:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/perform_followup_group">
      <label ref="jr:itext('/data/perform_followup_group:label')"/>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_menstruation">
        <label ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_menstruation:label')"/>
        <hint ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_menstruation:hint')"/>
      </input>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_approximation">
        <label ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_approximation:label')"/>
      </input>
      <select1 ref="/data/perform_followup_group/followup_prenatal_clinic">
        <label ref="jr:itext('/data/perform_followup_group/followup_prenatal_clinic:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/health_and_symptoms">
      <label ref="jr:itext('/data/health_and_symptoms:label')"/>
      <input ref="/data/health_and_symptoms/bp_note">
        <label ref="jr:itext('/data/health_and_symptoms/bp_note:label')"/>
      </input>
      <input ref="/data/health_and_symptoms/bp_systolic">
        <label ref="jr:itext('/data/health_and_symptoms/bp_systolic:label')"/>
        <hint ref="jr:itext('/data/health_and_symptoms/bp_systolic:hint')"/>
      </input>
      <input ref="/data/health_and_symptoms/bp_diastolic">
        <label ref="jr:itext('/data/health_and_symptoms/bp_diastolic:label')"/>
        <hint ref="jr:itext('/data/health_and_symptoms/bp_diastolic:hint')"/>
      </input>
      <input ref="/data/health_and_symptoms/measure_temperature">
        <label ref="jr:itext('/data/health_and_symptoms/measure_temperature:label')"/>
      </input>
      <select ref="/data/health_and_symptoms/concerning_pregnancy_symptoms">
        <label ref="jr:itext('/data/health_and_symptoms/concerning_pregnancy_symptoms:label')"/>
        <itemset nodeset="instance('concerning_pregnancy_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_no_serious:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious_action">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_no_serious_action:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_serious" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_serious:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertesnion_serious_action">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertesnion_serious_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_pre_eclampsia:label')"/>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia_action">
        <label ref="jr:itext('/data/results_group/res_pre_eclampsia_action:label')"/>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_genitourinary_infections:label')"/>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections_action">
        <label ref="jr:itext('/data/results_group/res_genitourinary_infections_action:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_less20:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20_action">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_less20_action:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_greater20:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20_action">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_greater20_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select1 ref="/data/actions_confirmation/pregnancy_test">
        <label ref="jr:itext('/data/actions_confirmation/pregnancy_test:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>