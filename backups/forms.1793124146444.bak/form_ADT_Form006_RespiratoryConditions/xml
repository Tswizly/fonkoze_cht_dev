      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/chronic_asthma" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/respiratory_conditions_group/adult_coughing" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/cough_duration" type="int" relevant=" /data/respiratory_conditions_group/adult_coughing  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/qualify_cough" type="string" relevant=" /data/respiratory_conditions_group/adult_coughing  = 'yes'"/>
      <bind nodeset="/data/respiratory_conditions_group/breathing_rate" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/oxygen_saturation" type="decimal" constraint=". &lt;= 100"/>
      <bind nodeset="/data/respiratory_conditions_group/fever" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/temperature" type="decimal" relevant=" /data/respiratory_conditions_group/fever  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/fever_duration" type="int" relevant=" /data/respiratory_conditions_group/fever  = 'yes'"/>
      <bind nodeset="/data/respiratory_conditions_group/wheezing" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/respiratory_distress" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/weight_loss" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/night_sweats" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/recurring_condition" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/tb_exposure" type="string" required="true()"/>
      <bind nodeset="/data/calc_tuberculosis" type="string" calculate="if( /data/respiratory_conditions_group/cough_duration  &gt; 14 and  /data/respiratory_conditions_group/weight_loss  = 'yes' and  /data/respiratory_conditions_group/night_sweats  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_asthma" type="string" calculate="if( /data/respiratory_conditions_group/wheezing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes' and  /data/respiratory_conditions_group/recurring_condition  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_pneumonia" type="string" calculate="if( /data/respiratory_conditions_group/temperature  &gt; 38 and  /data/respiratory_conditions_group/fever_duration  &gt; 7 and  /data/respiratory_conditions_group/adult_coughing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_flu_like_syndrome" type="string" calculate="if( /data/calc_tuberculosis  = 'false' and  /data/respiratory_conditions_group/wheezing  = 'no', 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_tuberculosis  = 'true' or  /data/calc_asthma  = 'true' or  /data/calc_pneumonia  = 'true' or  /data/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_tuberculosis" readonly="true()" type="string" relevant=" /data/calc_tuberculosis  = 'true'"/>
      <bind nodeset="/data/results_group/res_tuberculosis_action" readonly="true()" type="string" relevant=" /data/calc_tuberculosis  = 'true'"/>
      <bind nodeset="/data/results_group/res_asthma" readonly="true()" type="string" relevant=" /data/calc_asthma  = 'true' and  /data/inputs/contact/chronic_asthma  != 'true'"/>
      <bind nodeset="/data/results_group/res_asthma_action" readonly="true()" type="string" relevant=" /data/calc_asthma  = 'true' and  /data/inputs/contact/chronic_asthma  != 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia" readonly="true()" type="string" relevant=" /data/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_action" readonly="true()" type="string" relevant=" /data/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome" readonly="true()" type="string" relevant=" /data/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome_action" readonly="true()" type="string" relevant=" /data/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_tuberculosis  = 'false' and  /data/calc_asthma  = 'false' and  /data/calc_pneumonia  = 'false' and  /data/calc_flu_like_syndrome  = 'false'"/>
      <bind nodeset="/data/null_results_group/no_treatment_note" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_adult_coughing" type="string" calculate="if( /data/respiratory_conditions_group/adult_coughing  != '',  /data/respiratory_conditions_group/adult_coughing , 'false')"/>
      <bind nodeset="/data/data/_cough_duration" type="string" calculate="if( /data/respiratory_conditions_group/cough_duration  != '',  /data/respiratory_conditions_group/cough_duration , -1)"/>
      <bind nodeset="/data/data/_qualify_cough" type="string" calculate="if( /data/respiratory_conditions_group/qualify_cough  != '',  /data/respiratory_conditions_group/qualify_cough , 'false')"/>
      <bind nodeset="/data/data/_breathing_rate" type="string" calculate="if( /data/respiratory_conditions_group/breathing_rate  != '',  /data/respiratory_conditions_group/breathing_rate , -1)"/>
      <bind nodeset="/data/data/_oxygen_saturation" type="string" calculate="if( /data/respiratory_conditions_group/oxygen_saturation  != '',  /data/respiratory_conditions_group/oxygen_saturation , -1)"/>
      <bind nodeset="/data/data/_fever" type="string" calculate="if( /data/respiratory_conditions_group/fever  != '',  /data/respiratory_conditions_group/fever , 'false')"/>
      <bind nodeset="/data/data/_temperature" type="string" calculate="if( /data/respiratory_conditions_group/temperature  != '',  /data/respiratory_conditions_group/temperature , -1)"/>
      <bind nodeset="/data/data/_fever_duration" type="string" calculate="if( /data/respiratory_conditions_group/fever_duration  != '',  /data/respiratory_conditions_group/fever_duration , -1)"/>
      <bind nodeset="/data/data/_wheezing" type="string" calculate="if( /data/respiratory_conditions_group/wheezing  != '',  /data/respiratory_conditions_group/wheezing , 'false')"/>
      <bind nodeset="/data/data/_respiratory_distress" type="string" calculate="if( /data/respiratory_conditions_group/respiratory_distress  != '',  /data/respiratory_conditions_group/respiratory_distress , 'false')"/>
      <bind nodeset="/data/data/_weight_loss" type="string" calculate="if( /data/respiratory_conditions_group/weight_loss  != '',  /data/respiratory_conditions_group/weight_loss , 'false')"/>
      <bind nodeset="/data/data/_night_sweats" type="string" calculate="if( /data/respiratory_conditions_group/night_sweats  != '',  /data/respiratory_conditions_group/night_sweats , 'false')"/>
      <bind nodeset="/data/data/_recurring_condition" type="string" calculate="if( /data/respiratory_conditions_group/recurring_condition  != '',  /data/respiratory_conditions_group/recurring_condition , 'false')"/>
      <bind nodeset="/data/data/_tb_exposure" type="string" calculate="if( /data/respiratory_conditions_group/tb_exposure  != '',  /data/respiratory_conditions_group/tb_exposure , 'false')"/>
      <bind nodeset="/data/data/_result_tuberculosis" type="string" calculate="if( /data/calc_tuberculosis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_asthma" type="string" calculate="if( /data/calc_asthma ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_pneumonia" type="string" calculate="if( /data/calc_pneumonia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_flu_like_syndrome" type="string" calculate="if( /data/calc_flu_like_syndrome ='true', 'true', 'false')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_conditions_group">
      <label ref="jr:itext('/data/respiratory_conditions_group:label')"/>
      <select1 ref="/data/respiratory_conditions_group/adult_coughing">
        <label ref="jr:itext('/data/respiratory_conditions_group/adult_coughing:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_conditions_group/cough_duration">
        <label ref="jr:itext('/data/respiratory_conditions_group/cough_duration:label')"/>
      </input>
      <select ref="/data/respiratory_conditions_group/qualify_cough">
        <label ref="jr:itext('/data/respiratory_conditions_group/qualify_cough:label')"/>
        <itemset nodeset="instance('qualify_cough')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/respiratory_conditions_group/breathing_rate">
        <label ref="jr:itext('/data/respiratory_conditions_group/breathing_rate:label')"/>
        <hint ref="jr:itext('/data/respiratory_conditions_group/breathing_rate:hint')"/>
      </input>
      <input ref="/data/respiratory_conditions_group/oxygen_saturation">
        <label ref="jr:itext('/data/respiratory_conditions_group/oxygen_saturation:label')"/>
      </input>
      <select1 ref="/data/respiratory_conditions_group/fever">
        <label ref="jr:itext('/data/respiratory_conditions_group/fever:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_conditions_group/temperature">
        <label ref="jr:itext('/data/respiratory_conditions_group/temperature:label')"/>
      </input>
      <input ref="/data/respiratory_conditions_group/fever_duration">
        <label ref="jr:itext('/data/respiratory_conditions_group/fever_duration:label')"/>
        <hint ref="jr:itext('/data/respiratory_conditions_group/fever_duration:hint')"/>
      </input>
      <select1 ref="/data/respiratory_conditions_group/wheezing">
        <label ref="jr:itext('/data/respiratory_conditions_group/wheezing:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/respiratory_distress">
        <label ref="jr:itext('/data/respiratory_conditions_group/respiratory_distress:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/weight_loss">
        <label ref="jr:itext('/data/respiratory_conditions_group/weight_loss:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/night_sweats">
        <label ref="jr:itext('/data/respiratory_conditions_group/night_sweats:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/recurring_condition">
        <label ref="jr:itext('/data/respiratory_conditions_group/recurring_condition:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/tb_exposure">
        <label ref="jr:itext('/data/respiratory_conditions_group/tb_exposure:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_tuberculosis" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_tuberculosis:label')"/>
      </input>
      <input ref="/data/results_group/res_tuberculosis_action">
        <label ref="jr:itext('/data/results_group/res_tuberculosis_action:label')"/>
      </input>
      <input ref="/data/results_group/res_asthma" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_asthma:label')"/>
      </input>
      <input ref="/data/results_group/res_asthma_action">
        <label ref="jr:itext('/data/results_group/res_asthma_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_pneumonia:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_action">
        <label ref="jr:itext('/data/results_group/res_pneumonia_action:label')"/>
      </input>
      <input ref="/data/results_group/res_flu_like_syndrome" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome:label')"/>
      </input>
      <input ref="/data/results_group/res_flu_like_syndrome_action">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/no_treatment_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/no_treatment_note:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
  </h:body>
</h:html>