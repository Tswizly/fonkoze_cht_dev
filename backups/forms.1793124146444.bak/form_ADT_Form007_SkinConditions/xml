      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/skin_conditions_group/skin_symptoms" type="string" required="true()"/>
      <bind nodeset="/data/calc_impetigo_folliculitis" type="string" calculate="if(selected( /data/skin_conditions_group/skin_symptoms , 'crusts_or_lesions') or selected( /data/skin_conditions_group/skin_symptoms , 'blisters_sores_pustules'), 'true', 'false')"/>
      <bind nodeset="/data/calc_ring_worm" type="string" calculate="if(selected( /data/skin_conditions_group/skin_symptoms , 'itching') or selected( /data/skin_conditions_group/skin_symptoms , 'itchy_lesions'), 'true', 'false')"/>
      <bind nodeset="/data/calc_scabies" type="string" calculate="if(selected( /data/skin_conditions_group/skin_symptoms , 'rash') or selected( /data/skin_conditions_group/skin_symptoms , 'web_space_and_wrists') or selected( /data/skin_conditions_group/skin_symptoms , 'face_spared'), 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_impetigo_folliculitis  = 'true' or  /data/calc_ring_worm  = 'true' or  /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo_folliculitis" readonly="true()" type="string" relevant=" /data/calc_impetigo_folliculitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo_folliculitis_action" readonly="true()" type="string" relevant=" /data/calc_impetigo_folliculitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_ring_worm" readonly="true()" type="string" relevant=" /data/calc_ring_worm  = 'true'"/>
      <bind nodeset="/data/results_group/res_ring_worm_action" readonly="true()" type="string" relevant=" /data/calc_ring_worm  = 'true'"/>
      <bind nodeset="/data/results_group/res_scabies" readonly="true()" type="string" relevant=" /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/results_group/res_scabies_action" readonly="true()" type="string" relevant=" /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_impetigo_folliculitis  = 'false' and  /data/calc_ring_worm  = 'false' and  /data/calc_scabies  = 'false'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_skin_symptoms" type="string" calculate="if( /data/skin_conditions_group/skin_symptoms  != '',  /data/skin_conditions_group/skin_symptoms , 'false')"/>
      <bind nodeset="/data/data/_result_impetigo_folliculitis" type="string" calculate="if( /data/calc_impetigo_folliculitis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_ring_worm" type="string" calculate="if( /data/calc_ring_worm ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_scabies" type="string" calculate="if( /data/calc_scabies ='true', 'true', 'false')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/skin_conditions_group">
      <label ref="jr:itext('/data/skin_conditions_group:label')"/>
      <select ref="/data/skin_conditions_group/skin_symptoms">
        <label ref="jr:itext('/data/skin_conditions_group/skin_symptoms:label')"/>
        <itemset nodeset="instance('skin_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_impetigo_folliculitis" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_impetigo_folliculitis:label')"/>
      </input>
      <input ref="/data/results_group/res_impetigo_folliculitis_action">
        <label ref="jr:itext('/data/results_group/res_impetigo_folliculitis_action:label')"/>
      </input>
      <input ref="/data/results_group/res_ring_worm" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_ring_worm:label')"/>
      </input>
      <input ref="/data/results_group/res_ring_worm_action">
        <label ref="jr:itext('/data/results_group/res_ring_worm_action:label')"/>
      </input>
      <input ref="/data/results_group/res_scabies" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_scabies:label')"/>
      </input>
      <input ref="/data/results_group/res_scabies_action">
        <label ref="jr:itext('/data/results_group/res_scabies_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
  </h:body>
</h:html>