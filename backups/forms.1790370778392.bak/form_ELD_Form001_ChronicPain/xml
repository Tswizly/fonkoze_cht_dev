      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/co_mioflex_tablet_used_in" type="string" calculate=" /data/actions_confirmation/co_mioflex_tablet "/>
      <bind nodeset="/data/prescription_summary/fields/co_mioflex_tablet___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/co_mioflex_tablet_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/co_mioflex_tablet___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/co_mioflex_tablet_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/co_mioflex_tablet_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/co_mioflex_tablet_used_in_ELD_Form001_ChronicPain" type="string" calculate=" /data/prescription_summary/fields/co_mioflex_tablet___set  * X +  /data/prescription_summary/fields/co_mioflex_tablet___unit "/>
      <bind nodeset="/data/prescription_summary/fields/dolex_used_in_ELD_Form001_ChronicPain" type="string" calculate=" /data/actions_confirmation/dolex "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/chronic_pain_group">
      <label ref="jr:itext('/data/chronic_pain_group:label')"/>
      <select ref="/data/chronic_pain_group/chronic_pain_symptoms">
        <label ref="jr:itext('/data/chronic_pain_group/chronic_pain_symptoms:label')"/>
        <itemset nodeset="instance('chronic_pain_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_arthroses_arthritis" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_arthroses_arthritis:label')"/>
      </input>
      <input ref="/data/results_group/res_arthroses_arthritis_action">
        <label ref="jr:itext('/data/results_group/res_arthroses_arthritis_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select1 ref="/data/actions_confirmation/follow_up_arthroses_arthritis">
        <label ref="jr:itext('/data/actions_confirmation/follow_up_arthroses_arthritis:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/co_mioflex_tablet">
        <label ref="jr:itext('/data/actions_confirmation/co_mioflex_tablet:label')"/>
      </input>
      <input ref="/data/actions_confirmation/dolex">
        <label ref="jr:itext('/data/actions_confirmation/dolex:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>