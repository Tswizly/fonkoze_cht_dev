      <bind nodeset="/data/calc_moderate_anemia" type="string" calculate="if(selected( /data/skin_checkup_group/anemia_symptoms , 'pale_complexion') or selected( /data/skin_checkup_group/anemia_symptoms , 'sclera_abnormal'), 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_impetigo  = 'true' or  /data/calc_ring_worm  = 'true' or  /data/calc_scabies  = 'true' or  /data/calc_severe_malnutrition_anemia  = 'true' or  /data/calc_severe_anemia  = 'true' or  /data/calc_moderate_anemia  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo" readonly="true()" type="string" relevant=" /data/calc_impetigo  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo_action" readonly="true()" type="string" relevant=" /data/calc_impetigo  = 'true'"/>
      <bind nodeset="/data/results_group/res_ring_worm" readonly="true()" type="string" relevant=" /data/calc_ring_worm  = 'true'"/>
      <bind nodeset="/data/results_group/res_ring_worm_action" readonly="true()" type="string" relevant=" /data/calc_ring_worm  = 'true'"/>
      <bind nodeset="/data/results_group/res_scabies" readonly="true()" type="string" relevant=" /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/results_group/res_scabies_action" readonly="true()" type="string" relevant=" /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_malnutrition_anemia" readonly="true()" type="string" relevant=" /data/calc_severe_malnutrition_anemia  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_malnutrition_anemia_action" readonly="true()" type="string" relevant=" /data/calc_severe_malnutrition_anemia  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_anemia" readonly="true()" type="string" relevant=" /data/calc_severe_anemia  = 'true' and  /data/calc_severe_malnutrition_anemia  != 'true'"/>
      <bind nodeset="/data/results_group/res_severe_anemia_action" readonly="true()" type="string" relevant=" /data/calc_severe_anemia  = 'true' and  /data/calc_severe_malnutrition_anemia  != 'true'"/>
      <bind nodeset="/data/results_group/res_moderate_anemia" readonly="true()" type="string" relevant=" /data/calc_moderate_anemia  = 'true' and  /data/calc_severe_anemia  != 'true' and  /data/calc_severe_malnutrition_anemia  != 'true'"/>
      <bind nodeset="/data/results_group/res_moderate_anemia_action" readonly="true()" type="string" relevant=" /data/calc_moderate_anemia  = 'true' and  /data/calc_severe_anemia  != 'true' and  /data/calc_severe_malnutrition_anemia  != 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_impetigo  != 'true' and  /data/calc_ring_worm  != 'true' and  /data/calc_scabies  != 'true' and  /data/calc_severe_malnutrition_anemia  != 'true' and  /data/calc_severe_anemia  != 'true' and  /data/calc_moderate_anemia  != 'true'"/>
      <bind nodeset="/data/null_results_group/res_null_results" readonly="true()" type="string"/>
      <bind nodeset="/data/actions_confirmation/followed_up_conditions" type="string" required="true()"/>
      <bind nodeset="/data/actions_confirmation/referal" type="string" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'impetigo') or selected( /data/actions_confirmation/followed_up_conditions , 'severe_malnutrition_anemia') or selected( /data/actions_confirmation/followed_up_conditions , 'severe_anemia')"/>
      <bind nodeset="/data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'impetigo')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml:jr:constraintMsg')"/>
      <bind nodeset="/data/actions_confirmation/griseofulvine_cream" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'ring_worm')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/griseofulvine_cream:jr:constraintMsg')"/>
      <bind nodeset="/data/actions_confirmation/griseofulvin_tablets_125mg" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'ring_worm')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/griseofulvin_tablets_125mg:jr:constraintMsg')"/>
      <bind nodeset="/data/actions_confirmation/calamine_lotion" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'scabies')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/calamine_lotion:jr:constraintMsg')"/>
      <bind nodeset="/data/actions_confirmation/benzyl_benzoate_25" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'scabies')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/benzyl_benzoate_25:jr:constraintMsg')"/>
      <bind nodeset="/data/actions_confirmation/iron_and_folic_acid_tablets" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'severe_malnutrition_anemia') or selected( /data/actions_confirmation/followed_up_conditions , 'severe_anemia') or selected( /data/actions_confirmation/followed_up_conditions , 'moderate_anemia')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/iron_and_folic_acid_tablets:jr:constraintMsg')"/>
      <bind nodeset="/data/data/_skin_symptoms" type="string" calculate="if( /data/skin_checkup_group/skin_symptoms  != '',  /data/skin_checkup_group/skin_symptoms , 'false')"/>
      <bind nodeset="/data/data/_anemia_symptoms" type="string" calculate="if( /data/skin_checkup_group/anemia_symptoms  != '',  /data/skin_checkup_group/anemia_symptoms , 'false')"/>
      <bind nodeset="/data/data/_muac_result" type="string" calculate="if( /data/skin_checkup_group/muac_result  != '',  /data/skin_checkup_group/muac_result , 'false')"/>
      <bind nodeset="/data/data/_result_impetigo" type="string" calculate="if( /data/calc_impetigo ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_ring_worm" type="string" calculate="if( /data/calc_ring_worm ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_scabies" type="string" calculate="if( /data/calc_scabies ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_severe_malnutrition_anemia" type="string" calculate="if( /data/calc_severe_malnutrition_anemia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_severe_anemia" type="string" calculate="if( /data/calc_severe_anemia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_moderate_anemia" type="string" calculate="if( /data/calc_moderate_anemia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_followed_up_conditions" type="string" calculate="if( /data/actions_confirmation/followed_up_conditions  != '',  /data/actions_confirmation/followed_up_conditions , 'false')"/>
      <bind nodeset="/data/data/_referal" type="string" calculate="if( /data/actions_confirmation/referal  != '',  /data/actions_confirmation/referal , 'false')"/>
      <bind nodeset="/data/data/_cloxacillin_oral_solution_250mg_5ml" type="string" calculate="if( /data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml  != '',  /data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml , -1)"/>
      <bind nodeset="/data/data/_griseofulvine_cream" type="string" calculate="if( /data/actions_confirmation/griseofulvine_cream  != '',  /data/actions_confirmation/griseofulvine_cream , -1)"/>
      <bind nodeset="/data/data/_griseofulvin_tablets_125mg" type="string" calculate="if( /data/actions_confirmation/griseofulvin_tablets_125mg  != '',  /data/actions_confirmation/griseofulvin_tablets_125mg , -1)"/>
      <bind nodeset="/data/data/_calamine_lotion" type="string" calculate="if( /data/actions_confirmation/calamine_lotion  != '',  /data/actions_confirmation/calamine_lotion , -1)"/>
      <bind nodeset="/data/data/_benzyl_benzoate_25" type="string" calculate="if( /data/actions_confirmation/benzyl_benzoate_25  != '',  /data/actions_confirmation/benzyl_benzoate_25 , -1)"/>
      <bind nodeset="/data/data/_iron_and_folic_acid_tablets" type="string" calculate="if( /data/actions_confirmation/iron_and_folic_acid_tablets  != '',  /data/actions_confirmation/iron_and_folic_acid_tablets , -1)"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;CHD_Form003_SkinConditions&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/cloxacillin_oral_solution_250mg_5ml_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml "/>
      <bind nodeset="/data/prescription_summary/fields/griseofulvine_cream_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/actions_confirmation/griseofulvine_cream "/>
      <bind nodeset="/data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in" type="string" calculate=" /data/actions_confirmation/griseofulvin_tablets_125mg "/>
      <bind nodeset="/data/prescription_summary/fields/griseofulvin_tablets_125mg___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/griseofulvin_tablets_125mg___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/griseofulvin_tablets_125mg_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/prescription_summary/fields/griseofulvin_tablets_125mg___set  * X +  /data/prescription_summary/fields/griseofulvin_tablets_125mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/calamine_lotion_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/actions_confirmation/calamine_lotion "/>
      <bind nodeset="/data/prescription_summary/fields/benzyl_benzoate_25_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/actions_confirmation/benzyl_benzoate_25 "/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in" type="string" calculate=" /data/actions_confirmation/iron_and_folic_acid_tablets "/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/iron_and_folic_acid_tablets_used_in_CHD_Form003_SkinConditions" type="string" calculate=" /data/prescription_summary/fields/iron_and_folic_acid_tablets___set  * X +  /data/prescription_summary/fields/iron_and_folic_acid_tablets___unit "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/skin_checkup_group">
      <label ref="jr:itext('/data/skin_checkup_group:label')"/>
      <select ref="/data/skin_checkup_group/skin_symptoms">
        <label ref="jr:itext('/data/skin_checkup_group/skin_symptoms:label')"/>
        <itemset nodeset="instance('skin_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select ref="/data/skin_checkup_group/anemia_symptoms">
        <label ref="jr:itext('/data/skin_checkup_group/anemia_symptoms:label')"/>
        <itemset nodeset="instance('anemia_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select ref="/data/skin_checkup_group/muac_result">
        <label ref="jr:itext('/data/skin_checkup_group/muac_result:label')"/>
        <itemset nodeset="instance('muac_result')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_impetigo" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_impetigo:label')"/>
      </input>
      <input ref="/data/results_group/res_impetigo_action">
        <label ref="jr:itext('/data/results_group/res_impetigo_action:label')"/>
      </input>
      <input ref="/data/results_group/res_ring_worm" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_ring_worm:label')"/>
      </input>
      <input ref="/data/results_group/res_ring_worm_action">
        <label ref="jr:itext('/data/results_group/res_ring_worm_action:label')"/>
      </input>
      <input ref="/data/results_group/res_scabies" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_scabies:label')"/>
      </input>
      <input ref="/data/results_group/res_scabies_action">
        <label ref="jr:itext('/data/results_group/res_scabies_action:label')"/>
      </input>
      <input ref="/data/results_group/res_severe_malnutrition_anemia" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_severe_malnutrition_anemia:label')"/>
      </input>
      <input ref="/data/results_group/res_severe_malnutrition_anemia_action">
        <label ref="jr:itext('/data/results_group/res_severe_malnutrition_anemia_action:label')"/>
      </input>
      <input ref="/data/results_group/res_severe_anemia" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_severe_anemia:label')"/>
      </input>
      <input ref="/data/results_group/res_severe_anemia_action">
        <label ref="jr:itext('/data/results_group/res_severe_anemia_action:label')"/>
      </input>
      <input ref="/data/results_group/res_moderate_anemia" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_moderate_anemia:label')"/>
      </input>
      <input ref="/data/results_group/res_moderate_anemia_action">
        <label ref="jr:itext('/data/results_group/res_moderate_anemia_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/res_null_results">
        <label ref="jr:itext('/data/null_results_group/res_null_results:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select ref="/data/actions_confirmation/followed_up_conditions">
        <label ref="jr:itext('/data/actions_confirmation/followed_up_conditions:label')"/>
        <itemset nodeset="instance('followed_up_conditions')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/actions_confirmation/referal">
        <label ref="jr:itext('/data/actions_confirmation/referal:label')"/>
        <itemset nodeset="instance('referal_locations')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml">
        <label ref="jr:itext('/data/actions_confirmation/cloxacillin_oral_solution_250mg_5ml:label')"/>
      </input>
      <input ref="/data/actions_confirmation/griseofulvine_cream">
        <label ref="jr:itext('/data/actions_confirmation/griseofulvine_cream:label')"/>
      </input>
      <input ref="/data/actions_confirmation/griseofulvin_tablets_125mg">
        <label ref="jr:itext('/data/actions_confirmation/griseofulvin_tablets_125mg:label')"/>
      </input>
      <input ref="/data/actions_confirmation/calamine_lotion">
        <label ref="jr:itext('/data/actions_confirmation/calamine_lotion:label')"/>
      </input>
      <input ref="/data/actions_confirmation/benzyl_benzoate_25">
        <label ref="jr:itext('/data/actions_confirmation/benzyl_benzoate_25:label')"/>
      </input>
      <input ref="/data/actions_confirmation/iron_and_folic_acid_tablets">
        <label ref="jr:itext('/data/actions_confirmation/iron_and_folic_acid_tablets:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out"/>
      </group>
    </group>
  </h:body>
</h:html>