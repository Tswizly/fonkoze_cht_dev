      <bind nodeset="/data/calc_threatened_miscarriage_less20" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &lt; 20 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'bleeding') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'pain_general')), 'true', 'false')"/>
      <bind nodeset="/data/calc_threatened_miscarriage_greater20" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &gt; 20 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'bleeding') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'pain_general') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'contractions')), 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_gestational_hypertension_no_serious  = 'true' or  /data/calc_gestational_hypertension_serious  = 'true' or  /data/calc_pre_eclampsia  = 'true' or  /data/calc_genitourinary_infections  = 'true' or  /data/calc_threatened_miscarriage_less20  = 'true' or  /data/calc_threatened_miscarriage_greater20  = 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_no_serious" readonly="true()" type="string" relevant=" /data/calc_gestational_hypertension_no_serious  = 'true' and  /data/calc_gestational_hypertension_serious  != 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_no_serious_action" readonly="true()" type="string" relevant=" /data/calc_gestational_hypertension_no_serious  = 'true' and  /data/calc_gestational_hypertension_serious  != 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_serious" readonly="true()" type="string" relevant=" /data/calc_gestational_hypertension_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertesnion_serious_action" readonly="true()" type="string" relevant=" /data/calc_gestational_hypertension_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_pre_eclampsia" readonly="true()" type="string" relevant=" /data/calc_pre_eclampsia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pre_eclampsia_action" readonly="true()" type="string" relevant=" /data/calc_pre_eclampsia  = 'true'"/>
      <bind nodeset="/data/results_group/res_genitourinary_infections" readonly="true()" type="string" relevant=" /data/calc_genitourinary_infections  = 'true'"/>
      <bind nodeset="/data/results_group/res_genitourinary_infections_action" readonly="true()" type="string" relevant=" /data/calc_genitourinary_infections  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_less20" readonly="true()" type="string" relevant=" /data/calc_threatened_miscarriage_less20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_less20_action" readonly="true()" type="string" relevant=" /data/calc_threatened_miscarriage_less20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_greater20" readonly="true()" type="string" relevant=" /data/calc_threatened_miscarriage_greater20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_greater20_action" readonly="true()" type="string" relevant=" /data/calc_threatened_miscarriage_greater20  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_gestational_hypertension_no_serious  != 'true' and  /data/calc_gestational_hypertension_serious  != 'true' and  /data/calc_pre_eclampsia  != 'true' and  /data/calc_genitourinary_infections  != 'true' and  /data/calc_threatened_miscarriage_less20  != 'true' and  /data/calc_threatened_miscarriage_greater20  != 'true'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/actions_confirmation/followed_up_conditions" type="string" required="true()"/>
      <bind nodeset="/data/actions_confirmation/referal" type="string" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'gestational_hypertension_no_serious') or selected( /data/actions_confirmation/followed_up_conditions , 'gestational_hypertension_serious') or selected( /data/actions_confirmation/followed_up_conditions , 'pre_eclampsia') or selected( /data/actions_confirmation/followed_up_conditions , 'genitourinary_infections') or selected( /data/actions_confirmation/followed_up_conditions , 'threatened_miscarriage_less20') or selected( /data/actions_confirmation/followed_up_conditions , 'threatened_miscarriage_greater20')"/>
      <bind nodeset="/data/actions_confirmation/nifedipine_20mg_tablets" type="int" required="true()" relevant="selected( /data/actions_confirmation/followed_up_conditions , 'gestational_hypertension_no_serious') or selected( /data/actions_confirmation/followed_up_conditions , 'gestational_hypertension_serious') or selected( /data/actions_confirmation/followed_up_conditions , 'pre_eclampsia') or selected( /data/actions_confirmation/followed_up_conditions , 'threatened_miscarriage_greater20')" constraint=". &gt;= 0 and . &lt;= 999" jr:constraintMsg="jr:itext('/data/actions_confirmation/nifedipine_20mg_tablets:jr:constraintMsg')"/>
      <bind nodeset="/data/data/_form_purpose" type="string" calculate="if( /data/form_purpose_group/form_purpose  != '',  /data/form_purpose_group/form_purpose , 'false')"/>
      <bind nodeset="/data/data/_register_last_menstruation" type="string" calculate="if( /data/register_pregnancy_group/register_last_menstruation  != '',  /data/register_pregnancy_group/register_last_menstruation , 'false')"/>
      <bind nodeset="/data/data/_pregnancy_test_result" type="string" calculate="if( /data/register_pregnancy_group/pregnancy_test_result  != '',  /data/register_pregnancy_group/pregnancy_test_result , 'false')"/>
      <bind nodeset="/data/data/_confirm_pregnancy_duration_menstruation" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_menstruation  != '',  /data/perform_followup_group/confirm_pregnancy_duration_menstruation , 'false')"/>
      <bind nodeset="/data/data/_confirm_pregnancy_duration_approximation" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  != '',  /data/perform_followup_group/confirm_pregnancy_duration_approximation , -1)"/>
      <bind nodeset="/data/data/_bp_systolic" type="string" calculate="if( /data/perform_followup_group/bp_systolic  != '',  /data/perform_followup_group/bp_systolic , -1)"/>
      <bind nodeset="/data/data/_bp_diastolic" type="string" calculate="if( /data/perform_followup_group/bp_diastolic  != '',  /data/perform_followup_group/bp_diastolic , -1)"/>
      <bind nodeset="/data/data/_concerning_pregnancy_symptoms" type="string" calculate="if( /data/perform_followup_group/concerning_pregnancy_symptoms  != '',  /data/perform_followup_group/concerning_pregnancy_symptoms , 'false')"/>
      <bind nodeset="/data/data/_result_gestational_hypertension_no_serious" type="string" calculate="if( /data/calc_gestational_hypertension_no_serious ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_gestational_hypertension_serious" type="string" calculate="if( /data/calc_gestational_hypertension_serious ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_pre_eclampsia" type="string" calculate="if( /data/calc_pre_eclampsia ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_genitourinary_infections" type="string" calculate="if( /data/calc_genitourinary_infections ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_threatened_miscarriage_less20" type="string" calculate="if( /data/calc_threatened_miscarriage_less20 ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_threatened_miscarriage_greater20" type="string" calculate="if( /data/calc_threatened_miscarriage_greater20 ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_followed_up_conditions" type="string" calculate="if( /data/actions_confirmation/followed_up_conditions  != '',  /data/actions_confirmation/followed_up_conditions , 'false')"/>
      <bind nodeset="/data/data/_referal" type="string" calculate="if( /data/actions_confirmation/referal  != '',  /data/actions_confirmation/referal , 'false')"/>
      <bind nodeset="/data/data/_nifedipine_20mg_tablets" type="string" calculate="if( /data/actions_confirmation/nifedipine_20mg_tablets  != '',  /data/actions_confirmation/nifedipine_20mg_tablets , -1)"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;ADT_Form005_Pregnancy&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_20mg_tablets_used_in" type="string" calculate=" /data/actions_confirmation/nifedipine_20mg_tablets "/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_20mg_tablets___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_20mg_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/nifedipine_20mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/nifedipine_20mg_tablets_used_in_ADT_Form005_Pregnancy" type="string" calculate=" /data/prescription_summary/fields/nifedipine_20mg_tablets___set  * X +  /data/prescription_summary/fields/nifedipine_20mg_tablets___unit "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/form_purpose_group">
      <label ref="jr:itext('/data/form_purpose_group:label')"/>
      <input ref="/data/form_purpose_group/optional_note">
        <label ref="jr:itext('/data/form_purpose_group/optional_note:label')"/>
      </input>
      <select1 ref="/data/form_purpose_group/form_purpose">
        <label ref="jr:itext('/data/form_purpose_group/form_purpose:label')"/>
        <itemset nodeset="instance('Form_purpose')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/register_pregnancy_group">
      <label ref="jr:itext('/data/register_pregnancy_group:label')"/>
      <input ref="/data/register_pregnancy_group/register_last_menstruation">
        <label ref="jr:itext('/data/register_pregnancy_group/register_last_menstruation:label')"/>
      </input>
      <select1 ref="/data/register_pregnancy_group/pregnancy_test_result">
        <label ref="jr:itext('/data/register_pregnancy_group/pregnancy_test_result:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/perform_followup_group">
      <label ref="jr:itext('/data/perform_followup_group:label')"/>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_menstruation">
        <label ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_menstruation:label')"/>
        <hint ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_menstruation:hint')"/>
      </input>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_approximation">
        <label ref="jr:itext('/data/perform_followup_group/confirm_pregnancy_duration_approximation:label')"/>
      </input>
      <input ref="/data/perform_followup_group/bp_systolic">
        <label ref="jr:itext('/data/perform_followup_group/bp_systolic:label')"/>
        <hint ref="jr:itext('/data/perform_followup_group/bp_systolic:hint')"/>
      </input>
      <input ref="/data/perform_followup_group/bp_diastolic">
        <label ref="jr:itext('/data/perform_followup_group/bp_diastolic:label')"/>
        <hint ref="jr:itext('/data/perform_followup_group/bp_diastolic:hint')"/>
      </input>
      <select ref="/data/perform_followup_group/concerning_pregnancy_symptoms">
        <label ref="jr:itext('/data/perform_followup_group/concerning_pregnancy_symptoms:label')"/>
        <itemset nodeset="instance('concerning_pregnancy_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_no_serious:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious_action">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_no_serious_action:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_serious" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertension_serious:label')"/>
      </input>
      <input ref="/data/results_group/res_gestational_hypertesnion_serious_action">
        <label ref="jr:itext('/data/results_group/res_gestational_hypertesnion_serious_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_pre_eclampsia:label')"/>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia_action">
        <label ref="jr:itext('/data/results_group/res_pre_eclampsia_action:label')"/>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_genitourinary_infections:label')"/>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections_action">
        <label ref="jr:itext('/data/results_group/res_genitourinary_infections_action:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_less20:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20_action">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_less20_action:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_greater20:label')"/>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20_action">
        <label ref="jr:itext('/data/results_group/res_threatened_miscarriage_greater20_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select ref="/data/actions_confirmation/followed_up_conditions">
        <label ref="jr:itext('/data/actions_confirmation/followed_up_conditions:label')"/>
        <itemset nodeset="instance('followed_up_conditions')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/actions_confirmation/referal">
        <label ref="jr:itext('/data/actions_confirmation/referal:label')"/>
        <itemset nodeset="instance('referal_locations')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/nifedipine_20mg_tablets">
        <label ref="jr:itext('/data/actions_confirmation/nifedipine_20mg_tablets:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>