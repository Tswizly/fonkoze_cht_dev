<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Pregnancy Form</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ADT_FormX_Pregnancy" version="20260827124010" prefix="J1!ADT_FormX_Pregnancy!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <client_uuid/>
          <client_id/>
          <client_name/>
          <client_short_name/>
          <client_sex/>
          <client_date_of_birth/>
          <client_age_in_years/>
          <client_age_in_months/>
          <client_age_in_days/>
          <client_age_in_weeks/>
          <form_purpose_group>
            <optional_note/>
            <form_purpose/>
          </form_purpose_group>
          <register_pregnancy_group>
            <register_last_menstruation/>
            <pregnancy_test_result/>
          </register_pregnancy_group>
          <perform_followup_group>
            <confirm_pregnancy_duration_menstruation/>
            <confirm_pregnancy_duration_approximation/>
            <bp_systolic/>
            <bp_diastolic/>
            <concerning_pregnancy_symptoms/>
          </perform_followup_group>
          <results_group>
            <calc_gestational_hypertension_no_serious/>
            <calc_gestational_hypertension_serious/>
            <calc_pre_eclampsia/>
            <calc_genitourinary_infections/>
            <calc_threatened_miscarriage_less20/>
            <calc_threatened_miscarriage_greater20/>
            <res_gestational_hypertension_no_serious/>
            <res_gestational_hypertension_no_serious_action/>
            <res_gestational_hypertension_serious/>
            <res_gestational_hypertesnion_serious_action/>
            <res_pre_eclampsia/>
            <res_pre_eclampsia_action/>
            <res_genitourinary_infections/>
            <res_genitourinary_infections_action/>
            <res_threatened_miscarriage_less20/>
            <res_threatened_miscarriage_less20_action/>
            <res_threatened_miscarriage_greater20/>
            <res_threatened_miscarriage_greater20_action/>
          </results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="Form_purpose">
        <root>
          <item>
            <name>register_pregnancy</name>
            <label>Register pregnancy</label>
          </item>
          <item>
            <name>perform_followup</name>
            <label>Perform followup</label>
          </item>
        </root>
      </instance>
      <instance id="concerning_pregnancy_symptoms">
        <root>
          <item>
            <name>burning_urination</name>
            <label>Burning urination</label>
          </item>
          <item>
            <name>vaginal_itching</name>
            <label>Vaginal itching</label>
          </item>
          <item>
            <name>vaginal_discharge</name>
            <label>Vaginal discharge</label>
          </item>
          <item>
            <name>positive_white_bloodcell_strip_in_urine</name>
            <label>Positive white bloodcell strip in urine</label>
          </item>
          <item>
            <name>headache</name>
            <label>Headache</label>
          </item>
          <item>
            <name>neck_stiffness</name>
            <label>Neck stiffness</label>
          </item>
          <item>
            <name>blurred_vision</name>
            <label>Blurred vision</label>
          </item>
          <item>
            <name>epigastric_pain</name>
            <label>Epigastric pain</label>
          </item>
          <item>
            <name>pain_general</name>
            <label>Pain general</label>
          </item>
          <item>
            <name>edema</name>
            <label>Edema</label>
          </item>
          <item>
            <name>bleeding</name>
            <label>Bleeding</label>
          </item>
          <item>
            <name>contractions</name>
            <label>Contractions</label>
          </item>
        </root>
      </instance>
      <instance id="pregnancy_test_result">
        <root>
          <item>
            <name>positive</name>
            <label>Positive</label>
          </item>
          <item>
            <name>negative</name>
            <label>Negative</label>
          </item>
          <item>
            <name>inconculsive</name>
            <label>Inconclusive</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/client_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/client_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/client_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/client_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/client_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/client_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/client_age_in_years" type="string" calculate="floor( difference-in-months(  /data/client_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/client_age_in_months" type="string" calculate="difference-in-months(  /data/client_date_of_birth , today() )"/>
      <bind nodeset="/data/client_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/client_date_of_birth ) )"/>
      <bind nodeset="/data/client_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/client_date_of_birth )) div 7)"/>
      <bind nodeset="/data/form_purpose_group/optional_note" readonly="true()" type="string"/>
      <bind nodeset="/data/form_purpose_group/form_purpose" type="string" required="true()"/>
      <bind nodeset="/data/register_pregnancy_group" relevant=" /data/form_purpose_group/form_purpose  = 'register_pregnancy'"/>
      <bind nodeset="/data/register_pregnancy_group/register_last_menstruation" type="date" required="true()"/>
      <bind nodeset="/data/register_pregnancy_group/pregnancy_test_result" type="string"/>
      <bind nodeset="/data/perform_followup_group" relevant=" /data/form_purpose_group/form_purpose  = 'perform_followup'"/>
      <bind nodeset="/data/perform_followup_group/confirm_pregnancy_duration_menstruation" type="date"/>
      <bind nodeset="/data/perform_followup_group/confirm_pregnancy_duration_approximation" type="int"/>
      <bind nodeset="/data/perform_followup_group/bp_systolic" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/perform_followup_group/bp_diastolic" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/perform_followup_group/concerning_pregnancy_symptoms" type="string"/>
      <bind nodeset="/data/results_group/calc_gestational_hypertension_no_serious" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &gt; 20 and  /data/perform_followup_group/bp_systolic  &gt;= 140 and  /data/perform_followup_group/bp_diastolic  &gt;= 90, 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_gestational_hypertension_serious" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &gt; 20 and  /data/perform_followup_group/bp_systolic  &gt;= 140 and  /data/perform_followup_group/bp_diastolic  &gt;= 90 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'headache') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'neck_stiffness') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'blurred_vision') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'epigastric_pain')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_pre_eclampsia" type="string" calculate="if( /data/perform_followup_group/bp_systolic  &gt;= 140 and  /data/perform_followup_group/bp_diastolic  &gt;= 90 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'headache') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'epigastric_pain') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'blurred_vision') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'edema')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_genitourinary_infections" type="string" calculate="if(selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'burning_urination') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'vaginal_itching') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'vaginal_discharge') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'positive_white_bloodcell_strip_in_urine'), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_threatened_miscarriage_less20" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &lt; 20 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'bleeding') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'pain_general')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_threatened_miscarriage_greater20" type="string" calculate="if( /data/perform_followup_group/confirm_pregnancy_duration_approximation  &gt; 20 and (selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'bleeding') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'pain_general') or selected( /data/perform_followup_group/concerning_pregnancy_symptoms , 'contractions')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_no_serious" readonly="true()" type="string" relevant=" /data/results_group/calc_gestational_hypertension_no_serious  = 'true' and  /data/results_group/calc_gestational_hypertension_serious  != 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_no_serious_action" readonly="true()" type="string" relevant=" /data/results_group/calc_gestational_hypertension_no_serious  = 'true' and  /data/results_group/calc_gestational_hypertension_serious  != 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertension_serious" readonly="true()" type="string" relevant=" /data/results_group/calc_gestational_hypertension_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_gestational_hypertesnion_serious_action" readonly="true()" type="string" relevant=" /data/results_group/calc_gestational_hypertension_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_pre_eclampsia" readonly="true()" type="string" relevant=" /data/results_group/calc_pre_eclampsia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pre_eclampsia_action" readonly="true()" type="string" relevant=" /data/results_group/calc_pre_eclampsia  = 'true'"/>
      <bind nodeset="/data/results_group/res_genitourinary_infections" readonly="true()" type="string" relevant=" /data/results_group/calc_genitourinary_infections  = 'true'"/>
      <bind nodeset="/data/results_group/res_genitourinary_infections_action" readonly="true()" type="string" relevant=" /data/results_group/calc_genitourinary_infections  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_less20" readonly="true()" type="string" relevant=" /data/results_group/calc_threatened_miscarriage_less20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_less20_action" readonly="true()" type="string" relevant=" /data/results_group/calc_threatened_miscarriage_less20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_greater20" readonly="true()" type="string" relevant=" /data/results_group/calc_threatened_miscarriage_greater20  = 'true'"/>
      <bind nodeset="/data/results_group/res_threatened_miscarriage_greater20_action" readonly="true()" type="string" relevant=" /data/results_group/calc_threatened_miscarriage_greater20  = 'true'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/form_purpose_group">
      <label>Form purpose</label>
      <input ref="/data/form_purpose_group/optional_note">
        <label>&lt;optional note&gt;</label>
      </input>
      <select1 ref="/data/form_purpose_group/form_purpose">
        <label>Select the reason for filling out the pregnancy form.</label>
        <itemset nodeset="instance('Form_purpose')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/register_pregnancy_group">
      <label>Register pregnancy</label>
      <input ref="/data/register_pregnancy_group/register_last_menstruation">
        <label>Register last menstruation</label>
      </input>
      <select1 ref="/data/register_pregnancy_group/pregnancy_test_result">
        <label>Pregnancy test result</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list" ref="/data/perform_followup_group">
      <label>Perform followup</label>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_menstruation">
        <label>When was the woman's last day of their last menstruation? If unsure, leave blank, or guess to their best ability.</label>
        <hint>If unsure, put your best estimate</hint>
      </input>
      <input ref="/data/perform_followup_group/confirm_pregnancy_duration_approximation">
        <label>Pregnancy duration approximation: (change if incorrect)</label>
      </input>
      <input ref="/data/perform_followup_group/bp_systolic">
        <label>Systolic blood pressure:</label>
      </input>
      <input ref="/data/perform_followup_group/bp_diastolic">
        <label>Diastolic blood pressure:</label>
      </input>
      <select ref="/data/perform_followup_group/concerning_pregnancy_symptoms">
        <label>Is the adult experiencing any of the following?</label>
        <itemset nodeset="instance('concerning_pregnancy_symptoms')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious" appearance="h1 yellow">
        <label>Gestational Hypertension</label>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_no_serious_action">
        <label>The woman has gestational hypertension with no severe warning signs. Refer to prenatal clinic. 

Procedure: 
- If no severe signs: Nifedipine 20 mg daily
- Refer to regular prenatal clinic but counsel not to wait too long
- Counseling: reduce salt consumption</label>
      </input>
      <input ref="/data/results_group/res_gestational_hypertension_serious" appearance="h1 red">
        <label>Gestational Hypertension</label>
      </input>
      <input ref="/data/results_group/res_gestational_hypertesnion_serious_action">
        <label>The woman has gestational hypertension with a severe warning sign. Refer immediately! 

Procedure:
- 20 mg Nifedipine co one given on the spot
- Refer to hospital</label>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia" appearance="h1 red">
        <label>Pre-Eclampsia</label>
      </input>
      <input ref="/data/results_group/res_pre_eclampsia_action">
        <label>The woman may have pre-eclampsia. Administer Nifedipine and refer to the hospital immediately. 

Procedure:
- Nifedipine 20mg
- Immediately refer to hospital</label>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections" appearance="h1 red">
        <label>Genitourinary Infections</label>
      </input>
      <input ref="/data/results_group/res_genitourinary_infections_action">
        <label>The woman may have a genitourinary infection. 

Procedure:
- Hygiene counseling
- Amoxicillin 500 mg, 3 times/day for 7 days</label>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20" appearance="h1 red">
        <label>Threatened Miscarriage</label>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_less20_action">
        <label>The woman is threatening miscarriage. Refer to the hospital immediately. 

Procedure: 
- Paracetamol 500 mg on the spot and immediate referral</label>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20" appearance="h1 red">
        <label>Threatened Miscarriage</label>
      </input>
      <input ref="/data/results_group/res_threatened_miscarriage_greater20_action">
        <label>The woman is threatening miscarriage. Refer to the hospital immediately. 

Procedure: 
- Nifedipine 20mg
- Paracetamol 500mg
- Immediate referral</label>
      </input>
    </group>
  </h:body>
</h:html>