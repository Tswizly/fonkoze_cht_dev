      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/fever_malaria_group/fever_presence" type="string" required="true()"/>
      <bind nodeset="/data/fever_malaria_group/temperature" type="int" relevant=" /data/fever_malaria_group/fever_presence  = 'yes'"/>
      <bind nodeset="/data/fever_malaria_group/fever_duration" type="int" relevant=" /data/fever_malaria_group/fever_presence  = 'yes'"/>
      <bind nodeset="/data/fever_malaria_group/previous_fever" type="string" required="true()"/>
      <bind nodeset="/data/fever_malaria_group/fever_recurrance" type="string" relevant=" /data/fever_malaria_group/fever_presence  = 'yes' or  /data/fever_malaria_group/previous_fever  = 'yes'"/>
      <bind nodeset="/data/fever_malaria_group/malaria_symptoms" type="string" relevant=" /data/fever_malaria_group/fever_presence  = 'yes' or  /data/fever_malaria_group/previous_fever  = 'yes'"/>
      <bind nodeset="/data/calc_risk_malaria" type="string" calculate="if(selected( /data/fever_malaria_group/malaria_symptoms , 'chills') or selected( /data/fever_malaria_group/malaria_symptoms , 'heavy_headache') or selected( /data/fever_malaria_group/malaria_symptoms , 'profuse_sweating') or  /data/fever_malaria_group/fever_recurrance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/rapid_test_group" relevant=" /data/calc_risk_malaria  = 'true'"/>
      <bind nodeset="/data/rapid_test_group/rapid_test" type="string" required="true()"/>
      <bind nodeset="/data/rapid_test_group/rapid_test_result" type="string" required="true()" relevant=" /data/rapid_test_group/rapid_test  = 'yes'"/>
      <bind nodeset="/data/calc_malaria_positive" type="string" calculate="if( /data/rapid_test_group/rapid_test_result  = 'positive', 'true', 'false')"/>
      <bind nodeset="/data/calc_malaria_negative" type="string" calculate="if( /data/rapid_test_group/rapid_test_result  = 'negative', 'true', 'false')"/>
      <bind nodeset="/data/calc_malaria_unclear" type="string" calculate="if( /data/rapid_test_group/rapid_test_result  = 'unclear','true','false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_risk_malaria  = 'true'"/>
      <bind nodeset="/data/results_group/res_malaria_positive" readonly="true()" type="string" relevant=" /data/calc_malaria_positive  = 'true'"/>
      <bind nodeset="/data/results_group/res_malaria_positive_action" readonly="true()" type="string" relevant=" /data/calc_malaria_positive  = 'true'"/>
      <bind nodeset="/data/results_group/res_malaria_negative" readonly="true()" type="string" relevant=" /data/calc_malaria_negative  = 'true'"/>
      <bind nodeset="/data/results_group/res_malaria_negative_action" readonly="true()" type="string" relevant=" /data/calc_malaria_negative  = 'true'"/>
      <bind nodeset="/data/results_group/res_malaria_unclear" readonly="true()" type="string" relevant=" /data/calc_malaria_negative  = 'unclear' or  /data/rapid_test_group/rapid_test  = 'no'"/>
      <bind nodeset="/data/results_group/res_malaria_unclear_action" readonly="true()" type="string" relevant=" /data/calc_malaria_negative  = 'unclear' or  /data/rapid_test_group/rapid_test  = 'no'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_risk_malaria  = 'false'"/>
      <bind nodeset="/data/null_results_group/null_results_group_note" readonly="true()" type="string"/>
      <bind nodeset="/data/actions_confirmation" relevant=" /data/calc_risk_malaria  = 'true'"/>
      <bind nodeset="/data/actions_confirmation/malaria_rapid_test" type="string" required="true()" relevant=" /data/rapid_test_group/rapid_test  = 'yes'"/>
      <bind nodeset="/data/actions_confirmation/malaria_rapid_test_other" type="int" relevant=" /data/actions_confirmation/malaria_rapid_test  = 'no'"/>
      <bind nodeset="/data/data/_fever_presence" type="string" calculate="if( /data/fever_malaria_group/fever_presence  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_temperature" type="string" calculate="if( /data/fever_malaria_group/temperature  != '',  /data/fever_malaria_group/temperature , -1)"/>
      <bind nodeset="/data/data/_fever_duration" type="string" calculate="if( /data/fever_malaria_group/fever_duration  != '',  /data/fever_malaria_group/fever_duration , -1)"/>
      <bind nodeset="/data/data/_previous_fever" type="string" calculate="if( /data/fever_malaria_group/previous_fever  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_fever_recurrance" type="string" calculate="if( /data/fever_malaria_group/fever_recurrance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_malaria_symptoms" type="string" calculate="if( /data/fever_malaria_group/malaria_symptoms  != '',  /data/fever_malaria_group/malaria_symptoms , 'false')"/>
      <bind nodeset="/data/data/_rapid_test" type="string" calculate="if( /data/rapid_test_group/rapid_test  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_rapid_test_result" type="string" calculate="if( /data/rapid_test_group/rapid_test_result  != '',  /data/rapid_test_group/rapid_test_result , 'false')"/>
      <bind nodeset="/data/data/_result_risk_malaria" type="string" calculate="if( /data/calc_risk_malaria ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_malaria_positive" type="string" calculate="if( /data/calc_malaria_positive ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_malaria_negative" type="string" calculate="if( /data/calc_malaria_negative ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_malaria_rapid_test" type="string" calculate="if( /data/actions_confirmation/malaria_rapid_test  = 'yes', 1,  /data/actions_confirmation/malaria_rapid_test_other )"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;ADT_Form003_Fever&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/malaria_rapid_test_used_in_ADT_Form003_Fever" type="string" calculate="if( /data/actions_confirmation/malaria_rapid_test  = 'yes', 1, 0)"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/fever_malaria_group">
      <label ref="jr:itext('/data/fever_malaria_group:label')"/>
      <select1 ref="/data/fever_malaria_group/fever_presence">
        <label ref="jr:itext('/data/fever_malaria_group/fever_presence:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/fever_malaria_group/temperature">
        <label ref="jr:itext('/data/fever_malaria_group/temperature:label')"/>
      </input>
      <input ref="/data/fever_malaria_group/fever_duration">
        <label ref="jr:itext('/data/fever_malaria_group/fever_duration:label')"/>
      </input>
      <select1 ref="/data/fever_malaria_group/previous_fever">
        <label ref="jr:itext('/data/fever_malaria_group/previous_fever:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/fever_malaria_group/fever_recurrance">
        <label ref="jr:itext('/data/fever_malaria_group/fever_recurrance:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/fever_malaria_group/malaria_symptoms">
        <label ref="jr:itext('/data/fever_malaria_group/malaria_symptoms:label')"/>
        <itemset nodeset="instance('malaria_symptoms')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/rapid_test_group">
      <label ref="jr:itext('/data/rapid_test_group:label')"/>
      <select1 ref="/data/rapid_test_group/rapid_test">
        <label ref="jr:itext('/data/rapid_test_group/rapid_test:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/rapid_test_group/rapid_test_result">
        <label ref="jr:itext('/data/rapid_test_group/rapid_test_result:label')"/>
        <itemset nodeset="instance('positive_negative')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_malaria_positive" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_malaria_positive:label')"/>
      </input>
      <input ref="/data/results_group/res_malaria_positive_action">
        <label ref="jr:itext('/data/results_group/res_malaria_positive_action:label')"/>
      </input>
      <input ref="/data/results_group/res_malaria_negative" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_malaria_negative:label')"/>
      </input>
      <input ref="/data/results_group/res_malaria_negative_action">
        <label ref="jr:itext('/data/results_group/res_malaria_negative_action:label')"/>
      </input>
      <input ref="/data/results_group/res_malaria_unclear">
        <label ref="jr:itext('/data/results_group/res_malaria_unclear:label')"/>
      </input>
      <input ref="/data/results_group/res_malaria_unclear_action">
        <label ref="jr:itext('/data/results_group/res_malaria_unclear_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <input ref="/data/null_results_group/null_results_group_note" appearance="h1green">
        <label ref="jr:itext('/data/null_results_group/null_results_group_note:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select1 ref="/data/actions_confirmation/malaria_rapid_test">
        <label ref="jr:itext('/data/actions_confirmation/malaria_rapid_test:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/malaria_rapid_test_other">
        <label ref="jr:itext('/data/actions_confirmation/malaria_rapid_test_other:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>