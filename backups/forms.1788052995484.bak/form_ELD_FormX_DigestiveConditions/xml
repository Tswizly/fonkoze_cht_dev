<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Digestive Conditions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ELD_FormX_DigestiveConditions" version="20260829181617" prefix="J1!ELD_FormX_DigestiveConditions!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <digestive_conditions_group>
            <stool_consistency/>
            <stool_color/>
            <suspect_blood/>
            <mucus_in_stool/>
            <stool_frequency/>
            <time_of_last_stool/>
            <stool_symptom_duration/>
            <nausea/>
            <tenesmus/>
            <vomiting/>
            <epigastric_pain/>
            <pain_qualifiers/>
            <fever/>
            <temperature/>
            <fever_duration/>
            <reflux/>
            <reflux_frequency/>
            <weight_loss/>
            <abdomin_descriptors/>
          </digestive_conditions_group>
          <results_group>
            <calc_gastritis_serious/>
            <calc_gastritis_not_serious/>
            <calc_risk_of_cholera/>
            <calc_acute_diarrhea/>
            <calc_amoeba_giardia/>
            <res_gastritis_serious/>
            <res_gastritis_serious_action/>
            <res_gastritis_not_serious/>
            <res_gastritis_not_serious_action/>
            <res_risk_of_cholera/>
            <res_risk_of_cholera_action/>
            <res_acute_diarrhea/>
            <res_acute_diarrhea_action/>
            <res_amoeba_giardia/>
            <res_amoeba_giardia_action/>
          </results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="stool_consistency">
        <root>
          <item>
            <name>watery</name>
            <label>Watery</label>
          </item>
          <item>
            <name>regular</name>
            <label>Regular</label>
          </item>
          <item>
            <name>hard</name>
            <label>Hard</label>
          </item>
        </root>
      </instance>
      <instance id="stool_color">
        <root>
          <item>
            <name>greenish</name>
            <label>Greenish</label>
          </item>
          <item>
            <name>red</name>
            <label>Red</label>
          </item>
          <item>
            <name>blackish</name>
            <label>Blackish</label>
          </item>
          <item>
            <name>yellowish</name>
            <label>Yellowish</label>
          </item>
          <item>
            <name>gray_or_white</name>
            <label>Gray or white</label>
          </item>
        </root>
      </instance>
      <instance id="stool_frequency">
        <root>
          <item>
            <name>very_frequent</name>
            <label>Very frequent</label>
          </item>
          <item>
            <name>regular_frequent</name>
            <label>Regular frequent</label>
          </item>
          <item>
            <name>regular_constipated</name>
            <label>Regular constipated</label>
          </item>
          <item>
            <name>very_constipated</name>
            <label>Very constipated</label>
          </item>
        </root>
      </instance>
      <instance id="pain_qualifiers">
        <root>
          <item>
            <name>worse_at_night</name>
            <label>Worse at night</label>
          </item>
          <item>
            <name>worse_in_the_morning</name>
            <label>Worse in the morning</label>
          </item>
          <item>
            <name>better_after_eating</name>
            <label>Better after eating</label>
          </item>
          <item>
            <name>worse_after_eating</name>
            <label>Worse after eating</label>
          </item>
          <item>
            <name>cramping_pains</name>
            <label>Cramping pains</label>
          </item>
          <item>
            <name>stabbing_pains</name>
            <label>Stabbing pains</label>
          </item>
        </root>
      </instance>
      <instance id="abdomin_descriptors">
        <root>
          <item>
            <name>hard</name>
            <label>Hard</label>
          </item>
          <item>
            <name>painful_to_touch</name>
            <label>Painful to touch</label>
          </item>
          <item>
            <name>distended</name>
            <label>Distended</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/digestive_conditions_group/stool_consistency" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/stool_color" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/suspect_blood" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/mucus_in_stool" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/stool_frequency" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/time_of_last_stool" type="dateTime" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/stool_symptom_duration" type="int" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/nausea" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/tenesmus" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/vomiting" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/epigastric_pain" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/pain_qualifiers" type="string" relevant=" /data/digestive_conditions_group/epigastric_pain  = 'yes'"/>
      <bind nodeset="/data/digestive_conditions_group/fever" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/temperature" type="decimal" required="true()" relevant=" /data/digestive_conditions_group/fever  = 'yes'"/>
      <bind nodeset="/data/digestive_conditions_group/fever_duration" type="int" required="true()" relevant=" /data/digestive_conditions_group/fever  = 'yes'"/>
      <bind nodeset="/data/digestive_conditions_group/reflux" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/reflux_frequency" type="string" required="true()" relevant=" /data/digestive_conditions_group/reflux  = 'yes'"/>
      <bind nodeset="/data/digestive_conditions_group/weight_loss" type="string" required="true()"/>
      <bind nodeset="/data/digestive_conditions_group/abdomin_descriptors" type="string"/>
      <bind nodeset="/data/results_group/calc_gastritis_serious" type="string" calculate="if( ( /data/digestive_conditions_group/epigastric_pain  = 'yes' or selected( /data/digestive_conditions_group/pain_qualifiers , 'worse_at_night') or selected( /data/digestive_conditions_group/pain_qualifiers , 'better_after_eating') or  /data/digestive_conditions_group/reflux  = 'yes' or  /data/digestive_conditions_group/weight_loss  = 'yes') and ( /data/digestive_conditions_group/suspect_blood  = 'yes' or selected( /data/digestive_conditions_group/stool_color , 'red')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_gastritis_not_serious" type="string" calculate="if( ( /data/digestive_conditions_group/epigastric_pain  = 'yes' or selected( /data/digestive_conditions_group/pain_qualifiers , 'worse_at_night') or selected( /data/digestive_conditions_group/pain_qualifiers , 'better_after_eating') or  /data/digestive_conditions_group/reflux  = 'yes') and  /data/digestive_conditions_group/suspect_blood  = 'no' and not(selected( /data/digestive_conditions_group/stool_color , 'red')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_risk_of_cholera" type="string" calculate="if( selected( /data/digestive_conditions_group/stool_color , 'gray_or_white') and (selected( /data/digestive_conditions_group/stool_consistency , 'watery') or selected( /data/digestive_conditions_group/stool_frequency , 'very_frequent') or selected( /data/digestive_conditions_group/stool_frequency , 'regular_frequent')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_acute_diarrhea" type="string" calculate="if(  /data/digestive_conditions_group/stool_symptom_duration  &lt;= 7 and (selected( /data/digestive_conditions_group/stool_frequency , 'very_frequent') or selected( /data/digestive_conditions_group/stool_frequency , 'regular_frequent')) and selected( /data/digestive_conditions_group/stool_consistency , 'watery') and  /data/digestive_conditions_group/suspect_blood  = 'no' and  /data/digestive_conditions_group/mucus_in_stool  = 'no', 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_amoeba_giardia" type="string" calculate="if(  /data/digestive_conditions_group/stool_symptom_duration  &gt; 7 and (selected( /data/digestive_conditions_group/stool_frequency , 'very_frequent') or selected( /data/digestive_conditions_group/stool_frequency , 'regular_frequent')) and selected( /data/digestive_conditions_group/stool_consistency , 'watery') and ( /data/digestive_conditions_group/epigastric_pain  = 'yes' or selected( /data/digestive_conditions_group/pain_qualifiers , 'cramping_pains') or  /data/digestive_conditions_group/tenesmus  = 'yes' or  /data/digestive_conditions_group/suspect_blood  = 'yes' or  /data/digestive_conditions_group/mucus_in_stool  = 'yes'), 'true', 'false')"/>
      <bind nodeset="/data/results_group/res_gastritis_serious" readonly="true()" type="string" relevant=" /data/results_group/calc_gastritis_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis_serious_action" readonly="true()" type="string" relevant=" /data/results_group/calc_gastritis_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis_not_serious" readonly="true()" type="string" relevant=" /data/results_group/calc_gastritis_not_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis_not_serious_action" readonly="true()" type="string" relevant=" /data/results_group/calc_gastritis_not_serious  = 'true'"/>
      <bind nodeset="/data/results_group/res_risk_of_cholera" readonly="true()" type="string" relevant=" /data/results_group/calc_risk_of_cholera  = 'true'"/>
      <bind nodeset="/data/results_group/res_risk_of_cholera_action" readonly="true()" type="string" relevant=" /data/results_group/calc_risk_of_cholera  = 'true'"/>
      <bind nodeset="/data/results_group/res_acute_diarrhea" readonly="true()" type="string" relevant=" /data/results_group/calc_acute_diarrhea  = 'true'"/>
      <bind nodeset="/data/results_group/res_acute_diarrhea_action" readonly="true()" type="string" relevant=" /data/results_group/calc_acute_diarrhea  = 'true'"/>
      <bind nodeset="/data/results_group/res_amoeba_giardia" readonly="true()" type="string" relevant=" /data/results_group/calc_amoeba_giardia  = 'true'"/>
      <bind nodeset="/data/results_group/res_amoeba_giardia_action" readonly="true()" type="string" relevant=" /data/results_group/calc_amoeba_giardia  = 'true'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/digestive_conditions_group">
      <label>Digestive Conditions</label>
      <select ref="/data/digestive_conditions_group/stool_consistency">
        <label>What is the adults stool consistency?</label>
        <itemset nodeset="instance('stool_consistency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select ref="/data/digestive_conditions_group/stool_color">
        <label>What is the adults stool color?</label>
        <itemset nodeset="instance('stool_color')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/digestive_conditions_group/suspect_blood">
        <label>Does it appear that blood is in their stool?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/mucus_in_stool">
        <label>Is there mucus in the stool?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/stool_frequency">
        <label>What frequency is the adult pooping?</label>
        <itemset nodeset="instance('stool_frequency')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/digestive_conditions_group/time_of_last_stool">
        <label>When was the patient's most recent bowel movement?</label>
        <hint>If they are unsure, approximate to the best of their knowledge.</hint>
      </input>
      <input ref="/data/digestive_conditions_group/stool_symptom_duration">
        <label>How many days have the patients reported stool symptoms been occuring?</label>
        <hint>If they have not reported any symptoms, insert 0</hint>
      </input>
      <select1 ref="/data/digestive_conditions_group/nausea">
        <label>Is the adult experiencing nausea?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/tenesmus">
        <label>Is the adult experiencing tenesmus (sudden, immediate need to poop)?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/vomiting">
        <label>Is the adult vomitting?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/epigastric_pain">
        <label>Is the adult experiencing epigastric pain?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/digestive_conditions_group/pain_qualifiers">
        <label>Which of the following describes the patients pain?</label>
        <itemset nodeset="instance('pain_qualifiers')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/digestive_conditions_group/fever">
        <label>Does the adult have a fever?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/digestive_conditions_group/temperature">
        <label>What is the adults temperature?</label>
      </input>
      <input ref="/data/digestive_conditions_group/fever_duration">
        <label>How long has the adult had this fever?</label>
        <hint>Unit is days</hint>
      </input>
      <select1 ref="/data/digestive_conditions_group/reflux">
        <label>Is the adult experiencing reflux/pyrosis?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/reflux_frequency">
        <label>Does the adult often experience reflux / do they have GIRDS?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_conditions_group/weight_loss">
        <label>Has the adult experienced weight loss?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/digestive_conditions_group/abdomin_descriptors">
        <label>Look and feel the abdomen: is it hard, painful to touch, distended?</label>
        <itemset nodeset="instance('abdomin_descriptors')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_gastritis_serious">
        <label>Gastritis / Ulcer</label>
      </input>
      <input ref="/data/results_group/res_gastritis_serious_action">
        <label>Patient may have gastritis or an ulcer. 

Procedure:
-20 cc Litacid gel
-Omeprazole injectable – 40 mg IM
-Buscopan 20 mg IM
-Refer</label>
      </input>
      <input ref="/data/results_group/res_gastritis_not_serious">
        <label>Gastritis / Ulcer</label>
      </input>
      <input ref="/data/results_group/res_gastritis_not_serious_action">
        <label>Patient may have gastritis or an ulcer.

Procedure:
-Omeprazole 20 mg 2 times a day during 14 days
-Litacid gel 20 cc 30 minutes after the meal
-Dietary advice:
no spices, avoid fried foods and foods that trigger symptoms, carbonated drinks, coffee and salty food, eat frequent small meals, no meals after 6:00 pm, drink plenty of fluids even when no appetite
-Test for H. Pylori if recurrent.
If test positive: amoxycilline 500 mg 3 times per day, 14 days, metronidazole 500 mg 3 times per day</label>
      </input>
      <input ref="/data/results_group/res_risk_of_cholera">
        <label>Risk of Cholera</label>
      </input>
      <input ref="/data/results_group/res_risk_of_cholera_action">
        <label>If you are in an area with suspected Cholera, the patient may have Cholera. 

Procedure:
-IV fluid – Intracath/Ringer/Lactate
-Refer to the hospital or to a cholera treatment center with prepared ORS</label>
      </input>
      <input ref="/data/results_group/res_acute_diarrhea">
        <label>Acute Diarrhea</label>
      </input>
      <input ref="/data/results_group/res_acute_diarrhea_action">
        <label>Patient has acute diarrhea. 

Procedure:
-ORS</label>
      </input>
      <input ref="/data/results_group/res_amoeba_giardia">
        <label>Possible Amoeba or Giardia Infection</label>
      </input>
      <input ref="/data/results_group/res_amoeba_giardia_action">
        <label>Patient has a possible amoeba or giardia infection. 

Procedure: 
-Ideally: Tinidazole 500 mg, once a day 4 tablets during three days
-If not available or too expensive: metronidazole tablets, 500 mg, three times daily during 5 days</label>
      </input>
    </group>
  </h:body>
</h:html>