<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Stroke</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ELD_FormX_Stroke" version="20260829181617" prefix="J1!ELD_FormX_Stroke!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <stroke_assessment_group>
            <stroke_danger_signs/>
            <symptom_duration/>
            <hypertensive/>
            <hypertension_treatment/>
            <seen_clinician_previously/>
            <bp_systolic_first/>
            <bp_diastolic_first/>
            <bp_remeasure/>
            <bp_systolic_remeasure/>
            <bp_diastolic_remeasure/>
          </stroke_assessment_group>
          <results_group>
            <calc_transient_ischemic_attack/>
            <calc_stroke/>
            <calc_old_stroke/>
            <res_transient_ischemic_attack/>
            <res_transient_ischemic_attack_action/>
            <res_stroke/>
            <res_stroke_action/>
            <res_old_stroke/>
            <res_old_stroke_action/>
          </results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="stroke_danger_signs">
        <root>
          <item>
            <name>loss_of_motricity</name>
            <label>Loss of motricity</label>
          </item>
          <item>
            <name>facial_paralysis</name>
            <label>Facial paralysis</label>
          </item>
          <item>
            <name>altered_consciousness</name>
            <label>Altered consciousness</label>
          </item>
          <item>
            <name>vertigo</name>
            <label>Vertigo</label>
          </item>
          <item>
            <name>altered_speech</name>
            <label>Altered speech</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/stroke_assessment_group/stroke_danger_signs" type="string"/>
      <bind nodeset="/data/stroke_assessment_group/symptom_duration" type="int" required="true()" relevant="count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/hypertensive" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/hypertension_treatment" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/seen_clinician_previously" type="string" required="true()"/>
      <bind nodeset="/data/stroke_assessment_group/bp_systolic_first" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_diastolic_first" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_remeasure" type="string"/>
      <bind nodeset="/data/stroke_assessment_group/bp_systolic_remeasure" type="int" relevant=" /data/stroke_assessment_group/bp_remeasure  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/stroke_assessment_group/bp_diastolic_remeasure" type="int" relevant=" /data/stroke_assessment_group/bp_remeasure  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/results_group/calc_transient_ischemic_attack" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &lt;= 1 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_stroke" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &gt; 1 and  /data/stroke_assessment_group/symptom_duration  &lt;= 7 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_old_stroke" type="string" calculate="if( /data/stroke_assessment_group/symptom_duration  &gt; 7 and count-selected( /data/stroke_assessment_group/stroke_danger_signs ) &gt; 0, 'true', 'false')"/>
      <bind nodeset="/data/results_group/res_transient_ischemic_attack" readonly="true()" type="string" relevant=" /data/results_group/calc_transient_ischemic_attack  = 'true'"/>
      <bind nodeset="/data/results_group/res_transient_ischemic_attack_action" readonly="true()" type="string" relevant=" /data/results_group/calc_transient_ischemic_attack  = 'true'"/>
      <bind nodeset="/data/results_group/res_stroke" readonly="true()" type="string" relevant=" /data/results_group/calc_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_stroke_action" readonly="true()" type="string" relevant=" /data/results_group/calc_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_old_stroke" readonly="true()" type="string" relevant=" /data/results_group/calc_old_stroke  = 'true'"/>
      <bind nodeset="/data/results_group/res_old_stroke_action" readonly="true()" type="string" relevant=" /data/results_group/calc_old_stroke  = 'true'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/stroke_assessment_group">
      <label>Stroke Assessment</label>
      <select ref="/data/stroke_assessment_group/stroke_danger_signs">
        <label>List of stroke danger signs</label>
        <itemset nodeset="instance('stroke_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <input ref="/data/stroke_assessment_group/symptom_duration">
        <label>How long have these symptoms been happening, in days?</label>
      </input>
      <select1 ref="/data/stroke_assessment_group/hypertensive">
        <label>Is the patient hypertensive?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/stroke_assessment_group/hypertension_treatment">
        <label>Does the patient take hypertension medication?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/stroke_assessment_group/seen_clinician_previously">
        <label>Has the patient gone to doctor or the clinic to seek treatment for this before?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/stroke_assessment_group/bp_systolic_first">
        <label>Measured systolic BP</label>
      </input>
      <input ref="/data/stroke_assessment_group/bp_diastolic_first">
        <label>Measured diastolic BP</label>
      </input>
      <select1 ref="/data/stroke_assessment_group/bp_remeasure">
        <label>Does BP need to be remeasured</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/stroke_assessment_group/bp_systolic_remeasure">
        <label>Measured systolic BP for second measurement</label>
      </input>
      <input ref="/data/stroke_assessment_group/bp_diastolic_remeasure">
        <label>Measured diastolic BP for second measurement</label>
      </input>
    </group>
    <group appearance="field-list" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_transient_ischemic_attack">
        <label>Transient Ischemic Attack</label>
      </input>
      <input ref="/data/results_group/res_transient_ischemic_attack_action">
        <label>The patient may have had a transient ischemic attack.

Protocol:
-Control BP
-Treat hypertension
-Refer</label>
      </input>
      <input ref="/data/results_group/res_stroke">
        <label>Stroke</label>
      </input>
      <input ref="/data/results_group/res_stroke_action">
        <label>The patient has had a stroke.

Protocol:
-Control BP
-Treat hypertension
-Refer</label>
      </input>
      <input ref="/data/results_group/res_old_stroke">
        <label>Old Stroke</label>
      </input>
      <input ref="/data/results_group/res_old_stroke_action">
        <label>The patient has had a stroke at some point.

Protocol:
-Counseling on mobilization and need for exercise (produce small leaflets with basic exercices)
-Treat hypertension to prevent new strokes</label>
      </input>
    </group>
  </h:body>
</h:html>