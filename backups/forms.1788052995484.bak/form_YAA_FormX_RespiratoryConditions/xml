<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Youth Respiratory Conditions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="YAA_FormX_RespiratoryConditions" version="20260829181613" prefix="J1!YAA_FormX_RespiratoryConditions!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <respiratory_assessment>
            <fever_presence/>
            <patient_temperature/>
            <fever_duration/>
            <extended_fever_duration/>
            <oxygen_saturation/>
            <breathing_rate/>
            <cough_presence/>
            <cough_duration/>
            <cough_danger_signs/>
            <runny_nose/>
            <poor_appetite/>
            <sore_throat/>
            <throat_appearance/>
          </respiratory_assessment>
          <results_group>
            <calc_flu_like_syndrome/>
            <calc_pneumonia_pink/>
            <calc_pneumonia_yellow/>
            <calc_tonsillitis/>
            <res_flu_like_syndrome/>
            <res_flu_like_syndrome_action/>
            <res_pneumonia_pink/>
            <res_pneumonia_pink_action/>
            <res_pneumonia_yellow/>
            <res_pneumonia_yellow_action/>
            <res_tonsillitis/>
            <res_tonsillitis_action/>
          </results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="cough_danger_signs">
        <root>
          <item>
            <name>chest_indrawing</name>
            <label>Chest indrawing</label>
          </item>
          <item>
            <name>stridor</name>
            <label>Stridor</label>
          </item>
          <item>
            <name>wheezing</name>
            <label>Wheezing</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/respiratory_assessment/fever_presence" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/patient_temperature" type="decimal" relevant=" /data/respiratory_assessment/fever_presence  = 'yes'" constraint=". &gt;= 90 and . &lt;= 100"/>
      <bind nodeset="/data/respiratory_assessment/fever_duration" type="int" relevant=" /data/respiratory_assessment/fever_presence  = 'yes'" constraint=". &lt;= 99"/>
      <bind nodeset="/data/respiratory_assessment/extended_fever_duration" type="string" relevant=" /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/fever_duration  &gt;= 7"/>
      <bind nodeset="/data/respiratory_assessment/oxygen_saturation" type="decimal" constraint=". &lt;= 100"/>
      <bind nodeset="/data/respiratory_assessment/breathing_rate" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_assessment/cough_presence" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/cough_duration" type="int" relevant=" /data/respiratory_assessment/cough_presence  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_assessment/cough_danger_signs" type="string" relevant=" /data/respiratory_assessment/cough_presence  = 'yes'"/>
      <bind nodeset="/data/respiratory_assessment/runny_nose" type="string"/>
      <bind nodeset="/data/respiratory_assessment/poor_appetite" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/sore_throat" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/throat_appearance" type="string" relevant=" /data/respiratory_assessment/sore_throat  = 'yes'"/>
      <bind nodeset="/data/results_group/calc_flu_like_syndrome" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/runny_nose  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and  /data/respiratory_assessment/poor_appetite  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_pneumonia_pink" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and ( /data/respiratory_assessment/oxygen_saturation  &lt; 95 or selected( /data/respiratory_assessment/cough_danger_signs , 'chest_indrawing') or selected( /data/respiratory_assessment/cough_danger_signs , 'stridor') or selected( /data/respiratory_assessment/cough_danger_signs , 'wheezing')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_pneumonia_yellow" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and  /data/respiratory_assessment/oxygen_saturation  &gt;= 95 and not(selected( /data/respiratory_assessment/cough_danger_signs , 'chest_indrawing') or selected( /data/respiratory_assessment/cough_danger_signs , 'stridor') or selected( /data/respiratory_assessment/cough_danger_signs , 'wheezing')), 'true', 'false')"/>
      <bind nodeset="/data/results_group/calc_tonsillitis" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/sore_throat  = 'yes' and  /data/respiratory_assessment/throat_appearance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome" readonly="true()" type="string" relevant=" /data/results_group/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome_action" readonly="true()" type="string" relevant=" /data/results_group/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_pink" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia_pink  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_pink_action" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia_pink  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_yellow" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia_yellow  = 'true' and  /data/results_group/calc_pneumonia_pink  != 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_yellow_action" readonly="true()" type="string" relevant=" /data/results_group/calc_pneumonia_yellow  = 'true' and  /data/results_group/calc_pneumonia_pink  != 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis" readonly="true()" type="string" relevant=" /data/results_group/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis_action" readonly="true()" type="string" relevant=" /data/results_group/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_assessment">
      <label>Respiratory Assessment</label>
      <select1 ref="/data/respiratory_assessment/fever_presence">
        <label>Does the youth have a fever?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/patient_temperature">
        <label>Patient temperature</label>
      </input>
      <input ref="/data/respiratory_assessment/fever_duration">
        <label>Fever duration (days)</label>
      </input>
      <select1 ref="/data/respiratory_assessment/extended_fever_duration">
        <label>Has the fever been present every day?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/oxygen_saturation">
        <label>Oxygen saturation</label>
      </input>
      <input ref="/data/respiratory_assessment/breathing_rate">
        <label>Breathing rate</label>
      </input>
      <select1 ref="/data/respiratory_assessment/cough_presence">
        <label>Is the youth coughing or having difficulty breathing?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/cough_duration">
        <label>How long has the youth been coughing, in days?</label>
      </input>
      <select ref="/data/respiratory_assessment/cough_danger_signs">
        <label>Which of the following coughing danger signs does the youth exhibit, if any?</label>
        <itemset nodeset="instance('cough_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/respiratory_assessment/runny_nose">
        <label>Does the youth have a runny nose?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/poor_appetite">
        <label>Does the youth have a poor appetite?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/sore_throat">
        <label>Does the youth have a sore throat?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/throat_appearance">
        <label>Does the throat appear red, swollen, covered in pus?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_flu_like_syndrome" appearance="h1 yellow">
        <label>FLU LIKE SYNDROME</label>
      </input>
      <input ref="/data/results_group/res_flu_like_syndrome_action">
        <label>The youth has flu like syndrome.

Procedure:
- Combined anti flue medication ½ to 1 co three times per day.
- Amoxicillin if green nasal discharge – 500 mg tablets two (under 10) to three times per day</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink" appearance="h1 red">
        <label>PNEUMONIA (Severe)</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink_action">
        <label>The youth has severe pneumonia.

Procedure:
- Antipyretic injectable
- Metamizol 500 mg/mL injectable solution, one injection IntraMuscular</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow" appearance="h1 yellow">
        <label>PNEUMONIA</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow_action">
        <label>The youth has pneumonia.

Procedure:
- Amoxycilline tablets 500 mg 3 times per day for 7 days
- Acetaminophen</label>
      </input>
      <input ref="/data/results_group/res_tonsillitis" appearance="h1 yellow">
        <label>TONSILLITIS</label>
      </input>
      <input ref="/data/results_group/res_tonsillitis_action">
        <label>The youth has tonsillitis.

Procedure:
- Acetaminophen
- Amoxicillin 500 mg 3 times per day for 5 days</label>
      </input>
    </group>
  </h:body>
</h:html>