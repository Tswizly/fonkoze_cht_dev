      <bind nodeset="/data/incidence_report/incident_category" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/incident_category_other" type="string" required="true()" relevant=" /data/incidence_report/incident_category  = 'other'"/>
      <bind nodeset="/data/incidence_report/clinical_incident_type" type="string" required="true()" relevant=" /data/incidence_report/incident_category  = 'clinical_safety' or  /data/incidence_report/incident_category  = 'needlestick_exposure'"/>
      <bind nodeset="/data/incidence_report/incident_severity" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/incident_description" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/environmental_contributing_factors" type="string" required="false()"/>
      <bind nodeset="/data/incidence_report/persons_involved" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/persons_involved_other" type="string" required="true()" relevant="selected( /data/incidence_report/persons_involved , 'other')"/>
      <bind nodeset="/data/incidence_report/witness_names_contacts" type="string" required="false()"/>
      <bind nodeset="/data/incidence_report/any_injuries" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/injury_details" type="string" required="true()" relevant=" /data/incidence_report/any_injuries  = 'yes'"/>
      <bind nodeset="/data/incidence_report/biohazard_exposure" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/pep_initiated" type="string" required="true()" relevant=" /data/incidence_report/biohazard_exposure  = 'yes'"/>
      <bind nodeset="/data/incidence_report/pep_initiation_time" type="dateTime" required="false()" relevant=" /data/incidence_report/biohazard_exposure  = 'yes' and  /data/incidence_report/pep_initiated  = 'started'"/>
      <bind nodeset="/data/incidence_report/immediate_actions_taken" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/police_reported" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/police_report_reference" type="string" required="false()" relevant=" /data/incidence_report/police_reported  = 'yes'"/>
      <bind nodeset="/data/incidence_report/supervisor_notified" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/supervisor_contact_method" type="string" required="true()" relevant=" /data/incidence_report/supervisor_notified  = 'yes'"/>
      <bind nodeset="/data/incidence_report/support_needed" type="string" required="true()"/>
      <bind nodeset="/data/incidence_report/support_needed_other" type="string" required="true()" relevant="selected( /data/incidence_report/support_needed , 'other')"/>
      <bind nodeset="/data/incidence_report/report_submission_note" readonly="true()" type="string" required="false()"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/incidence_report">
      <label ref="jr:itext('/data/incidence_report:label')"/>
      <input ref="/data/incidence_report/incident_date_time">
        <label ref="jr:itext('/data/incidence_report/incident_date_time:label')"/>
        <hint>When did the incident occur?</hint>
      </input>
      <select1 ref="/data/incidence_report/incident_location_type">
        <label ref="jr:itext('/data/incidence_report/incident_location_type:label')"/>
        <hint>Select the primary setting where the incident took place</hint>
        <itemset nodeset="instance('incident_location')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/incident_location_other">
        <label ref="jr:itext('/data/incidence_report/incident_location_other:label')"/>
        <hint>Provide details about where the incident occurred</hint>
      </input>
      <input ref="/data/incidence_report/incident_address_details">
        <label ref="jr:itext('/data/incidence_report/incident_address_details:label')"/>
        <hint>Include street name, community zone, landmark, or room/facility section</hint>
      </input>
      <select1 ref="/data/incidence_report/incident_category">
        <label ref="jr:itext('/data/incidence_report/incident_category:label')"/>
        <hint>Select the primary nature of the incident</hint>
        <itemset nodeset="instance('incident_category')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/incident_category_other">
        <label ref="jr:itext('/data/incidence_report/incident_category_other:label')"/>
        <hint>Briefly describe the nature of this incident</hint>
      </input>
      <select1 ref="/data/incidence_report/clinical_incident_type">
        <label ref="jr:itext('/data/incidence_report/clinical_incident_type:label')"/>
        <hint>Select the specific clinical issue encountered</hint>
        <itemset nodeset="instance('incident_subcategory_clinical')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/incidence_report/incident_severity">
        <label ref="jr:itext('/data/incidence_report/incident_severity:label')"/>
        <hint>Assess the overall severity and immediate operational impact</hint>
        <itemset nodeset="instance('severity_level')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/incident_description" appearance="multiline">
        <label ref="jr:itext('/data/incidence_report/incident_description:label')"/>
        <hint>Describe the events leading up to, during, and immediately following the incident</hint>
      </input>
      <input ref="/data/incidence_report/environmental_contributing_factors" appearance="multiline">
        <label ref="jr:itext('/data/incidence_report/environmental_contributing_factors:label')"/>
        <hint>Note any situational or physical conditions that contributed to the incident</hint>
      </input>
      <select ref="/data/incidence_report/persons_involved">
        <label ref="jr:itext('/data/incidence_report/persons_involved:label')"/>
        <hint>Select all that apply</hint>
        <itemset nodeset="instance('persons_involved')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/incidence_report/persons_involved_other">
        <label ref="jr:itext('/data/incidence_report/persons_involved_other:label')"/>
        <hint>Provide names or roles of other persons involved</hint>
      </input>
      <input ref="/data/incidence_report/witness_names_contacts" appearance="multiline">
        <label ref="jr:itext('/data/incidence_report/witness_names_contacts:label')"/>
        <hint>List any staff, patients, or community members who witnessed the incident</hint>
      </input>
      <select1 ref="/data/incidence_report/any_injuries">
        <label ref="jr:itext('/data/incidence_report/any_injuries:label')"/>
        <hint>Record whether anyone suffered physical harm or injury</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/injury_details" appearance="multiline">
        <label ref="jr:itext('/data/incidence_report/injury_details:label')"/>
        <hint>Detail who was injured, severity of injury, and first aid or medical care provided</hint>
      </input>
      <select1 ref="/data/incidence_report/biohazard_exposure">
        <label ref="jr:itext('/data/incidence_report/biohazard_exposure:label')"/>
        <hint>Includes needlestick, splash to mucous membranes, or non-intact skin contact</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/incidence_report/pep_initiated">
        <label ref="jr:itext('/data/incidence_report/pep_initiated:label')"/>
        <hint>PEP must be evaluated and initiated within 72 hours for potential HIV/HBV exposure</hint>
        <itemset nodeset="instance('pep_status')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/pep_initiation_time">
        <label ref="jr:itext('/data/incidence_report/pep_initiation_time:label')"/>
        <hint>Record time of clinical evaluation or PEP medication dispensing</hint>
      </input>
      <input ref="/data/incidence_report/immediate_actions_taken" appearance="multiline">
        <label ref="jr:itext('/data/incidence_report/immediate_actions_taken:label')"/>
        <hint>Evacuation, de-escalation, calling security, locking doors, securing medication/assets</hint>
      </input>
      <select1 ref="/data/incidence_report/police_reported">
        <label ref="jr:itext('/data/incidence_report/police_reported:label')"/>
        <hint>Record whether law enforcement or community authorities were engaged</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/incidence_report/police_report_reference">
        <label ref="jr:itext('/data/incidence_report/police_report_reference:label')"/>
        <hint>Enter report reference number or authority details</hint>
      </input>
      <select1 ref="/data/incidence_report/supervisor_notified">
        <label ref="jr:itext('/data/incidence_report/supervisor_notified:label')"/>
        <hint>Immediate supervisor notification is required within 2 hours of incident</hint>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/incidence_report/supervisor_contact_method">
        <label ref="jr:itext('/data/incidence_report/supervisor_contact_method:label')"/>
        <hint>Select primary communication channel used</hint>
        <itemset nodeset="instance('supervisor_contact_method')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/incidence_report/support_needed">
        <label ref="jr:itext('/data/incidence_report/support_needed:label')"/>
        <hint>Select all forms of assistance needed</hint>
        <itemset nodeset="instance('support_needed')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <input ref="/data/incidence_report/support_needed_other">
        <label ref="jr:itext('/data/incidence_report/support_needed_other:label')"/>
        <hint>Describe specific resource, security, or clinical need</hint>
      </input>
      <input ref="/data/incidence_report/report_submission_note">
        <label ref="jr:itext('/data/incidence_report/report_submission_note:label')"/>
      </input>
    </group>
  </h:body>
</h:html>