      <input ref="/data/results_group/res_uti" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_uti:label')"/>
      </input>
      <input ref="/data/results_group/res_uti_action">
        <label ref="jr:itext('/data/results_group/res_uti_action:label')"/>
      </input>
      <input ref="/data/results_group/res_std_discharge" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_std_discharge:label')"/>
      </input>
      <input ref="/data/results_group/res_std_discharge_action">
        <label ref="jr:itext('/data/results_group/res_std_discharge_action:label')"/>
      </input>
      <input ref="/data/results_group/res_std_ulcer" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_std_ulcer:label')"/>
      </input>
      <input ref="/data/results_group/res_std_ulcer_action">
        <label ref="jr:itext('/data/results_group/res_std_ulcer_action:label')"/>
      </input>
      <input ref="/data/results_group/res_prostate_concerns" appearance="h1 red">
