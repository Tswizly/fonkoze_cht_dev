      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/doxycicline_100mg_tablets_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/doxycicline_100mg_tablets_used_in_ELD_Form009_UTIandSTD" type="string" calculate=" /data/prescription_summary/fields/doxycicline_100mg_tablets___set  * X +  /data/prescription_summary/fields/doxycicline_100mg_tablets___unit "/>
      <bind nodeset="/data/prescription_summary/fields/benzatine_penicillin_2_4_mio_units_used_in_ELD_Form009_UTIandSTD" type="string" calculate=" /data/actions_confirmation/benzatine_penicillin_2_4_mio_units "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
