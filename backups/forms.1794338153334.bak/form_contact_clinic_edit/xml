      <bind nodeset="/data/inputs" relevant="false()"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/user/name" type="string"/>
      <bind nodeset="/data/clinic/parent" type="string" readonly="true()"/>
      <bind nodeset="/data/clinic/type" type="string" readonly="true()"/>
      <bind nodeset="/data/clinic/contact/name" type="string"/>
      <bind nodeset="/data/clinic/contact/contact_name" type="string" calculate="../name"/>
      <bind nodeset="/data/clinic/contact/_id" type="string"/>
      <bind nodeset="/data/clinic/is_name_generated" type="string" required="true()" relevant="not( /data/clinic/contact/_id ) or selected( . , 'true') or boolean( /data/clinic/contact/_id )" readonly="boolean( /data/clinic/contact/_id )" calculate="if(  /data/clinic/generated_name  = ../name, 'true', 'false')"/>
      <bind nodeset="/data/clinic/generated_name" type="string" calculate=" /data/init/generated_name_translation "/>
      <bind nodeset="/data/clinic/name" type="string" required="true()" relevant="boolean( /data/clinic/contact/_id ) or not( /data/clinic/contact/_id ) or not(selected( /data/clinic/is_name_generated , 'true')) or not(selected( /data/clinic/is_name_generated , 'yes'))" calculate="if( ( selected( /data/clinic/is_name_generated , 'true') or selected( /data/clinic/is_name_generated , 'yes') ),  /data/clinic/generated_name , .)"/>
      <bind nodeset="/data/clinic/external_id" type="string"/>
      <bind nodeset="/data/clinic/notes" type="string"/>
      <bind nodeset="/data/clinic/geolocation" type="string" calculate="concat(../../inputs/meta/location/lat, concat(' ', ../../inputs/meta/location/long))"/>
      <bind nodeset="/data/clinic/meta/created_by" type="string" readonly="true()"/>
      <bind nodeset="/data/clinic/meta/created_by_person_uuid" type="string" readonly="true()"/>
      <bind nodeset="/data/clinic/meta/created_by_place_uuid" type="string"/>
      <bind nodeset="/data/clinic/meta/last_edited_by" type="string" calculate="../../../inputs/user/name"/>
      <bind nodeset="/data/clinic/meta/last_edited_by_person_uuid" type="string" calculate="../../../inputs/user/contact_id"/>
      <bind nodeset="/data/clinic/meta/last_edited_by_place_uuid" type="string" calculate="../../../inputs/user/facility_id"/>
      <bind nodeset="/data/init/place_type" type="string" calculate="&quot;clinic&quot;"/>
      <bind nodeset="/data/init/place_type_translation" type="string" calculate="jr:choice-name( /data/init/place_type ,' /data/init/place_type ')"/>
      <bind nodeset="/data/init/select_generated_name" type="string" calculate="&quot;clinic&quot;"/>
      <bind nodeset="/data/init/generated_name_translation" type="string" calculate="if (boolean( /data/clinic/contact/_id ), jr:choice-name( /data/init/select_generated_name ,' /data/init/select_generated_name '), '')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/data/inputs">
      <group ref="/data/inputs/user">
        <input ref="/data/inputs/user/contact_id"/>
        <input ref="/data/inputs/user/facility_id"/>
        <input ref="/data/inputs/user/name"/>
      </group>
    </group>
    <group appearance="field-list" ref="/data/clinic">
      <group ref="/data/clinic/contact">
        <input ref="/data/clinic/contact/name" appearance="hidden"/>
        <input ref="/data/clinic/contact/_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/clinic/contact/_id:label')"/>
          <hint ref="jr:itext('/data/clinic/contact/_id:hint')"/>
        </input>
      </group>
      <select1 ref="/data/clinic/is_name_generated" appearance="columns-pack">
        <label ref="jr:itext('/data/clinic/is_name_generated:label')"/>
        <itemset nodeset="instance('yes_no_generated_name')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/clinic/name">
        <label ref="jr:itext('/data/clinic/name:label')"/>
      </input>
      <input ref="/data/clinic/external_id">
        <label ref="jr:itext('/data/clinic/external_id:label')"/>
      </input>
      <input ref="/data/clinic/notes" appearance="multiline">
        <label ref="jr:itext('/data/clinic/notes:label')"/>
      </input>
      <group appearance="hidden" ref="/data/clinic/meta"/>
    </group>
    <group appearance="field-list hidden" ref="/data/init">
      <select1 ref="/data/init/place_type" appearance="hidden">
        <itemset nodeset="instance('place_type')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/init/select_generated_name" appearance="hidden">
        <itemset nodeset="instance('generated_name')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
  </h:body>
</h:html>