      <bind nodeset="/data/data/_acetaminophen_oral_suspension_120mg_5ml" type="string" calculate="if( /data/actions_confirmation/acetaminophen_oral_suspension_120mg_5ml  != '',  /data/actions_confirmation/acetaminophen_oral_suspension_120mg_5ml , -1)"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;YAA_Form002_RespiratoryConditions&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/combined_anti_flue_medication_used_in" type="string" calculate=" /data/actions_confirmation/combined_anti_flue_medication "/>
      <bind nodeset="/data/prescription_summary/fields/combined_anti_flue_medication___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/combined_anti_flue_medication_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/combined_anti_flue_medication___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/combined_anti_flue_medication_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/combined_anti_flue_medication_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/combined_anti_flue_medication_used_in_YAA_Form002_RespiratoryConditions" type="string" calculate=" /data/prescription_summary/fields/combined_anti_flue_medication___set  * 10 +  /data/prescription_summary/fields/combined_anti_flue_medication___unit "/>
      <bind nodeset="/data/prescription_summary/fields/amoxycillin_500mg_used_in" type="string" calculate=" /data/actions_confirmation/amoxycillin_500mg "/>
      <bind nodeset="/data/prescription_summary/fields/amoxycillin_500mg___set" type="string" calculate="if(count-selected( /data/prescription_summary/fields/amoxycillin_500mg_used_in ) &gt; 0 and count-selected(substring-before( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-before( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-before( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/amoxycillin_500mg___unit" type="string" calculate="if(count-selected( /data/prescription_summary/fields/amoxycillin_500mg_used_in ) &gt; 0 and count-selected(substring-after( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;)) &gt;= 0 and regex(substring-after( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;), '^[0-9]+$'),number(substring-after( /data/prescription_summary/fields/amoxycillin_500mg_used_in , &quot;/&quot;)),0)"/>
      <bind nodeset="/data/prescription_summary/fields/amoxycillin_500mg_used_in_YAA_Form002_RespiratoryConditions" type="string" calculate=" /data/prescription_summary/fields/amoxycillin_500mg___set  * 10 +  /data/prescription_summary/fields/amoxycillin_500mg___unit "/>
      <bind nodeset="/data/prescription_summary/fields/metamizol_500mg_ml_injectable_used_in_YAA_Form002_RespiratoryConditions" type="string" calculate="if( /data/actions_confirmation/metamizol_500mg_ml_injectable  = 'yes', 1, 0)"/>
      <bind nodeset="/data/prescription_summary/fields/acetaminophen_oral_suspension_120mg_5ml_used_in_YAA_Form002_RespiratoryConditions" type="string" calculate=" /data/actions_confirmation/acetaminophen_oral_suspension_120mg_5ml "/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_assessment">
      <label ref="jr:itext('/data/respiratory_assessment:label')"/>
      <select1 ref="/data/respiratory_assessment/fever_presence">
        <label ref="jr:itext('/data/respiratory_assessment/fever_presence:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/patient_temperature">
        <label ref="jr:itext('/data/respiratory_assessment/patient_temperature:label')"/>
        <hint ref="jr:itext('/data/respiratory_assessment/patient_temperature:hint')"/>
      </input>
      <input ref="/data/respiratory_assessment/fever_duration">
        <label ref="jr:itext('/data/respiratory_assessment/fever_duration:label')"/>
      </input>
      <select1 ref="/data/respiratory_assessment/extended_fever_duration">
        <label ref="jr:itext('/data/respiratory_assessment/extended_fever_duration:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/oxygen_saturation">
        <label ref="jr:itext('/data/respiratory_assessment/oxygen_saturation:label')"/>
      </input>
      <input ref="/data/respiratory_assessment/breathing_rate">
        <label ref="jr:itext('/data/respiratory_assessment/breathing_rate:label')"/>
      </input>
      <select1 ref="/data/respiratory_assessment/cough_presence">
        <label ref="jr:itext('/data/respiratory_assessment/cough_presence:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/cough_duration">
        <label ref="jr:itext('/data/respiratory_assessment/cough_duration:label')"/>
      </input>
      <select ref="/data/respiratory_assessment/cough_danger_signs">
        <label ref="jr:itext('/data/respiratory_assessment/cough_danger_signs:label')"/>
        <itemset nodeset="instance('cough_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/respiratory_assessment/runny_nose">
        <label ref="jr:itext('/data/respiratory_assessment/runny_nose:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/poor_appetite">
        <label ref="jr:itext('/data/respiratory_assessment/poor_appetite:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/sore_throat">
        <label ref="jr:itext('/data/respiratory_assessment/sore_throat:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/throat_appearance">
        <label ref="jr:itext('/data/respiratory_assessment/throat_appearance:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_flu_like_syndrome" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome:label')"/>
      </input>
      <input ref="/data/results_group/res_flu_like_syndrome_action">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_pneumonia_pink:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink_action">
        <label ref="jr:itext('/data/results_group/res_pneumonia_pink_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_pneumonia_yellow:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow_action">
        <label ref="jr:itext('/data/results_group/res_pneumonia_yellow_action:label')"/>
      </input>
      <input ref="/data/results_group/res_tonsillitis" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_tonsillitis:label')"/>
      </input>
      <input ref="/data/results_group/res_tonsillitis_action">
        <label ref="jr:itext('/data/results_group/res_tonsillitis_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/res_null" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/res_null:label')"/>
      </input>
    </group>
    <group appearance="field-list" ref="/data/actions_confirmation">
      <label ref="jr:itext('/data/actions_confirmation:label')"/>
      <select ref="/data/actions_confirmation/followed_up_conditions">
        <label ref="jr:itext('/data/actions_confirmation/followed_up_conditions:label')"/>
        <itemset nodeset="instance('followed_up_conditions')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/actions_confirmation/referal">
        <label ref="jr:itext('/data/actions_confirmation/referal:label')"/>
        <itemset nodeset="instance('referal_locations')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/combined_anti_flue_medication">
        <label ref="jr:itext('/data/actions_confirmation/combined_anti_flue_medication:label')"/>
      </input>
      <select1 ref="/data/actions_confirmation/metamizol_500mg_ml_injectable">
        <label ref="jr:itext('/data/actions_confirmation/metamizol_500mg_ml_injectable:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/actions_confirmation/amoxycillin_500mg">
        <label ref="jr:itext('/data/actions_confirmation/amoxycillin_500mg:label')"/>
      </input>
      <input ref="/data/actions_confirmation/acetaminophen_oral_suspension_120mg_5ml">
        <label ref="jr:itext('/data/actions_confirmation/acetaminophen_oral_suspension_120mg_5ml:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
    <group appearance="field-list summary" ref="/data/prescription_summary">
      <group ref="/data/prescription_summary/contact"/>
      <group ref="/data/prescription_summary/fields">
        <input ref="/data/prescription_summary/fields/Medicine_out" appearance="hidden"/>
      </group>
    </group>
  </h:body>
</h:html>