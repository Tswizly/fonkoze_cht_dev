<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Select Forms</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="GEN.Form001.FormSelect" version="20260907121542" prefix="J1!GEN.Form001.FormSelect!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <select_form>
            <forms_elderly/>
            <forms_adults/>
            <forms_youths/>
            <forms_children/>
          </select_form>
          <route_digestive/>
          <route_fever/>
          <route_hypertension/>
          <route_pregnancy/>
          <route_respiratory/>
          <route_skin/>
          <route_stroke/>
          <route_uti_std/>
          <route_wound/>
          <route_vision/>
          <route_diabetes/>
          <route_chronic_pain/>
          <route_vaccinations/>
          <summary_group>
            <note_diabetes/>
            <note_digestive/>
            <note_fever/>
            <note_hypertension/>
            <note_pregnancy/>
            <note_respiratory/>
            <note_skin/>
            <note_stroke/>
            <note_uti_std/>
            <note_wound/>
            <note_vision/>
            <note_chronic_pain/>
            <note_vaccinations/>
            <note_tasks_will_appear/>
            <note_no_forms/>
          </summary_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="forms_adult">
        <root>
          <item>
            <name>adt_diabetes</name>
            <label>Diabetes Screening</label>
          </item>
          <item>
            <name>adt_digestive</name>
            <label>Digestive Conditions Screening</label>
          </item>
          <item>
            <name>adt_fever</name>
            <label>Fever and/or Malaria Screening</label>
          </item>
          <item>
            <name>adt_hypertension</name>
            <label>Hypertension / Cardiovascular Event Screening</label>
          </item>
          <item>
            <name>adt_pregnancy</name>
            <label>Pregnancy Registration, Follow Up, or Emergency Condition</label>
          </item>
          <item>
            <name>adt_respiratory</name>
            <label>Respiratory Conditions Screening</label>
          </item>
          <item>
            <name>adt_skin</name>
            <label>Skin Conditions Screening</label>
          </item>
          <item>
            <name>adt_stroke</name>
            <label>Stroke Screening</label>
          </item>
          <item>
            <name>adt_vision</name>
            <label>Vision Screening</label>
          </item>
          <item>
            <name>adt_uti</name>
            <label>UTI and STD Screening</label>
          </item>
          <item>
            <name>adt_wound</name>
            <label>Wound Care</label>
          </item>
        </root>
      </instance>
      <instance id="forms_child">
        <root>
          <item>
            <name>chd_digestive</name>
            <label>Digestive Conditions Screening</label>
          </item>
          <item>
            <name>chd_respiratory</name>
            <label>Respiratory Conditions Screening</label>
          </item>
          <item>
            <name>chd_skin</name>
            <label>Skin Conditions Screening</label>
          </item>
          <item>
            <name>chd_wound</name>
            <label>Wound Care</label>
          </item>
          <item>
            <name>chd_vision</name>
            <label>Vision Screening</label>
          </item>
          <item>
            <name>chd_vac</name>
            <label>Vaccination and Deworming</label>
          </item>
        </root>
      </instance>
      <instance id="forms_youth">
        <root>
          <item>
            <name>yaa_digestive</name>
            <label>Digestive Conditions Screening</label>
          </item>
          <item>
            <name>yaa_respiratory</name>
            <label>Respiratory Conditions Screening</label>
          </item>
          <item>
            <name>yaa_skin</name>
            <label>Skin Conditions Screening</label>
          </item>
          <item>
            <name>yaa_vision</name>
            <label>Vision Screening</label>
          </item>
          <item>
            <name>yaa_uti</name>
            <label>UTI and STD Screening</label>
          </item>
          <item>
            <name>yaa_wound</name>
            <label>Wound Care</label>
          </item>
        </root>
      </instance>
      <instance id="forms_elderly">
        <root>
          <item>
            <name>eld_chronic_pain</name>
            <label>Chronic Pain Screening</label>
          </item>
          <item>
            <name>eld_diabetes</name>
            <label>Diabetes Screening</label>
          </item>
          <item>
            <name>eld_digestive</name>
            <label>Digestive Conditions Screening</label>
          </item>
          <item>
            <name>eld_fever</name>
            <label>Fever and/or Malaria Screening</label>
          </item>
          <item>
            <name>eld_hypertension</name>
            <label>Hypertension / Cardiovascular Event Screening</label>
          </item>
          <item>
            <name>eld_respiratory</name>
            <label>Respiratory Conditions Screening</label>
          </item>
          <item>
            <name>eld_skin</name>
            <label>Skin Conditions Screening</label>
          </item>
          <item>
            <name>eld_stroke</name>
            <label>Stroke Screening</label>
          </item>
          <item>
            <name>eld_vision</name>
            <label>Vision Screening</label>
          </item>
          <item>
            <name>eld_uti</name>
            <label>UTI and STD Screening</label>
          </item>
          <item>
            <name>eld_wound</name>
            <label>Wound Care</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/select_form/forms_elderly" type="string" relevant=" /data/patient_age_in_years  &gt; 64"/>
      <bind nodeset="/data/select_form/forms_adults" type="string" relevant=" /data/patient_age_in_years  &gt; 17 and  /data/patient_age_in_years  &lt; 65"/>
      <bind nodeset="/data/select_form/forms_youths" type="string" relevant=" /data/patient_age_in_years  &gt; 5 and  /data/patient_age_in_years  &lt; 18"/>
      <bind nodeset="/data/select_form/forms_children" type="string" relevant=" /data/patient_age_in_years  &lt; 6"/>
      <bind nodeset="/data/route_digestive" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_digestive') or selected( /data/select_form/forms_adults , 'adt_digestive') or selected( /data/select_form/forms_youths , 'yaa_digestive') or selected( /data/select_form/forms_children , 'chd_digestive'), 'true', 'false')"/>
      <bind nodeset="/data/route_fever" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_fever') or selected( /data/select_form/forms_adults , 'adt_fever'), 'true', 'false')"/>
      <bind nodeset="/data/route_hypertension" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_hypertension') or selected( /data/select_form/forms_adults , 'adt_hypertension'), 'true', 'false')"/>
      <bind nodeset="/data/route_pregnancy" type="string" calculate="if(selected( /data/select_form/forms_adults , 'adt_pregnancy'), 'true', 'false')"/>
      <bind nodeset="/data/route_respiratory" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_respiratory') or selected( /data/select_form/forms_adults , 'adt_respiratory') or selected( /data/select_form/forms_youths , 'yaa_respiratory') or selected( /data/select_form/forms_children , 'chd_respiratory'), 'true', 'false')"/>
      <bind nodeset="/data/route_skin" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_skin') or selected( /data/select_form/forms_adults , 'adt_skin') or selected( /data/select_form/forms_youths , 'yaa_skin') or selected( /data/select_form/forms_children , 'chd_skin'), 'true', 'false')"/>
      <bind nodeset="/data/route_stroke" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_stroke') or selected( /data/select_form/forms_adults , 'adt_stroke'), 'true', 'false')"/>
      <bind nodeset="/data/route_uti_std" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_uti') or selected( /data/select_form/forms_adults , 'adt_uti') or selected( /data/select_form/forms_youths , 'yaa_uti'), 'true', 'false')"/>
      <bind nodeset="/data/route_wound" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_wound') or selected( /data/select_form/forms_adults , 'adt_wound') or selected( /data/select_form/forms_youths , 'yaa_wound') or selected( /data/select_form/forms_children , 'chd_wound'), 'true', 'false')"/>
      <bind nodeset="/data/route_vision" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_vision') or selected( /data/select_form/forms_adults , 'adt_vision') or selected( /data/select_form/forms_youths , 'yaa_vision') or selected( /data/select_form/forms_children , 'chd_vision'), 'true', 'false')"/>
      <bind nodeset="/data/route_diabetes" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_diabetes') or selected( /data/select_form/forms_adults , 'adt_diabetes'), 'true', 'false')"/>
      <bind nodeset="/data/route_chronic_pain" type="string" calculate="if(selected( /data/select_form/forms_elderly , 'eld_chronic_pain'), 'true', 'false')"/>
      <bind nodeset="/data/route_vaccinations" type="string" calculate="if(selected( /data/select_form/forms_children , 'chd_vac'), 'true', 'false')"/>
      <bind nodeset="/data/summary_group/note_diabetes" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'true'"/>
      <bind nodeset="/data/summary_group/note_digestive" readonly="true()" type="string" relevant=" /data/route_digestive  = 'true'"/>
      <bind nodeset="/data/summary_group/note_fever" readonly="true()" type="string" relevant=" /data/route_fever  = 'true'"/>
      <bind nodeset="/data/summary_group/note_hypertension" readonly="true()" type="string" relevant=" /data/route_hypertension  = 'true'"/>
      <bind nodeset="/data/summary_group/note_pregnancy" readonly="true()" type="string" relevant=" /data/route_pregnancy  = 'true'"/>
      <bind nodeset="/data/summary_group/note_respiratory" readonly="true()" type="string" relevant=" /data/route_respiratory  = 'true'"/>
      <bind nodeset="/data/summary_group/note_skin" readonly="true()" type="string" relevant=" /data/route_skin  = 'true'"/>
      <bind nodeset="/data/summary_group/note_stroke" readonly="true()" type="string" relevant=" /data/route_stroke  = 'true'"/>
      <bind nodeset="/data/summary_group/note_uti_std" readonly="true()" type="string" relevant=" /data/route_uti_std  = 'true'"/>
      <bind nodeset="/data/summary_group/note_wound" readonly="true()" type="string" relevant=" /data/route_wound  = 'true'"/>
      <bind nodeset="/data/summary_group/note_vision" readonly="true()" type="string" relevant=" /data/route_vision  = 'true'"/>
      <bind nodeset="/data/summary_group/note_chronic_pain" readonly="true()" type="string" relevant=" /data/route_chronic_pain  = 'true'"/>
      <bind nodeset="/data/summary_group/note_vaccinations" readonly="true()" type="string" relevant=" /data/route_vaccinations  = 'true'"/>
      <bind nodeset="/data/summary_group/note_tasks_will_appear" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'true' or  /data/route_digestive  = 'true' or  /data/route_fever  = 'true' or  /data/route_hypertension  = 'true' or  /data/route_pregnancy  = 'true' or  /data/route_respiratory  = 'true' or  /data/route_skin  = 'true' or  /data/route_stroke  = 'true' or  /data/route_uti_std  = 'true' or  /data/route_wound  = 'true' or  /data/route_vision  = 'true' or  /data/route_chronic_pain  = 'true' or  /data/route_vaccinations  = 'true'"/>
      <bind nodeset="/data/summary_group/note_no_forms" readonly="true()" type="string" relevant=" /data/route_diabetes  = 'false' and  /data/route_digestive  = 'false' and  /data/route_fever  = 'false' and  /data/route_hypertension  = 'false' and  /data/route_pregnancy  = 'false' and  /data/route_respiratory  = 'false' and  /data/route_skin  = 'false' and  /data/route_stroke  = 'false' and  /data/route_uti_std  = 'false' and  /data/route_wound  = 'false' and  /data/route_vision  = 'false' and  /data/route_chronic_pain  = 'false' and  /data/route_vaccinations  = 'false'"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/select_form">
      <label>Select Forms</label>
      <select ref="/data/select_form/forms_elderly">
        <label>Please select any forms the patient requires from the list below:</label>
        <itemset nodeset="instance('forms_elderly')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select ref="/data/select_form/forms_adults">
        <label>Please select any forms the patient requires from the list below:</label>
        <itemset nodeset="instance('forms_adult')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select ref="/data/select_form/forms_youths">
        <label>Please select any forms the patient requires from the list below:</label>
        <itemset nodeset="instance('forms_youth')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select ref="/data/select_form/forms_children">
        <label>Please select any forms the patient requires from the list below:</label>
        <itemset nodeset="instance('forms_child')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list summary" ref="/data/summary_group">
      <label>Based on the selections, the patient will have to do the following forms:</label>
      <input ref="/data/summary_group/note_diabetes">
        <label>- Diabetes Form</label>
      </input>
      <input ref="/data/summary_group/note_digestive">
        <label>- Digestive Conditions Form</label>
      </input>
      <input ref="/data/summary_group/note_fever">
        <label>- Fever and Malaria Form</label>
      </input>
      <input ref="/data/summary_group/note_hypertension">
        <label>- Hypertension Form</label>
      </input>
      <input ref="/data/summary_group/note_pregnancy">
        <label>- Pregnancy Form</label>
      </input>
      <input ref="/data/summary_group/note_respiratory">
        <label>- Respiratory Conditions Form</label>
      </input>
      <input ref="/data/summary_group/note_skin">
        <label>- Skin Conditions Form</label>
      </input>
      <input ref="/data/summary_group/note_stroke">
        <label>- Stroke Form</label>
      </input>
      <input ref="/data/summary_group/note_uti_std">
        <label>- UTI and STD Form</label>
      </input>
      <input ref="/data/summary_group/note_wound">
        <label>- Wound Form</label>
      </input>
      <input ref="/data/summary_group/note_vision">
        <label>- Vision Form</label>
      </input>
      <input ref="/data/summary_group/note_chronic_pain">
        <label>- Chronic Pain Form</label>
      </input>
      <input ref="/data/summary_group/note_vaccinations">
        <label>- Vaccination and Deworming</label>
      </input>
      <input ref="/data/summary_group/note_tasks_will_appear">
        <label>A task will be created to fill out these forms. Please submit this form.</label>
      </input>
      <input ref="/data/summary_group/note_no_forms">
        <label>No forms were selected. No tasks will be created. Please proceed and submit this form.</label>
      </input>
    </group>
  </h:body>
</h:html>