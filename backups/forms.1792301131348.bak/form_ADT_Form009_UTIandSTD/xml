      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/female_uti_std_group" relevant=" /data/patient_sex  = 'female'"/>
      <bind nodeset="/data/female_uti_std_group/urination_qualifiers_f" type="string"/>
      <bind nodeset="/data/female_uti_std_group/pain_during_sex_f" type="string"/>
      <bind nodeset="/data/female_uti_std_group/ulcer_presence_f" type="string"/>
      <bind nodeset="/data/female_uti_std_group/discharge_qualifiers_f" type="string"/>
      <bind nodeset="/data/male_uti_std_group" relevant=" /data/patient_sex  = 'male'"/>
      <bind nodeset="/data/male_uti_std_group/urination_qualifiers_m" type="string"/>
      <bind nodeset="/data/male_uti_std_group/pain_during_sex_m" type="string"/>
      <bind nodeset="/data/male_uti_std_group/ulcer_presence_m" type="string"/>
      <bind nodeset="/data/male_uti_std_group/urethral_discharge_m" type="string"/>
      <bind nodeset="/data/calc_uti" type="string" calculate="if(selected( /data/female_uti_std_group/urination_qualifiers_f , 'pain_when_urinating') or selected( /data/female_uti_std_group/urination_qualifiers_f , 'frequent_urination') or selected( /data/female_uti_std_group/urination_qualifiers_f , 'dark_urine') or selected( /data/male_uti_std_group/urination_qualifiers_m , 'pain_when_urinating') or selected( /data/male_uti_std_group/urination_qualifiers_m , 'frequent_urination') or selected( /data/male_uti_std_group/urination_qualifiers_m , 'dark_urine'), 'true', 'false')"/>
      <bind nodeset="/data/calc_std_discharge" type="string" calculate="if(( /data/female_uti_std_group/ulcer_presence_f  != 'yes' and (selected( /data/female_uti_std_group/discharge_qualifiers_f , 'dark_discharge') or selected( /data/female_uti_std_group/discharge_qualifiers_f , 'more_discharge_than_usual') or selected( /data/female_uti_std_group/discharge_qualifiers_f , 'smelly_discharge'))) or ( /data/male_uti_std_group/ulcer_presence_m  != 'yes' and  /data/male_uti_std_group/urethral_discharge_m  = 'yes'), 'true', 'false')"/>
      <bind nodeset="/data/calc_std_ulcer" type="string" calculate="if( /data/female_uti_std_group/ulcer_presence_f  = 'yes' or  /data/male_uti_std_group/ulcer_presence_m  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_uti  = 'true' or  /data/calc_std_discharge  = 'true' or  /data/calc_std_ulcer  = 'true'"/>
      <bind nodeset="/data/results_group/res_uti" readonly="true()" type="string" relevant=" /data/calc_uti  = 'true'"/>
      <bind nodeset="/data/results_group/res_uti_action" readonly="true()" type="string" relevant=" /data/calc_uti  = 'true'"/>
      <bind nodeset="/data/results_group/res_std_discharge" readonly="true()" type="string" relevant=" /data/calc_std_discharge  = 'true'"/>
      <bind nodeset="/data/results_group/res_std_discharge_action" readonly="true()" type="string" relevant=" /data/calc_std_discharge  = 'true'"/>
      <bind nodeset="/data/results_group/res_std_ulcer" readonly="true()" type="string" relevant=" /data/calc_std_ulcer  = 'true'"/>
      <bind nodeset="/data/results_group/res_std_ulcer_action" readonly="true()" type="string" relevant=" /data/calc_std_ulcer  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_uti  != 'true' and  /data/calc_std_discharge  != 'true' and  /data/calc_std_ulcer  != 'true'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_result_uti" type="string" calculate="if( /data/calc_uti ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_std_discharge" type="string" calculate="if( /data/calc_std_discharge ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_std_ulcer" type="string" calculate="if( /data/calc_std_ulcer ='true', 'true', 'false')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/female_uti_std_group">
      <label ref="jr:itext('/data/female_uti_std_group:label')"/>
      <select ref="/data/female_uti_std_group/urination_qualifiers_f">
        <label ref="jr:itext('/data/female_uti_std_group/urination_qualifiers_f:label')"/>
        <itemset nodeset="instance('urination_qualifiers')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/female_uti_std_group/pain_during_sex_f">
        <label ref="jr:itext('/data/female_uti_std_group/pain_during_sex_f:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/female_uti_std_group/ulcer_presence_f">
        <label ref="jr:itext('/data/female_uti_std_group/ulcer_presence_f:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select ref="/data/female_uti_std_group/discharge_qualifiers_f">
        <label ref="jr:itext('/data/female_uti_std_group/discharge_qualifiers_f:label')"/>
        <itemset nodeset="instance('female_discharge_qualifiers')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
    </group>
    <group appearance="field-list" ref="/data/male_uti_std_group">
      <label ref="jr:itext('/data/male_uti_std_group:label')"/>
      <select ref="/data/male_uti_std_group/urination_qualifiers_m">
        <label ref="jr:itext('/data/male_uti_std_group/urination_qualifiers_m:label')"/>
        <itemset nodeset="instance('urination_qualifiers')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/male_uti_std_group/pain_during_sex_m">
        <label ref="jr:itext('/data/male_uti_std_group/pain_during_sex_m:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/male_uti_std_group/ulcer_presence_m">
        <label ref="jr:itext('/data/male_uti_std_group/ulcer_presence_m:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/male_uti_std_group/urethral_discharge_m">
        <label ref="jr:itext('/data/male_uti_std_group/urethral_discharge_m:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_uti" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_uti:label')"/>
      </input>
      <input ref="/data/results_group/res_uti_action">
        <label ref="jr:itext('/data/results_group/res_uti_action:label')"/>
      </input>
      <input ref="/data/results_group/res_std_discharge" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_std_discharge:label')"/>
      </input>
      <input ref="/data/results_group/res_std_discharge_action">
        <label ref="jr:itext('/data/results_group/res_std_discharge_action:label')"/>
      </input>
      <input ref="/data/results_group/res_std_ulcer" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_std_ulcer:label')"/>
      </input>
      <input ref="/data/results_group/res_std_ulcer_action">
        <label ref="jr:itext('/data/results_group/res_std_ulcer_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/null_results_note:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
  </h:body>
</h:html>