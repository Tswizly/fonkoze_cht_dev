<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Child Digestive Conditions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="CHD_Form001_DigestiveConditions" version="20260902220537" prefix="J1!CHD_Form001_DigestiveConditions!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <digestive_checkup_group>
            <diarrhea/>
            <diarrhea_duration/>
            <diarrhea_frequency/>
            <diarrhea_color/>
            <diarrhea_blood/>
            <vomiting_repeatedly/>
            <physical_demeanor/>
            <skin_pinch/>
            <sunken_eyes/>
          </digestive_checkup_group>
          <calc_severe_dehydration_signs/>
          <calc_severe_dehydration/>
          <calc_some_dehydration_signs/>
          <calc_some_dehydration/>
          <calc_no_dehydration/>
          <calc_persistent_diarrhea/>
          <calc_dysentery/>
          <calc_gastritis/>
          <calc_cholera/>
          <results_group>
            <res_severe_dehydration/>
            <res_severe_dehydration_action/>
            <res_some_dehydration/>
            <res_some_dehydration_action/>
            <res_no_dehydration/>
            <res_no_dehydration_action/>
            <res_persistent_diarrhea/>
            <res_persistent_diarrhea_action/>
            <res_dysentery/>
            <res_dysentery_action/>
            <res_gastritis/>
            <res_gastritis_action/>
            <res_cholera/>
            <res_cholera_action/>
          </results_group>
          <null_results_group>
            <null_results_note/>
          </null_results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="diarrhea_color">
        <root>
          <item>
            <name>greenish</name>
            <label>Greenish</label>
          </item>
          <item>
            <name>red</name>
            <label>Red</label>
          </item>
          <item>
            <name>blackish</name>
            <label>Blackish</label>
          </item>
          <item>
            <name>yellowish</name>
            <label>Yellowish</label>
          </item>
          <item>
            <name>gray_white</name>
            <label>Gray or white</label>
          </item>
        </root>
      </instance>
      <instance id="physical_demeanor">
        <root>
          <item>
            <name>lethargic_unconscious</name>
            <label>Lethargic or unconscious</label>
          </item>
          <item>
            <name>restless_irritable</name>
            <label>Restless or irritable</label>
          </item>
          <item>
            <name>drinking_difficulty</name>
            <label>Drinking difficulty</label>
          </item>
          <item>
            <name>drinking_eagerly</name>
            <label>Drinking eagerly</label>
          </item>
        </root>
      </instance>
      <instance id="skin_pinch">
        <root>
          <item>
            <name>very_slowly</name>
            <label>Very slowly</label>
          </item>
          <item>
            <name>slowly</name>
            <label>Slowly</label>
          </item>
          <item>
            <name>regular</name>
            <label>Regular</label>
          </item>
        </root>
      </instance>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/digestive_checkup_group/diarrhea" type="string" required="true()"/>
      <bind nodeset="/data/digestive_checkup_group/diarrhea_duration" type="int" required="true()" relevant=" /data/digestive_checkup_group/diarrhea  = 'yes'" constraint=". &lt;= 99" jr:constraintMsg="Cannot exceed 99"/>
      <bind nodeset="/data/digestive_checkup_group/diarrhea_frequency" type="int" required="true()" relevant=" /data/digestive_checkup_group/diarrhea  = 'yes'" constraint=". &lt;= 99" jr:constraintMsg="Cannot exceed 99"/>
      <bind nodeset="/data/digestive_checkup_group/diarrhea_color" type="string" required="true()" relevant=" /data/digestive_checkup_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_checkup_group/diarrhea_blood" type="string" required="true()" relevant=" /data/digestive_checkup_group/diarrhea  = 'yes'"/>
      <bind nodeset="/data/digestive_checkup_group/vomiting_repeatedly" type="string" required="true()"/>
      <bind nodeset="/data/digestive_checkup_group/physical_demeanor" type="string"/>
      <bind nodeset="/data/digestive_checkup_group/skin_pinch" type="string" required="true()"/>
      <bind nodeset="/data/digestive_checkup_group/sunken_eyes" type="string" required="true()"/>
      <bind nodeset="/data/calc_severe_dehydration_signs" type="string" calculate="if(selected( /data/digestive_checkup_group/physical_demeanor , 'lethargic_unconscious'), 1, 0) + if( /data/digestive_checkup_group/sunken_eyes  = 'yes', 1, 0) + if(selected( /data/digestive_checkup_group/physical_demeanor , 'drinking_difficulty'), 1, 0) + if( /data/digestive_checkup_group/skin_pinch  = 'very_slowly', 1, 0)"/>
      <bind nodeset="/data/calc_severe_dehydration" type="string" calculate="if( /data/calc_severe_dehydration_signs  &gt;= 2, 'true', 'false')"/>
      <bind nodeset="/data/calc_some_dehydration_signs" type="string" calculate="if(selected( /data/digestive_checkup_group/physical_demeanor , 'restless_irritable'), 1, 0) + if( /data/digestive_checkup_group/sunken_eyes  = 'yes', 1, 0) + if(selected( /data/digestive_checkup_group/physical_demeanor , 'drinking_eagerly'), 1, 0) + if( /data/digestive_checkup_group/skin_pinch  = 'slowly', 1, 0)"/>
      <bind nodeset="/data/calc_some_dehydration" type="string" calculate="if( /data/calc_some_dehydration_signs  &gt;= 2 and  /data/calc_severe_dehydration  != 'true', 'true', 'false')"/>
      <bind nodeset="/data/calc_no_dehydration" type="string" calculate="if( /data/calc_severe_dehydration  != 'true' and  /data/calc_some_dehydration  != 'true' and  /data/digestive_checkup_group/diarrhea  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_persistent_diarrhea" type="string" calculate="if( /data/digestive_checkup_group/diarrhea_duration  &gt;= 14, 'true', 'false')"/>
      <bind nodeset="/data/calc_dysentery" type="string" calculate="if( /data/digestive_checkup_group/diarrhea_duration  &gt;= 14 and  /data/digestive_checkup_group/diarrhea_blood  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_gastritis" type="string" calculate="if( /data/digestive_checkup_group/vomiting_repeatedly  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_cholera" type="string" calculate="if( /data/digestive_checkup_group/diarrhea_color  = 'gray_white' and  /data/digestive_checkup_group/diarrhea_frequency  &gt;= 3, 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_severe_dehydration  = 'true' or  /data/calc_some_dehydration  = 'true' or  /data/calc_no_dehydration  = 'true' or  /data/calc_persistent_diarrhea  = 'true' or  /data/calc_dysentery  = 'true' or  /data/calc_gastritis  = 'true' or  /data/calc_cholera  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_dehydration" readonly="true()" type="string" relevant=" /data/calc_severe_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_severe_dehydration_action" readonly="true()" type="string" relevant=" /data/calc_severe_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_some_dehydration" readonly="true()" type="string" relevant=" /data/calc_some_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_some_dehydration_action" readonly="true()" type="string" relevant=" /data/calc_some_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_no_dehydration" readonly="true()" type="string" relevant=" /data/calc_no_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_no_dehydration_action" readonly="true()" type="string" relevant=" /data/calc_no_dehydration  = 'true'"/>
      <bind nodeset="/data/results_group/res_persistent_diarrhea" readonly="true()" type="string" relevant=" /data/calc_persistent_diarrhea  = 'true'"/>
      <bind nodeset="/data/results_group/res_persistent_diarrhea_action" readonly="true()" type="string" relevant=" /data/calc_persistent_diarrhea  = 'true'"/>
      <bind nodeset="/data/results_group/res_dysentery" readonly="true()" type="string" relevant=" /data/calc_dysentery  = 'true'"/>
      <bind nodeset="/data/results_group/res_dysentery_action" readonly="true()" type="string" relevant=" /data/calc_dysentery  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis" readonly="true()" type="string" relevant=" /data/calc_gastritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_gastritis_action" readonly="true()" type="string" relevant=" /data/calc_gastritis  = 'true'"/>
      <bind nodeset="/data/results_group/res_cholera" readonly="true()" type="string" relevant=" /data/calc_cholera  = 'true'"/>
      <bind nodeset="/data/results_group/res_cholera_action" readonly="true()" type="string" relevant=" /data/calc_cholera  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_severe_dehydration  != 'true' and  /data/calc_some_dehydration  != 'true' and  /data/calc_no_dehydration  != 'true' and  /data/calc_persistent_diarrhea  != 'true' and  /data/calc_dysentery  != 'true' and  /data/calc_gastritis  != 'true' and  /data/calc_cholera  != 'true'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/digestive_checkup_group">
      <label>Digestive Checkup</label>
      <select1 ref="/data/digestive_checkup_group/diarrhea">
        <label>Does the child have diarrhea?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/digestive_checkup_group/diarrhea_duration">
        <label>How long has the child had diarrhea (days)?</label>
      </input>
      <input ref="/data/digestive_checkup_group/diarrhea_frequency">
        <label>How often does the child pass stool per day?</label>
      </input>
      <select1 ref="/data/digestive_checkup_group/diarrhea_color">
        <label>What color is the stool?</label>
        <itemset nodeset="instance('diarrhea_color')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_checkup_group/diarrhea_blood">
        <label>Is there blood in the child's stool?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_checkup_group/vomiting_repeatedly">
        <label>Is the child vomiting repeatedly?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select ref="/data/digestive_checkup_group/physical_demeanor">
        <label>What is the child's physical demeanor?</label>
        <itemset nodeset="instance('physical_demeanor')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <select1 ref="/data/digestive_checkup_group/skin_pinch">
        <label>After being pinched, does the skin of the abdomen go back regularly, slowly, or very slowly?</label>
        <itemset nodeset="instance('skin_pinch')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/digestive_checkup_group/sunken_eyes">
        <label>Does the child exhibit sunken eyes?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_severe_dehydration" appearance="h1 red">
        <label>Severe Dehydration</label>
      </input>
      <input ref="/data/results_group/res_severe_dehydration_action">
        <label>Place Levine tube, and use siringe to provide ORS through the tube, Then Refer URGENTLY to hospital with mother giving frequent sips of ORS on the way. Advise the mother to continue breastfeeding.</label>
      </input>
      <input ref="/data/results_group/res_some_dehydration" appearance="h1 yellow">
        <label>Some Dehydration</label>
      </input>
      <input ref="/data/results_group/res_some_dehydration_action">
        <label>Give ORS, zinc supplements, and food for some dehydration (Plan B - DOSING). If child also has a severe classification: Refer URGENTLY to hospital with mother giving frequent sips of ORS on the way. Advise the mother to continue breastfeeding. Go to hospital in 5 days if not improving.</label>
      </input>
      <input ref="/data/results_group/res_no_dehydration" appearance="h1 green">
        <label>No Dehydration</label>
      </input>
      <input ref="/data/results_group/res_no_dehydration_action">
        <label>Give 4 packets of ORS to go home with as well as zinc supplements, and food to treat diarrhea at home (Plan A - DOSING). Advise mother when to go to hospital immediately.</label>
      </input>
      <input ref="/data/results_group/res_persistent_diarrhea" appearance="h1 red">
        <label>Persistent Diarrhea</label>
      </input>
      <input ref="/data/results_group/res_persistent_diarrhea_action">
        <label>ORS Treat dehydration before referral unless the child has another severe classification (DOSING). Refer to hospital.</label>
      </input>
      <input ref="/data/results_group/res_dysentery" appearance="h1 yellow">
        <label>Dysentery</label>
      </input>
      <input ref="/data/results_group/res_dysentery_action">
        <label>Give trimetoprim sulfate (TMS) for 3 days (200/40 mg per 5 ml – 4 a 5 mg per kg per day in two doses) and metronidazole 250mg/5ml suspension – 20 mg par kg par jour en trois doses). Breastfeeding. Treated water.</label>
      </input>
      <input ref="/data/results_group/res_gastritis" appearance="h1 yellow">
        <label>Gastritis</label>
      </input>
      <input ref="/data/results_group/res_gastritis_action">
        <label>Give ORS. Metoclopramide IM – dosing: 0.1 mg par kg max 0.5 mg. Antacid: Litacid Gel. Counseling on good feeding practices: no spicy food, no salty food, no tomato sauce or mayonaise, regular small meals. Soup, vegetables, soup. Recommendation for hygiene: washing hands, no raw food, washing fruit with soap.</label>
      </input>
      <input ref="/data/results_group/res_cholera" appearance="h1 red">
        <label>Risk of Cholera</label>
      </input>
      <input ref="/data/results_group/res_cholera_action">
        <label>IV fluid – Ringer/lactate if severely dehydrated. ORS. Refer to cholera treatment center or hospital.</label>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label>No Conditions Met</label>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label>No conditions were met and the patient does not require additional treatment, submit the form.</label>
      </input>
    </group>
  </h:body>
</h:html>