        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_severe_dehydration" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_severe_dehydration:label')"/>
      </input>
      <input ref="/data/results_group/res_severe_dehydration_action">
        <label ref="jr:itext('/data/results_group/res_severe_dehydration_action:label')"/>
      </input>
      <input ref="/data/results_group/res_some_dehydration" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_some_dehydration:label')"/>
      </input>
      <input ref="/data/results_group/res_some_dehydration_action">
