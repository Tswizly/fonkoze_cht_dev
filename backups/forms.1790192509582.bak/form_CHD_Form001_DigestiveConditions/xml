      <bind nodeset="/data/data/_calc_severe_dehydration" type="string" calculate="if( /data/calc_severe_dehydration ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_some_dehydration" type="string" calculate="if( /data/calc_some_dehydration ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_no_dehydration" type="string" calculate="if( /data/calc_no_dehydration ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_persistent_diarrhea" type="string" calculate="if( /data/calc_persistent_diarrhea ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_dysentery" type="string" calculate="if( /data/calc_dysentery ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_gastritis" type="string" calculate="if( /data/calc_gastritis ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_calc_cholera" type="string" calculate="if( /data/calc_cholera ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_zinc_tablets_20mg" type="string" calculate="if( /data/actions_confirmation/zinc_tablets_20mg  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_ciprofloxacine_oral_suspension_250mg_5ml" type="string" calculate="if( /data/actions_confirmation/ciprofloxacine_oral_suspension_250mg_5ml  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_metoclopramide_im" type="string" calculate="if( /data/actions_confirmation/metoclopramide_im  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/clinic_id" type="string" calculate="../inputs/user/facility_id"/>
      <bind nodeset="/data/prescription_summary/stock_monitoring_reported_date" type="string" calculate="now()"/>
      <bind nodeset="/data/prescription_summary/place_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/type" type="string" calculate="&quot;data_record&quot;"/>
      <bind nodeset="/data/prescription_summary/created_from" type="string" calculate="."/>
      <bind nodeset="/data/prescription_summary/created_from_name" type="string" calculate="&quot;CHD_Form001_DigestiveConditions&quot;"/>
      <bind nodeset="/data/prescription_summary/content_type" type="string" calculate="&quot;xml&quot;"/>
      <bind nodeset="/data/prescription_summary/form" type="string" calculate="&quot;prescription_summary&quot;"/>
      <bind nodeset="/data/prescription_summary/contact/_id" type="string" calculate=" /data/clinic_id "/>
      <bind nodeset="/data/prescription_summary/fields/Medicine_out" readonly="true()" type="string"/>
      <bind nodeset="/data/prescription_summary/fields/zinc_tablets_20mg_used_in_CHD_Form001_DigestiveConditions" type="string" calculate="if( /data/actions_confirmation/zinc_tablets_20mg  = 'yes', 1, 0)"/>
      <bind nodeset="/data/prescription_summary/fields/ciprofloxacine_oral_suspension_250mg_5ml_used_in_CHD_Form001_DigestiveConditions" type="string" calculate="if( /data/actions_confirmation/ciprofloxacine_oral_suspension_250mg_5ml  = 'yes', 1, 0)"/>
      <bind nodeset="/data/prescription_summary/fields/metoclopramide_im_used_in_CHD_Form001_DigestiveConditions" type="string" calculate="if( /data/actions_confirmation/metoclopramide_im  = 'yes', 1, 0)"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
