      <bind nodeset="/data/data/_recurring_condition" type="string" calculate="if( /data/respiratory_conditions_group/recurring_condition  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_tb_exposure" type="string" calculate="if( /data/respiratory_conditions_group/tb_exposure  = 'yes', 'true', 'false')"/>
