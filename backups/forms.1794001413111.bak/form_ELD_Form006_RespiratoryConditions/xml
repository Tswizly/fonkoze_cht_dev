      <bind nodeset="/data/calc_asthma" type="string" calculate="if( /data/respiratory_conditions_group/wheezing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes' and  /data/respiratory_conditions_group/recurring_condition  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_pneumonia" type="string" calculate="if( /data/respiratory_conditions_group/temperature  &gt; 38 and  /data/respiratory_conditions_group/fever_duration  &gt; 7 and  /data/respiratory_conditions_group/elderly_coughing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes', 'true', 'false')"/>
