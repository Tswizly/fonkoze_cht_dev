      <bind nodeset="/data/calc_impetigo" type="string" calculate="if(selected( /data/skin_checkup_group/skin_symptoms , 'crusts_lesions') or selected( /data/skin_checkup_group/skin_symptoms , 'blisters_sores_pustules'), 'true', 'false')"/>
