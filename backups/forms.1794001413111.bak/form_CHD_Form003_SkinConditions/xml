      <bind nodeset="/data/calc_scabies" type="string" calculate="if(selected( /data/skin_checkup_group/skin_symptoms , 'rash') and selected( /data/skin_checkup_group/skin_symptoms , 'web_space_wrists') and selected( /data/skin_checkup_group/skin_symptoms , 'face_spared'), 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_impetigo  = 'true' or  /data/calc_ring_worm  = 'true' or  /data/calc_scabies  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo" readonly="true()" type="string" relevant=" /data/calc_impetigo  = 'true'"/>
      <bind nodeset="/data/results_group/res_impetigo_action" readonly="true()" type="string" relevant=" /data/calc_impetigo  = 'true'"/>
      <bind nodeset="/data/results_group/res_ring_worm" readonly="true()" type="string" relevant=" /data/calc_ring_worm  = 'true'"/>
