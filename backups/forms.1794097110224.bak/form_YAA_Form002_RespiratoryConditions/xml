            <_patient_temperature/>
            <_fever_duration/>
            <_extended_fever_duration/>
            <_oxygen_saturation/>
            <_breathing_rate/>
            <_cough_presence/>
            <_cough_duration/>
            <_cough_danger_signs/>
            <_runny_nose/>
            <_poor_appetite/>
            <_sore_throat/>
            <_throat_appearance/>
            <_result_flu_like_syndrome/>
            <_result_pneumonia_pink/>
            <_result_pneumonia_yellow/>
            <_result_tonsillitis/>
          </data>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <itextId>yes_no-0</itextId>
            <name>yes</name>
          </item>
          <item>
            <itextId>yes_no-1</itextId>
            <name>no</name>
          </item>
        </root>
      </instance>
      <instance id="cough_danger_signs">
        <root>
          <item>
            <itextId>cough_danger_signs-0</itextId>
            <name>chest_indrawing</name>
          </item>
          <item>
            <itextId>cough_danger_signs-1</itextId>
            <name>stridor</name>
          </item>
          <item>
            <itextId>cough_danger_signs-2</itextId>
            <name>wheezing</name>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/user/facility_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/respiratory_assessment/fever_presence" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/patient_temperature" type="decimal" relevant=" /data/respiratory_assessment/fever_presence  = 'yes'" constraint=". &gt;= 90 and . &lt;= 110"/>
      <bind nodeset="/data/respiratory_assessment/fever_duration" type="int" relevant=" /data/respiratory_assessment/fever_presence  = 'yes'" constraint=". &lt;= 99"/>
      <bind nodeset="/data/respiratory_assessment/extended_fever_duration" type="string" relevant=" /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/fever_duration  &gt;= 7"/>
      <bind nodeset="/data/respiratory_assessment/oxygen_saturation" type="decimal" constraint=". &lt;= 100"/>
      <bind nodeset="/data/respiratory_assessment/breathing_rate" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_assessment/cough_presence" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/cough_duration" type="int" relevant=" /data/respiratory_assessment/cough_presence  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_assessment/cough_danger_signs" type="string" relevant=" /data/respiratory_assessment/cough_presence  = 'yes'"/>
      <bind nodeset="/data/respiratory_assessment/runny_nose" type="string"/>
      <bind nodeset="/data/respiratory_assessment/poor_appetite" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/sore_throat" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_assessment/throat_appearance" type="string" relevant=" /data/respiratory_assessment/sore_throat  = 'yes'"/>
      <bind nodeset="/data/calc_flu_like_syndrome" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/runny_nose  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and  /data/respiratory_assessment/poor_appetite  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_pneumonia_pink" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and ( /data/respiratory_assessment/oxygen_saturation  &lt; 95 or selected( /data/respiratory_assessment/cough_danger_signs , 'chest_indrawing') or selected( /data/respiratory_assessment/cough_danger_signs , 'stridor') or selected( /data/respiratory_assessment/cough_danger_signs , 'wheezing')), 'true', 'false')"/>
      <bind nodeset="/data/calc_pneumonia_yellow" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/cough_presence  = 'yes' and  /data/respiratory_assessment/oxygen_saturation  &gt;= 95 and not(selected( /data/respiratory_assessment/cough_danger_signs , 'chest_indrawing') or selected( /data/respiratory_assessment/cough_danger_signs , 'stridor') or selected( /data/respiratory_assessment/cough_danger_signs , 'wheezing')), 'true', 'false')"/>
      <bind nodeset="/data/calc_tonsillitis" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes' and  /data/respiratory_assessment/sore_throat  = 'yes' and  /data/respiratory_assessment/throat_appearance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_flu_like_syndrome  = 'true' or  /data/calc_pneumonia_pink  = 'true' or  /data/calc_pneumonia_yellow  = 'true' or  /data/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome" readonly="true()" type="string" relevant=" /data/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_flu_like_syndrome_action" readonly="true()" type="string" relevant=" /data/calc_flu_like_syndrome  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_pink" readonly="true()" type="string" relevant=" /data/calc_pneumonia_pink  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_pink_action" readonly="true()" type="string" relevant=" /data/calc_pneumonia_pink  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_yellow" readonly="true()" type="string" relevant=" /data/calc_pneumonia_yellow  = 'true' and  /data/calc_pneumonia_pink  != 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_yellow_action" readonly="true()" type="string" relevant=" /data/calc_pneumonia_yellow  = 'true' and  /data/calc_pneumonia_pink  != 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis" readonly="true()" type="string" relevant=" /data/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/results_group/res_tonsillitis_action" readonly="true()" type="string" relevant=" /data/calc_tonsillitis  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_flu_like_syndrome  != 'true' and  /data/calc_pneumonia_pink  != 'true' and  /data/calc_pneumonia_yellow  != 'true' and  /data/calc_tonsillitis  != 'true'"/>
      <bind nodeset="/data/null_results_group/res_null" readonly="true()" type="string"/>
      <bind nodeset="/data/data/_fever_presence" type="string" calculate="if( /data/respiratory_assessment/fever_presence  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_patient_temperature" type="string" calculate="if( /data/respiratory_assessment/patient_temperature  != '',  /data/respiratory_assessment/patient_temperature , -1)"/>
      <bind nodeset="/data/data/_fever_duration" type="string" calculate="if( /data/respiratory_assessment/fever_duration  != '',  /data/respiratory_assessment/fever_duration , -1)"/>
      <bind nodeset="/data/data/_extended_fever_duration" type="string" calculate="if( /data/respiratory_assessment/extended_fever_duration  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_oxygen_saturation" type="string" calculate="if( /data/respiratory_assessment/oxygen_saturation  != '',  /data/respiratory_assessment/oxygen_saturation , -1)"/>
      <bind nodeset="/data/data/_breathing_rate" type="string" calculate="if( /data/respiratory_assessment/breathing_rate  != '',  /data/respiratory_assessment/breathing_rate , -1)"/>
      <bind nodeset="/data/data/_cough_presence" type="string" calculate="if( /data/respiratory_assessment/cough_presence  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_cough_duration" type="string" calculate="if( /data/respiratory_assessment/cough_duration  != '',  /data/respiratory_assessment/cough_duration , -1)"/>
      <bind nodeset="/data/data/_cough_danger_signs" type="string" calculate="if( /data/respiratory_assessment/cough_danger_signs  != '',  /data/respiratory_assessment/cough_danger_signs , 'false')"/>
      <bind nodeset="/data/data/_runny_nose" type="string" calculate="if( /data/respiratory_assessment/runny_nose  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_poor_appetite" type="string" calculate="if( /data/respiratory_assessment/poor_appetite  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_sore_throat" type="string" calculate="if( /data/respiratory_assessment/sore_throat  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_throat_appearance" type="string" calculate="if( /data/respiratory_assessment/throat_appearance  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_flu_like_syndrome" type="string" calculate="if( /data/calc_flu_like_syndrome ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_pneumonia_pink" type="string" calculate="if( /data/calc_pneumonia_pink ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_pneumonia_yellow" type="string" calculate="if( /data/calc_pneumonia_yellow ='true', 'true', 'false')"/>
      <bind nodeset="/data/data/_result_tonsillitis" type="string" calculate="if( /data/calc_tonsillitis ='true', 'true', 'false')"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <group ref="/data/inputs/user">
        <label ref="jr:itext('/data/inputs/user:label')"/>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label ref="jr:itext('/data/inputs/user/contact_id:label')"/>
        </input>
        <group ref="/data/inputs/user/parent"/>
      </group>
      <group ref="/data/inputs/contact">
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label ref="jr:itext('/data/inputs/contact/_id:label')"/>
        </input>
        <group ref="/data/inputs/contact/parent">
          <group ref="/data/inputs/contact/parent/parent">
            <group ref="/data/inputs/contact/parent/parent/contact"/>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_assessment">
      <label ref="jr:itext('/data/respiratory_assessment:label')"/>
      <select1 ref="/data/respiratory_assessment/fever_presence">
        <label ref="jr:itext('/data/respiratory_assessment/fever_presence:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/patient_temperature">
        <label ref="jr:itext('/data/respiratory_assessment/patient_temperature:label')"/>
      </input>
      <input ref="/data/respiratory_assessment/fever_duration">
        <label ref="jr:itext('/data/respiratory_assessment/fever_duration:label')"/>
      </input>
      <select1 ref="/data/respiratory_assessment/extended_fever_duration">
        <label ref="jr:itext('/data/respiratory_assessment/extended_fever_duration:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/oxygen_saturation">
        <label ref="jr:itext('/data/respiratory_assessment/oxygen_saturation:label')"/>
      </input>
      <input ref="/data/respiratory_assessment/breathing_rate">
        <label ref="jr:itext('/data/respiratory_assessment/breathing_rate:label')"/>
      </input>
      <select1 ref="/data/respiratory_assessment/cough_presence">
        <label ref="jr:itext('/data/respiratory_assessment/cough_presence:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_assessment/cough_duration">
        <label ref="jr:itext('/data/respiratory_assessment/cough_duration:label')"/>
      </input>
      <select ref="/data/respiratory_assessment/cough_danger_signs">
        <label ref="jr:itext('/data/respiratory_assessment/cough_danger_signs:label')"/>
        <itemset nodeset="instance('cough_danger_signs')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select>
      <select1 ref="/data/respiratory_assessment/runny_nose">
        <label ref="jr:itext('/data/respiratory_assessment/runny_nose:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/poor_appetite">
        <label ref="jr:itext('/data/respiratory_assessment/poor_appetite:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/sore_throat">
        <label ref="jr:itext('/data/respiratory_assessment/sore_throat:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_assessment/throat_appearance">
        <label ref="jr:itext('/data/respiratory_assessment/throat_appearance:label')"/>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="jr:itext(itextId)"/>
        </itemset>
      </select1>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label ref="jr:itext('/data/results_group:label')"/>
      <input ref="/data/results_group/res_flu_like_syndrome" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome:label')"/>
      </input>
      <input ref="/data/results_group/res_flu_like_syndrome_action">
        <label ref="jr:itext('/data/results_group/res_flu_like_syndrome_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink" appearance="h1 red">
        <label ref="jr:itext('/data/results_group/res_pneumonia_pink:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_pink_action">
        <label ref="jr:itext('/data/results_group/res_pneumonia_pink_action:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_pneumonia_yellow:label')"/>
      </input>
      <input ref="/data/results_group/res_pneumonia_yellow_action">
        <label ref="jr:itext('/data/results_group/res_pneumonia_yellow_action:label')"/>
      </input>
      <input ref="/data/results_group/res_tonsillitis" appearance="h1 yellow">
        <label ref="jr:itext('/data/results_group/res_tonsillitis:label')"/>
      </input>
      <input ref="/data/results_group/res_tonsillitis_action">
        <label ref="jr:itext('/data/results_group/res_tonsillitis_action:label')"/>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/null_results_group">
      <label ref="jr:itext('/data/null_results_group:label')"/>
      <input ref="/data/null_results_group/res_null" appearance="h1 green">
        <label ref="jr:itext('/data/null_results_group/res_null:label')"/>
      </input>
    </group>
    <group ref="/data/data"/>
  </h:body>
</h:html>