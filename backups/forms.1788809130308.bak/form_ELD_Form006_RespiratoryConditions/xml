<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms">
  <h:head>
    <h:title>Elderly Respiratory Conditions</h:title>
    <model odk:xforms-version="1.0.0">
      <instance>
        <data id="ELD_Form006_RespiratoryConditions" version="20260902215927" prefix="J1!ELD_Form006_RespiratoryConditions!" delimiter="#">
          <inputs>
            <meta>
              <location>
                <lat/>
                <long/>
                <error/>
                <message/>
              </location>
            </meta>
            <source>user</source>
            <source_id/>
            <user>
              <contact_id/>
              <parent>
                <_id/>
              </parent>
            </user>
            <contact>
              <_id/>
              <name/>
              <short_name/>
              <patient_id/>
              <date_of_birth>0</date_of_birth>
              <sex/>
              <parent>
                <_id/>
                <parent>
                  <contact>
                    <nurse_name/>
                    <phone/>
                  </contact>
                </parent>
              </parent>
            </contact>
          </inputs>
          <source/>
          <source_id/>
          <patient_uuid/>
          <patient_id/>
          <patient_name/>
          <patient_short_name/>
          <patient_sex/>
          <patient_date_of_birth/>
          <patient_age_in_years/>
          <patient_age_in_months/>
          <patient_age_in_days/>
          <patient_age_in_weeks/>
          <respiratory_conditions_group>
            <elderly_coughing/>
            <cough_duration/>
            <qualify_cough/>
            <breathing_rate/>
            <oxygen_saturation/>
            <fever/>
            <temperature/>
            <fever_duration/>
            <wheezing/>
            <respiratory_distress/>
            <weight_loss/>
            <night_sweats/>
            <recurring_condition/>
            <tb_exposure/>
            <jugular_venous_distention/>
            <oedema_feet_ankles/>
            <respiratory_distress_after_exercise/>
            <tiredness/>
            <symptoms_duration_weeks/>
          </respiratory_conditions_group>
          <calc_tuberculosis/>
          <calc_asthma/>
          <calc_pneumonia/>
          <calc_cardiac_decompensation_risk/>
          <calc_cardiac_decompensation/>
          <results_group>
            <res_tuberculosis/>
            <res_tuberculosis_action/>
            <res_asthma/>
            <res_asthma_action/>
            <res_pneumonia/>
            <res_pneumonia_action/>
            <res_cardiac_decompensation_risk/>
            <res_cardiac_decompensation_risk_action/>
            <res_cardiac_decompensation/>
            <res_cardiac_decompensation_action/>
          </results_group>
          <null_results_group>
            <null_results_note/>
          </null_results_group>
          <meta tag="hidden">
            <instanceID/>
          </meta>
        </data>
      </instance>
      <instance id="contact-summary"/>
      <instance id="user-contact-summary"/>
      <instance id="yes_no">
        <root>
          <item>
            <name>yes</name>
            <label>Yes</label>
          </item>
          <item>
            <name>no</name>
            <label>No</label>
          </item>
        </root>
      </instance>
      <instance id="qualify_cough">
        <root>
          <item>
            <name>dry_cough</name>
            <label>Dry cough</label>
          </item>
          <item>
            <name>mucus_cough</name>
            <label>Mucus cough</label>
          </item>
        </root>
      </instance>
      <bind nodeset="/data/inputs" relevant="./source = 'user'"/>
      <bind nodeset="/data/inputs/source" type="string"/>
      <bind nodeset="/data/inputs/source_id" type="string"/>
      <bind nodeset="/data/inputs/user/contact_id" type="string"/>
      <bind nodeset="/data/inputs/user/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/_id" type="db:person"/>
      <bind nodeset="/data/inputs/contact/name" type="string"/>
      <bind nodeset="/data/inputs/contact/short_name" type="string"/>
      <bind nodeset="/data/inputs/contact/patient_id" type="string"/>
      <bind nodeset="/data/inputs/contact/date_of_birth" type="string"/>
      <bind nodeset="/data/inputs/contact/sex" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/_id" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/nurse_name" type="string"/>
      <bind nodeset="/data/inputs/contact/parent/parent/contact/phone" type="string"/>
      <bind nodeset="/data/source" type="string" calculate="../inputs/source"/>
      <bind nodeset="/data/source_id" type="string" calculate="../inputs/source_id"/>
      <bind nodeset="/data/patient_uuid" type="string" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_id" type="string" required="true()" calculate="../inputs/contact/_id"/>
      <bind nodeset="/data/patient_name" type="string" calculate="../inputs/contact/name"/>
      <bind nodeset="/data/patient_short_name" type="string" calculate="../inputs/contact/short_name"/>
      <bind nodeset="/data/patient_sex" type="string" calculate="../inputs/contact/sex"/>
      <bind nodeset="/data/patient_date_of_birth" type="string" calculate="../inputs/contact/date_of_birth"/>
      <bind nodeset="/data/patient_age_in_years" type="string" calculate="floor( difference-in-months(  /data/patient_date_of_birth , today() ) div 12 )"/>
      <bind nodeset="/data/patient_age_in_months" type="string" calculate="difference-in-months(  /data/patient_date_of_birth , today() )"/>
      <bind nodeset="/data/patient_age_in_days" type="string" calculate="floor( decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth ) )"/>
      <bind nodeset="/data/patient_age_in_weeks" type="string" calculate="floor((decimal-date-time(today()) - decimal-date-time( /data/patient_date_of_birth )) div 7)"/>
      <bind nodeset="/data/respiratory_conditions_group/elderly_coughing" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/cough_duration" type="int" relevant=" /data/respiratory_conditions_group/elderly_coughing  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/qualify_cough" type="string" relevant=" /data/respiratory_conditions_group/elderly_coughing  = 'yes'"/>
      <bind nodeset="/data/respiratory_conditions_group/breathing_rate" type="int" required="true()" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/oxygen_saturation" type="decimal" constraint=". &lt;= 100"/>
      <bind nodeset="/data/respiratory_conditions_group/fever" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/temperature" type="decimal" relevant=" /data/respiratory_conditions_group/fever  = 'yes'" constraint=". &lt;= 999"/>
      <bind nodeset="/data/respiratory_conditions_group/fever_duration" type="int" relevant=" /data/respiratory_conditions_group/fever  = 'yes'"/>
      <bind nodeset="/data/respiratory_conditions_group/wheezing" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/respiratory_distress" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/weight_loss" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/night_sweats" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/recurring_condition" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/tb_exposure" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/jugular_venous_distention" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/oedema_feet_ankles" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/respiratory_distress_after_exercise" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/tiredness" type="string" required="true()"/>
      <bind nodeset="/data/respiratory_conditions_group/symptoms_duration_weeks" type="int" constraint=". &lt;= 999"/>
      <bind nodeset="/data/calc_tuberculosis" type="string" calculate="if( /data/respiratory_conditions_group/cough_duration  &gt; 14 and  /data/respiratory_conditions_group/weight_loss  = 'yes' and  /data/respiratory_conditions_group/night_sweats  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_asthma" type="string" calculate="if( /data/respiratory_conditions_group/wheezing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes' and  /data/respiratory_conditions_group/recurring_condition  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_pneumonia" type="string" calculate="if( /data/respiratory_conditions_group/temperature  &gt; 38 and  /data/respiratory_conditions_group/fever_duration  &gt; 7 and  /data/respiratory_conditions_group/elderly_coughing  = 'yes' and  /data/respiratory_conditions_group/respiratory_distress  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_cardiac_decompensation_risk" type="string" calculate="if( /data/respiratory_conditions_group/jugular_venous_distention  = 'yes' or  /data/respiratory_conditions_group/oedema_feet_ankles  = 'yes' or  /data/respiratory_conditions_group/respiratory_distress_after_exercise  = 'yes', 'true', 'false')"/>
      <bind nodeset="/data/calc_cardiac_decompensation" type="string" calculate="if( /data/respiratory_conditions_group/tiredness  = 'yes' and  /data/respiratory_conditions_group/symptoms_duration_weeks  &gt;= 2, 'true', 'false')"/>
      <bind nodeset="/data/results_group" relevant=" /data/calc_tuberculosis  = 'true' or  /data/calc_asthma  = 'true' or  /data/calc_pneumonia  = 'true' or  /data/calc_cardiac_decompensation_risk  = 'true' or  /data/calc_cardiac_decompensation  = 'true'"/>
      <bind nodeset="/data/results_group/res_tuberculosis" readonly="true()" type="string" relevant=" /data/calc_tuberculosis  = 'true'"/>
      <bind nodeset="/data/results_group/res_tuberculosis_action" readonly="true()" type="string" relevant=" /data/calc_tuberculosis  = 'true'"/>
      <bind nodeset="/data/results_group/res_asthma" readonly="true()" type="string" relevant=" /data/calc_asthma  = 'true'"/>
      <bind nodeset="/data/results_group/res_asthma_action" readonly="true()" type="string" relevant=" /data/calc_asthma  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia" readonly="true()" type="string" relevant=" /data/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_pneumonia_action" readonly="true()" type="string" relevant=" /data/calc_pneumonia  = 'true'"/>
      <bind nodeset="/data/results_group/res_cardiac_decompensation_risk" readonly="true()" type="string" relevant=" /data/calc_cardiac_decompensation_risk  = 'true'"/>
      <bind nodeset="/data/results_group/res_cardiac_decompensation_risk_action" readonly="true()" type="string" relevant=" /data/calc_cardiac_decompensation_risk  = 'true'"/>
      <bind nodeset="/data/results_group/res_cardiac_decompensation" readonly="true()" type="string" relevant=" /data/calc_cardiac_decompensation  = 'true'"/>
      <bind nodeset="/data/results_group/res_cardiac_decompensation_action" readonly="true()" type="string" relevant=" /data/calc_cardiac_decompensation  = 'true'"/>
      <bind nodeset="/data/null_results_group" relevant=" /data/calc_tuberculosis  = 'false' and  /data/calc_asthma  = 'false' and  /data/calc_pneumonia  = 'false' and  /data/calc_cardiac_decompensation_risk  = 'false' and  /data/calc_cardiac_decompensation  = 'false'"/>
      <bind nodeset="/data/null_results_group/null_results_note" readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body class="pages">
    <group appearance="field-list" ref="/data/inputs">
      <label>NO_LABEL</label>
      <group ref="/data/inputs/user">
        <label>User</label>
        <input ref="/data/inputs/user/contact_id" appearance="select-contact type-person">
          <label>Contact ID</label>
        </input>
        <group ref="/data/inputs/user/parent">
          <label>NO_LABEL</label>
        </group>
      </group>
      <group ref="/data/inputs/contact">
        <label>NO_LABEL</label>
        <input ref="/data/inputs/contact/_id" appearance="db-object">
          <label>What is the patient's name?</label>
        </input>
        <group ref="/data/inputs/contact/parent">
          <label>NO_LABEL</label>
          <group ref="/data/inputs/contact/parent/parent">
            <label>NO_LABEL</label>
            <group ref="/data/inputs/contact/parent/parent/contact">
              <label>NO_LABEL</label>
            </group>
          </group>
        </group>
      </group>
    </group>
    <group appearance="field-list" ref="/data/respiratory_conditions_group">
      <label>Respiratory Conditions</label>
      <select1 ref="/data/respiratory_conditions_group/elderly_coughing">
        <label>Does the patient have a cough?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_conditions_group/cough_duration">
        <label>How long has the patient had this cough, in days?</label>
      </input>
      <select ref="/data/respiratory_conditions_group/qualify_cough">
        <label>What is the cough like?</label>
        <itemset nodeset="instance('qualify_cough')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select>
      <input ref="/data/respiratory_conditions_group/breathing_rate">
        <label>What is the patients breathing rate?</label>
        <hint>Determine with pulse oximeter if possible.</hint>
      </input>
      <input ref="/data/respiratory_conditions_group/oxygen_saturation">
        <label>What is the patients oxygen saturation</label>
      </input>
      <select1 ref="/data/respiratory_conditions_group/fever">
        <label>Does the patient have a fever?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_conditions_group/temperature">
        <label>What is the patients temperature?</label>
      </input>
      <input ref="/data/respiratory_conditions_group/fever_duration">
        <label>How long has the patient had this fever?</label>
        <hint>Unit is days</hint>
      </input>
      <select1 ref="/data/respiratory_conditions_group/wheezing">
        <label>Is the patient wheezing?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/respiratory_distress">
        <label>Does the patient exhibit respiratory distress?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/weight_loss">
        <label>Is the patient experiencing weight loss?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/night_sweats">
        <label>Is the patient experiencing night sweats?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/recurring_condition">
        <label>Are these symptoms recurring?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/tb_exposure">
        <label>Does the patient have friends or family with TB?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/jugular_venous_distention">
        <label>Does the patient have jugular venous distention?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/oedema_feet_ankles">
        <label>Does the patient have oedema of feet and ankles?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/respiratory_distress_after_exercise">
        <label>Does the patient have respiratory distress after exercise?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <select1 ref="/data/respiratory_conditions_group/tiredness">
        <label>Is the patient experiencing tiredness?</label>
        <itemset nodeset="instance('yes_no')/root/item">
          <value ref="name"/>
          <label ref="label"/>
        </itemset>
      </select1>
      <input ref="/data/respiratory_conditions_group/symptoms_duration_weeks">
        <label>How many weeks have the symptoms been ongoing?</label>
      </input>
    </group>
    <group appearance="field-list summary" ref="/data/results_group">
      <label>Results</label>
      <input ref="/data/results_group/res_tuberculosis" appearance="h1 red">
        <label>Tuberculosis</label>
      </input>
      <input ref="/data/results_group/res_tuberculosis_action">
        <label>The patient may have Tuberculosis.

Procedure:
- Refer for diagnosis and treatment
- Really motivate for referal (free treatment!)</label>
      </input>
      <input ref="/data/results_group/res_asthma" appearance="h1 yellow">
        <label>Asthma</label>
      </input>
      <input ref="/data/results_group/res_asthma_action">
        <label>The patient may have Asthma.

Procedure:
- Nebulizer for immediate treatment
- Dexamethasone IM 8 mg
- Send home with: Salbutamol tablet 4mg – 2 times day during one week
- If condition does not improve after two days, go to the hospital</label>
      </input>
      <input ref="/data/results_group/res_pneumonia" appearance="h1 yellow">
        <label>Pneumonia</label>
      </input>
      <input ref="/data/results_group/res_pneumonia_action">
        <label>The patient may have Pneumonia.

Procedure:
- Azythromycine tablets 500 mg – 1 co per day for 5 days
- Go to the hospital if no improvement after two days</label>
      </input>
      <input ref="/data/results_group/res_cardiac_decompensation_risk" appearance="h1 red">
        <label>Risk of cardiac decompensation</label>
      </input>
      <input ref="/data/results_group/res_cardiac_decompensation_risk_action">
        <label>The patient is at risk of cardiac decompensation.

Procedure:
- Refer</label>
      </input>
      <input ref="/data/results_group/res_cardiac_decompensation" appearance="h1 red">
        <label>Decompensation cardiaque</label>
      </input>
      <input ref="/data/results_group/res_cardiac_decompensation_action">
        <label>The patient may have decompensation cardiaque.

Procedure:
- Refer to hospital</label>
      </input>
    </group>
    <group ref="/data/null_results_group">
      <label>No Conditions Met</label>
      <input ref="/data/null_results_group/null_results_note" appearance="h1 green">
        <label>No conditions were met and the patient does not require additional treatment, submit the form.</label>
      </input>
    </group>
  </h:body>
</h:html>